Перем Ожидаем;

Процедура Инициализация(КонтекстADD) Экспорт
    Ожидаем = КонтекстADD.Плагин("УтвержденияBDD");
КонецПроцедуры

Процедура ЗаполнитьНаборТестов(НаборТестов, КонтекстADD) Экспорт
    НаборТестов.НачатьГруппу("Проверка запуска");
    НаборТестов.Добавить("ТестВерсииРасширения",
    	НаборТестов.ПараметрыТеста("ВспомогательныеИнструменты", "1.0.0.35"));
КонецПроцедуры

Процедура ТестВерсииРасширения(ИмяРасширения, ОжидаемаяВерсия) Экспорт

    ФактическаяВерсия = ПолучитьВерсиюРасширения(ИмяРасширения);
    Ожидаем.Что(ФактическаяВерсия, "Версия расширения отличается")
        .Равно(ОжидаемаяВерсия);

КонецПроцедуры

Функция ПолучитьВерсиюРасширения(ИмяРасширения)

    Отбор = Новый Структура("Имя", ИмяРасширения);
    НайденныеРасширения = РасширенияКонфигурации.Получить(Отбор);

    Если НайденныеРасширения.Количество() <> 1 Тогда
        ВызватьИсключение "Не найдено расширение: " + ИмяРасширения;
    КонецЕсли;

    Возврат НайденныеРасширения[0].Версия;

КонецФункции