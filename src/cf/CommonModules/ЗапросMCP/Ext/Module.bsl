Функция Запрос(Текст) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	ОтветТекст = "";
	ЗапросСтруктура = Всп_JSON.ЧтениеИзСтрокиJSON(Текст);
	ИдентификаторЗапроса = ЗапросСтруктура.id;
	
	Если Найти(Текст, "tools/list") Тогда
		ОтветТекст = ЗапросСписки(ИдентификаторЗапроса);
	ИначеЕсли Найти(Текст, "tools/call")
		И Найти(Текст, "get_time") Тогда
		ОтветТекст = ПростойОтвет(ИдентификаторЗапроса);
	Иначе
	КонецЕсли;
	
	Ответ.УстановитьТелоИзСтроки(ОтветТекст);
	
	Возврат Ответ;
КонецФункции

Функция ЗапросСписки(ИдентификаторЗапроса) Экспорт
	ОтветТекст = СтрШаблон(
		"{ 
		|  ""jsonrpc"": ""2.0"",
		|  ""id"": %1,
		|  ""result"": {
		|    ""tools"": [
		|      {
		|        ""name"": ""get_time"",
		|        ""description"": ""Возвращает текущее время из 1с"",
		|        ""inputSchema"": {
		|          ""type"": ""object"",
		|          ""properties"": {},
		|          ""additionalProperties"": false
		|        }
		|      }
		|    ]
		|  }
		|}", ИдентификаторЗапроса);
	
	Возврат ОтветТекст;
КонецФункции

Функция ПростойОтвет(ИдентификаторЗапроса) Экспорт
	Время = (ТекущаяДатаСеанса() - 600);
	ОтветТекст = СтрШаблон(
		"{
		|  ""jsonrpc"": ""2.0"",
		|  ""id"": %1,
		|  ""result"": {
		|    ""content"": [
		|      {
		|        ""type"": ""text"",
		|        ""text"": ""%2""
		|      }
		|    ],
		|    ""isError"": false
		|  }
		|}", ИдентификаторЗапроса, "Привет из 1с:" + Время);
	
	Возврат ОтветТекст;
КонецФункции