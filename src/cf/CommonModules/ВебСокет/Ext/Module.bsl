// Отправляет STOMP-команду CONNECT после установления WebSocket-соединения.

Процедура ОбработчикОткрытияСоединения(Соединение) Экспорт
    КоличествоСообщений = 10000;
	КлючСоединения = "rabbitmq-100k-websocket-1c";
	ИмяОчереди = "py_websocket_test_queue";
	Попытка
		// Передает RabbitMQ учетные данные и имя виртуального хоста.
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("accept-version", "1.2");
		Заголовки.Вставить("host", "/");
		Заголовки.Вставить("login", "rabbitmq");
		Заголовки.Вставить("passcode", "Pass1242!2%");
		Заголовки.Вставить("heart-beat", "0,0");

		Соединение.ОтправитьСообщение(СформироватьSTOMPКадр("CONNECT", Заголовки, ""));
		Сообщить("WebSocket открыт, команда CONNECT отправлена.");
	Исключение
		ИдетОтправка = Ложь;
		Сообщить("Ошибка отправки CONNECT: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Обрабатывает ответы RabbitMQ: CONNECTED, RECEIPT и ERROR.

Процедура ОбработчикПолученияСообщения(Соединение, Сообщение) Экспорт
    КоличествоСообщений = 10000;
	КлючСоединения = "rabbitmq-100k-websocket-1c";
	ИмяОчереди = "py_w	ebsocket_test_queue";
	Попытка
		КомандаSTOMP = СтрПолучитьСтроку(Сообщение, 1);

		Если КомандаSTOMP = "CONNECTED" Тогда
			Сообщить("RabbitMQ подтвердил STOMP-подключение. Начинается отправка 100 000 сообщений.");
			ОтправитьВсеСообщения(Соединение);
			Возврат;
		КонецЕсли;

		Если КомандаSTOMP = "RECEIPT" Тогда
			ИдентификаторПодтверждения = ПолучитьЗаголовокSTOMP(Сообщение, "receipt-id");
			Если ИдентификаторПодтверждения = "send-100000" Тогда
				ИдетОтправка = Ложь;
				Сообщить("RabbitMQ подтвердил последнюю команду SEND. Все 100 000 сообщений переданы.");
				Соединение.Закрыть();
			КонецЕсли;
			Возврат;
		КонецЕсли;

		Если КомандаSTOMP = "ERROR" Тогда
			ИдетОтправка = Ложь;
			Сообщить("RabbitMQ вернул STOMP-ошибку: " + Сообщение);
			Соединение.Закрыть();
		КонецЕсли;
	Исключение
		ИдетОтправка = Ложь;
		Сообщить("Ошибка обработки ответа RabbitMQ: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Отправляет 100 000 сообщений подряд без ожидания подтверждения каждого сообщения.

Процедура ОтправитьВсеСообщения(Соединение)
	КоличествоСообщений = 100000;
	КлючСоединения = "rabbitmq-100k-websocket-1c";
	ИмяОчереди = "py_websocket_test_queue";
	Тест = 1;
	Кадр = "";
	
	Заголовки = Новый Соответствие;
		Заголовки.Вставить("destination", "/queue/" + ИмяОчереди);
		Заголовки.Вставить("durable", "true");
		Заголовки.Вставить("auto-delete", "false");
		Заголовки.Вставить("x-queue-type", "classic");
		Заголовки.Вставить("content-type", "application/json");
		Заголовки.Вставить("persistent", "true");
		
	ЗаголовкиТекст = "SEND" + Символ(10);

	Для Каждого Заголовок1 Из Заголовки Цикл
		ЗаголовкиТекст = ЗаголовкиТекст + Заголовок1.Ключ + ":" + Заголовок1.Значение + Символ(10);
	КонецЦикла;

	 ЗаголовкиТекстПромежуток = ЗаголовкиТекст + Символ(10);
	 
	 ЗаголовкиТекстКонец = ЗаголовкиТекст + "receipt" + ":" + "send-100000" + Символ(10) + Символ(10);
	 
	ЗаголовкиТекст = ЗаголовкиТекстПромежуток;
	Данные = Новый Структура("sequence, source", "%1", "1c-websocket-test");
	ТелоСообщения = Всп_JSON.ЗаписьВСтроку(Данные);
	Замер =   Всп_ЗамерВремени.Старт();
	
	
	Для НомерСообщенияЧисло = 1 По КоличествоСообщений Цикл
		Данные.sequence = НомерСообщенияЧисло;
		ТелоСообщения = Всп_JSON.ЗаписьВСтроку(Данные);

		// Запрашивает одно подтверждение только после последнего сообщения.
		Если НомерСообщенияЧисло = КоличествоСообщений Тогда
			ЗаголовкиТекст = ЗаголовкиТекстКонец;
		КонецЕсли;

		//Если Не Соединение.ПолучитьСостояние() = СостояниеWebSocketСоединения.Открыто Тогда
		//	Сообщить("!!!!");
		//КонецЕсли;
	Кадр = ЗаголовкиТекст + ТелоСообщения + Символ(0);
		//Кадр = СтрШаблон("%1%2%3", ЗаголовкиТекст, ТелоСообщения, Символ(0));
		Соединение.ОтправитьСообщение(Кадр);
	КонецЦикла;

	Результат =   Всп_ЗамерВремени.Финиш(ЗАмер);
	Сообщить(Результат.Представление);
	Сообщить("Все сообщения отправлены в WebSocket. Ожидается RECEIPT от RabbitMQ...");

КонецПроцедуры

// Формирует STOMP-кадр из команды, заголовков и тела сообщения.

Функция СформироватьSTOMPКадр(КомандаSTOMP, Заголовки2, ТелоСообщения)

	Кадр = КомандаSTOMP + Символ(10);

	Для Каждого Заголовок1 Из Заголовки2 Цикл
		Кадр = Кадр + Заголовок1.Ключ + ":" + Заголовок1.Значение + Символ(10);
	КонецЦикла;

	//Если НЕ ПустаяСтрока(ТелоСообщения) Тогда
	//	
	//	Кадр = Кадр + "content-length:" + ЧислоВТекст(СтрДлина(ТелоСообщения) * 2) + Символ(10);
	//КонецЕсли;

	// Пустая строка отделяет заголовки от тела, нулевой символ завершает STOMP-кадр.
	Возврат Кадр + Символ(10) + ТелоСообщения + Символ(0);

КонецФункции


Функция ЧислоВТекст(Число) 
	Возврат Формат(Число, "ЧГ=");
КонецФункции

// Находит значение указанного заголовка в полученном STOMP-кадре.

Функция ПолучитьЗаголовокSTOMP(Кадр, ИмяЗаголовка)

	Для НомерСтроки = 2 По СтрЧислоСтрок(Кадр) Цикл
		СтрокаЗаголовка = СтрПолучитьСтроку(Кадр, НомерСтроки);
		Если ПустаяСтрока(СтрокаЗаголовка) Тогда
			Прервать;
		КонецЕсли;

		ПозицияРазделителя = СтрНайти(СтрокаЗаголовка, ":");
		Если ПозицияРазделителя > 0 Тогда
			Имя = Лев(СтрокаЗаголовка, ПозицияРазделителя - 1);
			Если Имя = ИмяЗаголовка Тогда
				Возврат Сред(СтрокаЗаголовка, ПозицияРазделителя + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Показывает ошибку WebSocket, если соединение завершилось аварийно.

Процедура ОбработчикОшибки(Соединение, КодОшибки, Описание) Экспорт

	ИдетОтправка = Ложь;
	Сообщить("Ошибка WebSocket " + Строка(КодОшибки) + ": " + Описание);

КонецПроцедуры

// Показывает результат закрытия соединения и сбрасывает состояние теста.

Процедура ОбработчикЗакрытияСоединения(Соединение, КодЗакрытия) Экспорт

	ИдетОтправка = Ложь;
	Сообщить("WebSocket-соединение закрыто. Код: " + Строка(КодЗакрытия));

КонецПроцедуры

