Функция СообщениеПоШаблону(СообщениеВид, 
		Параметр1 = Неопределено, Параметр2 = Неопределено, Параметр3 = Неопределено,
		Параметр4 = Неопределено, Параметр5 = Неопределено, Параметр6 = Неопределено,
		Параметр7 = Неопределено, Параметр8 = Неопределено, Параметр9 = Неопределено) Экспорт
		
	ТекущийЛог = Всп_ЛогСлужебный.ТекущийЛог(Контекст);
	
	
	Возврат Всп_Лог.СообщениеПоШаблону(ТекущийЛог.ШаблонСообщений, СообщениеВид, 
		Параметр1, Параметр2, Параметр3,
		Параметр4, Параметр5, Параметр6,
		Параметр7, Параметр8, Параметр9);
КонецФункции
	

#КонецОбласти

#Область ИнициализацияИНастройки

Функция НовыйЛог(ИмяЛога = "", Объект = Неопределено, Метаданные = Неопределено, Уровень = "") Экспорт
	Всп_ЛогСлужебный.НовыйЛог(Контекст, ИмяЛога, Уровень, Метаданные, Объект);
	
	Возврат Контекст;
КонецФункции

