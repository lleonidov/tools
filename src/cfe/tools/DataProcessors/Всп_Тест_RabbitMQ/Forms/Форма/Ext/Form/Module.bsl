Процедура Отправить10НаСервере()
	// Создаём подключение к Брокеру.
	// Параметры подключения получаем из точки контекста "ТестRABBITMQ".
	Брокер = Всп_Брокер.Подключиться("ТестRABBITMQ");

	Если Не Брокер.Используется Тогда
		// Ошибка отправки всегда является технической:
		Сообщить("Не удалось подключиться к брокеру ""ТестRABBITMQ"".");
		
		Возврат;
	КонецЕсли;
	
	Для НомерСообщения = 1 По 100000 Цикл
		СообщениеБрокеру = СтрШаблон("Тестовое %1 от %2", НомерСообщения, ТекущаяДатаСеанса());
		
		// Отправляем сообщение.
		// Параметры очереди получаем из контекста "ТестоваяОчередь".
		Если Не Всп_Брокер.ОтправитьСообщение(СообщениеБрокеру, "ТестоваяОчередь", Брокер) Тогда
			// Ошибка отправки всегда является технической:
			Сообщить("Не удалось отправить сообщение в очередь ""ТестоваяОчередь"".");
			Сообщить(Брокер.ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	
	// Обязательно освобождаем подключение и объект внешней компоненты.
	// Для PinkRabbit это необходимо, чтобы не оставлять занятую память.
	// Брокер = неопределено
	
	Всп_Брокер.Отключиться(Брокер);
КонецПроцедуры

