&НаСервере
Процедура Прочитать10НаСервере()
	
	// Создаём подключение к брокеру.
	// Параметры подключения получаем из точки контекста "ТестRABBITMQ".
	Брокер = Всп_Брокер.Подключиться("ТестRABBITMQ");
	
	Если Не Брокер.Используется Тогда
		// Ошибка подключения всегда является технической.
		Сообщить("Не удалось подключиться к брокеру ""ТестRABBITMQ"".");
		
		Возврат;
	КонецЕсли;
	
	// Получаем до 10 сообщений или все оставшиеся сообщения, если очередь опустеет раньше.
	Если Всп_Брокер.ПолучитьСообщенияПачкой("ТестоваяОчередь", Брокер) Тогда
		// Обрабатываем полученную пачку и запоминаем тег последнего обработанного сообщения.
		ПоследнийТегСообщения = Обработать10Сообщений(Брокер.СообщенияПачка);
		// Подтверждаем все захваченные сообщения до указанного тега включительно.
		Всп_Брокер.ПодтвердитьВсеЗахваченныеСообщения(ПоследнийТегСообщения, Брокер);
	Иначе
		Сообщить("Нет сообщений");
	КонецЕсли;
	
	// Обязательно отключаемся и освобождаем объект внешней компоненты, чтобы не допустить утечки памяти.
	Всп_Брокер.Отключиться(Брокер);
	
КонецПроцедуры

&НаСервере
Функция Обработать10Сообщений(Сообщения)
	
	ПоследнийТегСообщения = Неопределено;
	
	// Каждый элемент массива содержит текст сообщения и его тег RabbitMQ.
	Для Каждого Сообщение Из Сообщения Цикл
		Сообщить(Сообщение.Сообщение);
		ПоследнийТегСообщения = Сообщение.СообщениеНомер;
	КонецЦикла;
	
	Возврат ПоследнийТегСообщения;
	
КонецФункции

