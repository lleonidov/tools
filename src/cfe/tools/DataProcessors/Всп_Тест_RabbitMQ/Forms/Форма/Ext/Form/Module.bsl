&НаСервере
Функция СообщениеБрокеру(ШаблонСообщения, НомерСообщения, ВставитьДата = Истина)
	
	Если ВставитьДата Тогда
		Возврат СтрШаблон(ШаблонСообщения, НомерСообщения, ТекущаяДатаСеанса());
	Иначе	
		Возврат СтрШаблон(ШаблонСообщения, НомерСообщения);
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ИнициализацияКонтекстаОбменаСКроликом()
	СтруктураПодключения = НастройкиТестовогоРэббита();
	СтруктураОчереди = СтруктураТестовойОчереди();
	
	КэшСсылок = Всп_Контекст.ОбновитьКонтекст(СтруктураПодключения);
	Всп_Контекст.ОбновитьКонтекст(СтруктураОчереди, КэшСсылок);
	
КонецПроцедуры

&НаСервере
Функция СтруктураТестовойОчереди() Экспорт
	
	Переменные = Новый Массив;
	
	// Для системы «Август» важен префикс базы: по нему могут происходить доп обработки на самом rabbit MQ
	// Полное имя очереди: "{ПрефиксСистемы}.{ИдКлиента}.{ИмяОчереди}".
	//
	// Пример: "edo.test.queue"
	// - edo — префикс системы, которая отправляет или получает сообщения;
	// - test — контур базы: master, test, test2 и т. д. В настройках хранится как ИдКлиента и подставляется на уровне выше;
	// - queue — основное имя очереди.
	
	
	Переменные.Добавить(Новый Структура("Ключ, Значение, Тип", "Очередь", "edo.{ИдКлиента}.queue", "Строка"));
	
	ТочкаИнтеграции = Новый Структура("Ключ, Представление", "ТестRABBITMQ", "Тестовый сервер RabbitMQ");
	
	Возврат Новый Структура(
		"Ключ, Представление, Переменные, ТочкаИнтеграции",
		"ТестоваяОчередь",
		"Тестовая очередь",
		Переменные,
		ТочкаИнтеграции);
КонецФункции

&НаСервере
Функция НастройкиТестовогоРэббита() Экспорт
	Переменные = Новый Массив;
	
	Переменные.Добавить(Новый Структура("Ключ, Значение, Тип", "Логин", "rabbitmq", "Строка"));
	Переменные.Добавить(Новый Структура("Ключ, Значение, Тип, Секрет", "Пароль", "Pass1242!2%", "Строка", Истина));
	Переменные.Добавить(Новый Структура("Ключ, Значение, Тип", "АдресСервера", "127.0.0.1", "Строка"));
	Переменные.Добавить(Новый Структура("Ключ, Значение, Тип", "Порт", 5672, "Число"));
	Переменные.Добавить(Новый Структура("Ключ, Значение, Тип", "ИдКлиента", "test", "Строка"));
	Переменные.Добавить(Новый Структура("Ключ, Значение, Тип", "ВиртуальныйХост", "/", "Строка"));
	Переменные.Добавить(Новый Структура("Ключ, Значение, Тип", "СообщенияЗаРаз", 100, "Число"));
	Переменные.Добавить(Новый Структура("Ключ, Значение, Тип", "Таймаут", 600, "Число"));
	
	Возврат Новый Структура(
		"Ключ, Представление, Переменные",
		"ТестRABBITMQ",
		"Тестовый сервер RabbitMQ",
		Переменные);
	
КонецФункции
