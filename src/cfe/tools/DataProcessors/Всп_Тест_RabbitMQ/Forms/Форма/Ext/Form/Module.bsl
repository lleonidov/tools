Процедура Прочитать1ИВернутьНаСервере()
	
	// Создаём подключение к брокеру.
	// Параметры подключения получаем из точки контекста "ТестRABBITMQ".
	Брокер = Всп_Брокер.Подключиться("ТестRABBITMQ");
	
	Если Не Брокер.Используется Тогда
		// Ошибка подключения всегда является технической.
		Сообщить("Не удалось подключиться к брокеру ""ТестRABBITMQ"".");
		
		Возврат;
	КонецЕсли;
	
	// Получаем одно сообщение из очереди, параметры которой берём из контекста "ТестоваяОчередь".
	Если Всп_Брокер.ПолучитьСообщение("ТестоваяОчередь", Брокер) Тогда
		Сообщить(Брокер.Сообщение);
		
		// Отказываемся от сообщения и возвращаем его в очередь без потери.
		Всп_Брокер.ОтказОтСообщения(Брокер, Брокер.СообщениеНомер);
	Иначе
		Сообщить("Нет сообщений");
	КонецЕсли;
	
	// Обязательно отключаемся и освобождаем объект внешней компоненты, чтобы не допустить утечки памяти.
	Всп_Брокер.Отключиться(Брокер);
	
