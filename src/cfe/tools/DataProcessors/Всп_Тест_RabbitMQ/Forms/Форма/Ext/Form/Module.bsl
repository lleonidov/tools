

&НаСервере
Процедура УпрощенныйОтправитьНаСервере()
	// Создаём подключение к брокеру.
	// Параметры подключения получаем из точки контекста "ТестRABBITMQ".
	Брокер = Всп_Брокер.Подключиться("ТестRABBITMQ");

	// Отправляем сообщение.
	// Параметры очереди получаем из контекста "ТестоваяОчередь".
	Всп_Брокер.ОтправитьСообщение("Привет мир", "ТестоваяОчередь", Брокер);

	// Обязательно отключаемся и освобождаем объект внешней компоненты, чтобы не допустить утечки памяти.
	Всп_Брокер.Отключиться(Брокер);

КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСервере()
	// Создаём подключение к Брокеру.
	// Параметры подключения получаем из точки контекста "ТестRABBITMQ".
	Брокер = Всп_Брокер.Подключиться("ТестRABBITMQ", Ложь);
	
	Если Не Брокер.Используется Тогда
		// Ошибка подключения всегда является технической:
		Сообщить("Не удалось подключиться к брокеру ""ТестRABBITMQ"".");
		
		Возврат;
	КонецЕсли;
	
	СообщениеБрокеру = СтрШаблон("Тестовое 1 от %1", ТекущаяДатаСеанса());
	
	// Отправляем сообщение.
	// Параметры очереди получаем из контекста "ТестоваяОчередь".
	Если Не Всп_Брокер.ОтправитьСообщение(СообщениеБрокеру, "ТестоваяОчередь", Брокер) Тогда
		// Ошибка отправки всегда является технической:
		Сообщить("Не удалось отправить сообщение в очередь ""ТестоваяОчередь"".");
		Сообщить(Брокер.ТекстОшибки);
	КонецЕсли;
	
	// Обязательно освобождаем подключение и объект внешней компоненты.
	// Для PinkRabbit это необходимо, чтобы не оставлять занятую память.
	// Брокер = неопределено
	Всп_Брокер.Отключиться(Брокер);
	
КонецПроцедуры

&НаСервере
Процедура Прочитать1НаСервере()
	// Создаём подключение к брокеру.
	// Параметры подключения получаем из точки контекста "ТестRABBITMQ".
	Брокер = Всп_Брокер.Подключиться("ТестRABBITMQ");
	
	Если Не Брокер.Используется Тогда
		// Ошибка подключения всегда является технической:
		Сообщить("Не удалось подключиться к брокеру ""ТестRABBITMQ"".");
		
		Возврат;
	КонецЕсли;
	
	// Получаем одно сообщение из очереди, параметры которой берём из контекста "ТестоваяОчередь".
	Если Всп_Брокер.ПолучитьСообщение("ТестоваяОчередь", Брокер) Тогда
		Сообщить(Брокер.Сообщение);
		// Подтверждает последнее сообщение
		Всп_Брокер.ПодтвердитьСообщение(Брокер);
	Иначе
		Сообщить("Нет сообщений");
	КонецЕсли;
		
	Всп_Брокер.Отключиться(Брокер);
КонецПроцедуры

