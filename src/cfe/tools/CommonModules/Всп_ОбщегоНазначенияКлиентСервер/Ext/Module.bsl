//функция выполняет приведение строки к числу
// Параметры:
//  ЧислоСтрокой           - Строка - Строка приводимая к числу
//  ВозвращатьНеопределено - Булево - Если Истина и строка содержит некорректное значение, то возвращать Неопределено
//
// Возвращаемое значение:
//  Число
//
Функция ПривестиСтрокуКЧислу(ЧислоСтрокой, ВозвращатьНеопределено = Ложь) Экспорт
	
	ОписаниеТипаЧисла = Новый ОписаниеТипов("Число");
	ЗначениеЧисла = ОписаниеТипаЧисла.ПривестиЗначение(ЧислоСтрокой);
	
	Если ВозвращатьНеопределено И (ЗначениеЧисла = 0) Тогда
		
		Стр = Строка(ЧислоСтрокой);
		Если Стр = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Стр = СтрЗаменить(СокрЛП(Стр), "0", "");
		Если (Стр <> "") И (Стр <> ".") И (Стр <> ",") Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеЧисла;	
	
КонецФункции

Функция РазбитьМассив(Массив, ИсходныйМассив, ТекущийИндексМассива, ЭлементовЗаРаз) Экспорт
	Массив = Новый Массив;
	
	Если ИсходныйМассив.Количество() < ТекущийИндексМассива Или ИсходныйМассив.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = ТекущийИндексМассива По Мин(ИсходныйМассив.Количество() - 1, ТекущийИндексМассива + ЭлементовЗаРаз) Цикл
		Массив.Добавить(ИсходныйМассив[Индекс]);
	КонецЦикла;
	
	ТекущийИндексМассива = Индекс + 1;
	
	Возврат Истина;
КонецФункции

// Выводит сообщение пользователю с привязкой к полю (если передано).
//
// Параметры:
//  ТекстСообщения - Строка - Текст для вывода.
//  Поле           - Строка - Имя реквизита на форме (например "Объект.Номенклатура").
//
Процедура СообщитьПользователю(Знач ТекстСообщения, Знач Поле = "") Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	
	Если ЗначениеЗаполнено(Поле) Тогда
		Сообщение.Поле = Поле;
	КонецЕсли;
	
	Сообщение.Сообщить();
	
КонецПроцедуры

// Оборачивает переданное значение в массив, если оно им не является.
// Если на вход уже передан массив, возвращает его без изменений.
// 
// Параметры:
//  Значение - Произвольный, Массив Из Произвольный - Любое значение, которое необходимо привести к массиву, 
//                                                    или уже существующий массив.
// 
// Возвращаемое значение:
//  Массив Из Произвольный - Массив, содержащий переданное значение, либо сам исходный массив.
Функция ПривестиКМассиву(Значение) Экспорт
	
	Если Не ТипЗнч(Значение) = Тип("Массив") Тогда
		Массив = Новый Массив;	
		Массив.Добавить(Значение);
		
		Возврат Массив; 
	КонецЕсли;
	
	Возврат Значение;
КонецФункции

// Формирует и возвращает массив из переданных значений, отбрасывая пустые (со значением Null).
// Удобна для быстрой компоновки массива «на лету» из заданного набора элементов.
// 
// Параметры:
//  Параметр1 - Произвольный - Первое значение для добавления в массив.
//  Параметр2 - Произвольный - Второе значение для добавления в массив.
//  Параметр3 - Произвольный - Третье значение для добавления в массив.
//  Параметр4 - Произвольный - Четвертое значение для добавления в массив.
//  Параметр5 - Произвольный - Пятое значение для добавления в массив.
//  Параметр6 - Произвольный - Шестое значение для добавления в массив.
//  Параметр7 - Произвольный - Седьмое значение для добавления в массив.
// 
// Возвращаемое значение:
//  Массив из Произвольный - Содержит все переданные в функцию параметры, за исключением тех, 
//           которые не были указаны (имеют значение по умолчанию Null).
//
//@skip-check method-too-many-params
Функция ДобавитьПараметры(Параметр1 = Null, Параметр2 = Null, Параметр3 = Null, 
			Параметр4 = Null, Параметр5 = Null, Параметр6 = Null, Параметр7 = Null) Экспорт
	Параметры = Новый Массив;
	
	Если Не Параметр1 = Null Тогда
		Параметры.Добавить(Параметр1);
	КонецЕсли;
	
	Если Не Параметр2 = Null Тогда
		Параметры.Добавить(Параметр2);
	КонецЕсли;
	
	Если Не Параметр3 = Null Тогда
		Параметры.Добавить(Параметр3);
	КонецЕсли;
	
	Если Не Параметр4 = Null Тогда
		Параметры.Добавить(Параметр4);
	КонецЕсли;
	
	Если Не Параметр5 = Null Тогда
		Параметры.Добавить(Параметр5);
	КонецЕсли;
	
	Если Не Параметр6 = Null Тогда
		Параметры.Добавить(Параметр6);
	КонецЕсли;
	
	Если Не Параметр7 = Null Тогда
		Параметры.Добавить(Параметр7);
	КонецЕсли;
	
	Возврат Параметры;
КонецФункции

Процедура ОбъединитьСтруктуры(Структура1, Структура2) Экспорт
	Если Структура2 = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент ИЗ Структура2 Цикл
		Структура1.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура ИзменитьИдентификатор(Идентификатор, Наименование) Экспорт
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	ВерхнийРегистрСледующаяБуква = Ложь;
	
	Для Ном = 1 По СтрДлина(Наименование) Цикл
		текБуква = Сред(Наименование, Ном, 1);
		
		Если текБуква = " " Тогда
			ВерхнийРегистрСледующаяБуква = Истина;
			Продолжить;
		КонецЕсли;	
		
		Если ВерхнийРегистрСледующаяБуква Тогда
			ВерхнийРегистрСледующаяБуква = Ложь;
			текБуква = ВРег(текБуква);
		КонецЕсли;
		
		Идентификатор = Идентификатор + текБуква;
	КонецЦикла;
	
КонецПроцедуры

// Переходит к элементу сложной коллекции по переданному строковому пути.
// Поддерживает обращение по индексу, получение последнего элемента ("[Последняя]") 
// или размера коллекции ("[Размер]").
//
// Параметры:
//  ПутьДоРеквизитов - Строка - Строковый путь до искомого реквизита.
//                              Пример: "[0].Поле.ЕщеОдно".
//  Данные           - Произвольный - Коллекция, в которой выполняется поиск по пути.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - Значение элемента по указанному пути. Возвращает Неопределено 
//                               при выходе за границы массива. Может вернуть Число ("[Размер]").
Функция ПерейтиКЭлементу(Знач ПутьДоРеквизитов, Данные) Экспорт
	ПутьДоРеквизитов = СтрЗаменить(ПутьДоРеквизитов, "[", ".[");
	ПутьДоРеквизитов = СтрЗаменить(ПутьДоРеквизитов, "]", "].");
	ПутьДоРеквизитов = ?(Лев(ПутьДоРеквизитов, 1) = ".", Сред(ПутьДоРеквизитов, 2), ПутьДоРеквизитов); 
	ПутьДоРеквизитов = ?(Прав(ПутьДоРеквизитов, 1) = ".", Сред(ПутьДоРеквизитов, 1, СтрДлина(ПутьДоРеквизитов) - 1), ПутьДоРеквизитов); 
	
	Элементы = СтрРазделить(ПутьДоРеквизитов, ".");
	ТекущаяПозиция = Данные;
	
	Для Каждого текЭлемент Из Элементы Цикл
		Если Лев(текЭлемент, 1) = "[" Тогда
			Индекс 	   = Сред(текЭлемент, 2, СтрДлина(текЭлемент) - 2);
			
			РазмерМассива = ТекущаяПозиция.Количество();
			
			Если Индекс = "Последняя" Тогда
				Индекс = РазмерМассива - 1;
			ИначеЕсли Индекс = "Размер" Тогда
				Возврат РазмерМассива;
			Иначе
				Индекс = Число(Индекс);
			КонецЕсли;
			
			Если Индекс < 0 Или Индекс >= РазмерМассива Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			ТекущаяПозиция = ТекущаяПозиция[Индекс];
		ИначеЕсли ТипЗнч(ТекущаяПозиция) = Тип("Соответствие") Тогда
			ТекущаяПозиция  = ТекущаяПозиция[текЭлемент];
		Иначе
			ТекущаяПозиция.Свойство(текЭлемент, ТекущаяПозиция);
		КонецЕсли;
		
		Если ТекущаяПозиция = Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекущаяПозиция;
КонецФункции

Функция ЧислоИз16В10(Строка16) Экспорт
	Возврат ЧислоИзШестнадцатеричнойСтроки("0x" + 	Строка16);
КонецФункции

// Переводит десятичное целое число в шестнадцатеричную (HEX) строку.
// 
// Параметры:
//  Число - Число - Десятичное целое число, которое необходимо перевести.
//  КЭШ   - Соответствие Из КлючИЗначение - Кэш для быстрого получения символа:
//          * Ключ     - Число  - число от 0 до 15;
//          * Значение - Строка - знак в шестнадцатеричной системе.
// 
// Возвращаемое значение:
//  Строка - Строковое представление переданного числа в шестнадцатеричном формате.
Функция  ЧислоВHex(Знач Число, КЭШ = Неопределено) Экспорт
	Код = "";
	
	Если КЭШ = Неопределено Тогда
		КЭШ = ПолучитьКЭШ16();
	КонецЕсли;
	
	// Классический математический алгоритм перевода систем счисления
	Пока Число > 0 Цикл
		Остаток = Число % 16;
		Код = КЭШ[Остаток] + Код;
		
		Число = Цел(Число / 16);
	КонецЦикла;
	
	Возврат Код;
КонецФункции

Функция ПолучитьСтрокуУИД(ИсходнаяСтрока) Экспорт
	
	ИсходнаяСтрока = Прав("00000000000000000000000000000000" + ИсходнаяСтрока, 32);
	
	Возврат Новый УникальныйИдентификатор(Лев(ИсходнаяСтрока, 8) + "-"
	 + Сред(ИсходнаяСтрока, 9, 4) + "-"
	 + Сред(ИсходнаяСтрока, 13, 4) + "-"
	 + Сред(ИсходнаяСтрока, 17, 4) + "-"
	 + Прав(ИсходнаяСтрока, 12));
 КонецФункции
 
Функция ПолучитьЧислоИзСтроки(Знач ИсходнаяСтрока) Экспорт
    
    Если ПустаяСтрока(ИсходнаяСтрока) Тогда
        Возврат 0;
    КонецЕсли;
    
    // Проверяем по кодам символов: цифры от '0' (код 48) до '9' (код 57)
    Для Индекс = 1 По СтрДлина(ИсходнаяСтрока) Цикл
        Код = КодСимвола(ИсходнаяСтрока, Индекс);
		
		Если Код < 48 Или Код > 57 Тогда
            Возврат 0;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Число(ИсходнаяСтрока);
    
КонецФункции

Функция ДополнитьНулями32(ИсходнаяСтрока, Размер) Экспорт
	Возврат Прав("00000000000000000000000000000000" + ИсходнаяСтрока, Размер);
КонецФункции

Функция ПолучитьКЭШ16() Экспорт
	// Полный алфавит
	Алфавит = "0123456789ABCDEF";
	
	// Создаем массив нужного размера (от 0 до 16).
	Кэш = Новый Массив(16);
	
	// Раскладываем позиции 16 (от 0 до 81) по индексам, равным ASCII-коду символа
	Для Индекс = 0 По 15 Цикл
		Кэш[Индекс] = Сред(Алфавит, Индекс + 1, 1); 
	КонецЦикла;
	
	// Превращаем в ФиксированныйМассив. Он работает в памяти быстрее обычного 
	// и защищен от случайного изменения в других функциях.
	Возврат Новый ФиксированныйМассив(Кэш);
КонецФункции

// Функция осуществляет транслитерацию переданного текста.
// Все символы приводятся к верхнему регистру.
// Цифры и прочие символы остаются без изменений.
Функция Транслит(Знач Текст) Экспорт
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Текст = ВРег(Текст);
	Результат = "";
	
	// Матрица замен для букв от А до Я (32 символа)
	// Каждая позиция строго соответствует смещению кода символа от 1040.
	// Вы можете поменять буквы внутри строки под свой стандарт транслита,
	// главное Оригинал— сохранить общую длину ровно в 32 символа.
	МатрицаЗамен = "ABVGDEJZIYKLMNOPRSTUFHCQWX-+'_()";
	//   		   "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"
	
	ДлинаТекста = СтрДлина(Текст);
	
	Для Индекс = 1 По ДлинаТекста Цикл
		
		Код = КодСимвола(Текст, Индекс);
		
		Если Код >= 1040 И Код <= 1071 Тогда
			// Код 1040 (А) даст позицию 1, 1041 (Б) - 2 и так далее.
			Результат = Результат + Символ(КодСимвола(МатрицаЗамен, Код - 1039));
		ИначеЕсли Код = 1025 Тогда 
			// Буква Ё имеет отдельный код (1025), вне основного диапазона
			Результат = Результат + "E";
		Иначе
			// Все остальные символы (цифры, латиница, знаки) просто копируем
			Результат = Результат + Символ(Код);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Неопределено это не число
Функция ПолучитьКонтрольныйСимволЕАН13(Штрихкод) Экспорт
   	ОбщийВес = 0;
	
	Множитель = 3;
	
	Для Позиция = - СтрДлина(Штрихкод) По -1 Цикл
		КодСимвола = КодСимвола(Штрихкод, -Позиция);
		
		Если Не КодСимвола > 47 И КодСимвола < 58 Тогда
			Возврат "";
		КонецЕсли;
		
		ОбщийВес   = ОбщийВес + (КодСимвола - 48) * Множитель;
		Множитель  = ?(Множитель = 3, 1, 3);
	КонецЦикла;
	
	Остаток = ОбщийВес % 10;
	КонтрольнаяЦифра = ?(Остаток = 0, 0, 10 - Остаток);
	
	Возврат Строка(КонтрольнаяЦифра);
КонецФункции

// Создаёт пустой словарь для хранения значений по одному или нескольким ключам.
//
// Для всех записей словаря должно использоваться одинаковое количество ключей.
// Значение Неопределено нельзя использовать как ключ или сохраняемое значение.
//
// Возвращаемое значение:
//  Соответствие - пустой многоключевой словарь.
Функция СоздатьСловарь() Экспорт
	Словарь = Новый Соответствие;
	
	Возврат Словарь;
КонецФункции

// Добавляет новое значение в словарь или заменяет значение с тем же набором ключей.
//
// В рамках одного словаря количество ключей должно оставаться неизменным.
// Ключи передаются последовательно, без пропусков. Значение Неопределено в параметрах Ключ2-Ключ4
// означает отсутствие следующего ключа и не может использоваться как значение ключа.
// Неопределено также нельзя использовать как сохраняемое значение, поскольку оно означает,
// что искомое значение отсутствует.
//
// Параметры:
//  Словарь - Соответствие - словарь, в который добавляется значение.
//  Значение - Произвольный - сохраняемое значение, отличное от Неопределено.
//  Ключ1   - Произвольный - первый ключ.
//  Ключ2   - Произвольный - второй ключ или Неопределено, если словарь использует один ключ.
//  Ключ3   - Произвольный - третий ключ или Неопределено, если словарь использует не более двух ключей.
//  Ключ4   - Произвольный - четвертый ключ или Неопределено, если словарь использует не более трех ключей.
Процедура ДобавитьВСловарь(Словарь, Значение, Ключ1, Ключ2 = Неопределено, Ключ3 = Неопределено, Ключ4 = Неопределено) Экспорт
	
	Если Ключ2 = Неопределено Тогда
		Словарь.Вставить(Ключ1, Значение);// Вставка по времени быстрей чем поиск + вставка
		
		Возврат;
	КонецЕсли;
	
	Поиск2 = Словарь[Ключ1];
	
	Если Поиск2 = Неопределено Тогда
		Поиск2 = Новый Соответствие;
		Словарь.Вставить(Ключ1, Поиск2);
	КонецЕсли;
	
	
	Если Ключ3 = Неопределено Тогда
		Поиск2.Вставить(Ключ2, Значение);
		
		Возврат;
	КонецЕсли;
	
	Поиск3 = Поиск2[Ключ2];
	
	Если Поиск3 = Неопределено Тогда
		Поиск3 = Новый Соответствие;
		Поиск2.Вставить(Ключ2, Поиск3);
	КонецЕсли;
		
	Если Ключ4 = Неопределено Тогда
		Поиск3.Вставить(Ключ3, Значение);
		
		Возврат;
	КонецЕсли;
	
	Поиск4 = Поиск3[Ключ3];
		
	Если Поиск4 = Неопределено Тогда
		Поиск4 = Новый Соответствие;
		Поиск3.Вставить(Ключ3, Поиск4);
	КонецЕсли;
		
	Поиск4.Вставить(Ключ4, Значение);
	
КонецПроцедуры

// Возвращает значение словаря по заданному набору ключей.
//
// Количество ключей должно соответствовать количеству ключей, использованному при заполнении словаря.
// Ключи передаются последовательно, без пропусков. Значение Неопределено в параметрах Ключ2-Ключ4
// означает отсутствие следующего ключа и не может использоваться как значение ключа.
//
// Параметры:
//  Словарь - Соответствие - словарь, в котором выполняется поиск.
//  Ключ1   - Произвольный - первый ключ.
//  Ключ2   - Произвольный - второй ключ или Неопределено, если словарь использует один ключ.
//  Ключ3   - Произвольный - третий ключ или Неопределено, если словарь использует не более двух ключей.
//  Ключ4   - Произвольный - четвертый ключ или Неопределено, если словарь использует не более трех ключей.
//
// Возвращаемое значение:
//  Произвольный - найденное значение;
//  Неопределено - значение с указанным набором ключей отсутствует.
Функция НайтиВСловаре(Словарь, Ключ1, Ключ2 = Неопределено, Ключ3 = Неопределено, Ключ4 = Неопределено) Экспорт
	Поиск = Словарь[Ключ1];
	
	Если Поиск = Неопределено Или Ключ2 = Неопределено Тогда
		Возврат Поиск;
	КонецЕсли;
	
	Поиск = Поиск[Ключ2];
	
	Если Поиск = Неопределено Или Ключ3 = Неопределено Тогда
		Возврат Поиск;
	КонецЕсли;
	
	Поиск = Поиск[Ключ3];
	
	Если Поиск = Неопределено Или Ключ4 = Неопределено Тогда
		Возврат Поиск;
	КонецЕсли;
	
	Возврат Поиск[Ключ4];
КонецФункции

#КонецОбласти