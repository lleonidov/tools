#Область ПрограммныйИнтерфейс

Процедура НовыйЛог(Контекст = Неопределено, ИмяЛога = "", Уровень = "", Метаданные = Неопределено, Объект = Неопределено) Экспорт
	
	ИмяЛогаДляСоздания = ИмяЛога;
	
	Если Не ЗначениеЗаполнено(ИмяЛогаДляСоздания) Тогда
		ИмяЛогаДляСоздания = ИмяЛогаПоУмолчанию(Контекст);
	КонецЕсли;
	
	Если Контекст = Неопределено Тогда
		Контекст = НовыйПараметрыСеанса();
		Контекст.ТекущийЛог = ИмяЛогаДляСоздания;
	КонецЕсли;
	
	ПараметрыЛога = НовыйПустойЛог(ИмяЛогаДляСоздания);
	
	Если ЗначениеЗаполнено(Уровень) Тогда
		ПараметрыЛога.Уровень = УровниЛогирования()[Уровень];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Метаданные) Тогда
		ПараметрыЛога.Метаданные = Метаданные;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект) Тогда
		ПараметрыЛога.Объект = Объект;
	КонецЕсли;
	
	Контекст.Логи.Вставить(ИмяЛогаДляСоздания, ПараметрыЛога);
	
КонецПроцедуры

Процедура ДобавитьСпособЛогирования(Контекст, Способ, Параметры, ЛогИлиИмяЛога, Среда = "") Экспорт
	ТекущийЛог = ТекущийЛог(Контекст, ЛогИлиИмяЛога);
	
	Если ТекущийЛог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущийСпособЛогирования = ТекущийСпособЛогирования(Контекст, Способ);
	
	Если ТекущийСпособЛогирования = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущийСпособЛогирования.ЗапретДублейУЛога И ЕстьСпособЛогированияДляЛога(ТекущийЛог,
		ТекущийСпособЛогирования) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавляемыйСпособ = Новый Структура;
	ДобавляемыйСпособ.Вставить("Способ", ТекущийСпособЛогирования);
	ДобавляемыйСпособ.Вставить("Параметры", Параметры);
	
	КонтекстыЛогирования = КонтекстыЛогирования();
	
	Если Не ЗначениеЗаполнено(Среда) Тогда
		ДобавляемыйКонтекст = КонтекстыЛогирования.КлиентСервер;
	Иначе
		ДобавляемыйКонтекст = КонтекстыЛогирования[Среда];
	КонецЕсли;
	
	ДобавляемыйСпособ.Вставить("Среда", ДобавляемыйКонтекст);
	
	ТекущийЛог.Способы.Добавить(ДобавляемыйСпособ);	
	
	Контекст.Логи.Вставить(ТекущийЛог.Имя, ТекущийЛог);
	
КонецПроцедуры

Процедура ЗаписатьНовоеСообщениеВЛог(Контекст, Сообщение, УровеньЛогирования, ЛогИлиИмяЛога) Экспорт
	ТекущийЛог = ТекущийЛог(Контекст, ЛогИлиИмяЛога);
	
	Если ТекущийЛог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ВозможнаЗаписьЛога(ТекущийЛог, УровеньЛогирования) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСпособ ИЗ ТекущийЛог.Способы Цикл
		ЗаписатьЛогПоСпособу(Контекст, ТекущийЛог, ТекСпособ, УровеньЛогирования, Сообщение);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьЛогПоСпособу(Контекст, Лог, СпособЛогированияДляЛога, УровеньЛогирования, Сообщение) Экспорт
	
	Если Не КонтекстСпособаЛогированияАктуален(СпособЛогированияДляЛога.Среда) Тогда
		Возврат;
	КонецЕсли;
	
	Если СпособЛогированияДляЛога.Способ.ЗаписьНаСервере Тогда
		Всп_ЛогСлужебныйСервер.ВыполнитьЗаписьЛогаПоСпособу(Контекст, Лог, СпособЛогированияДляЛога, УровеньЛогирования, Сообщение);
	Иначе
		ВыполнитьЗаписьЛогаПоСпособу(Контекст, Лог, СпособЛогированияДляЛога, УровеньЛогирования, Сообщение);
	КонецЕсли;
	
КонецПроцедуры

Функция СпособыЛогирования(Контекст) Экспорт
	Способы = Новый Структура;
	Способы.Вставить("Консоль", НовыйСпособЛогирования("Консоль"));
	Способы.Вставить("ЖурналРегистрации", НовыйСпособЛогирования("ЖурналРегистрации",Истина));
	Способы.Вставить("Память", НовыйСпособЛогирования("Память"));
	Способы.Вставить("Файл", НовыйСпособЛогирования("Файл",,Ложь));
	Способы.Вставить("База", НовыйСпособЛогирования("База",Истина));
	Способы.Вставить("КаталогФайлов", НовыйСпособЛогирования("КаталогФайлов",,Ложь));
	
	ТекСпособыИзОбщегоМодуля = Контекст.СпособыЛогированияОбщиеМодули;
	
	Для Каждого КлючЗначение Из ТекСпособыИзОбщегоМодуля Цикл
		Способы.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Всп_ЛогПереопределяемый.ПриОпределенииСпособовЛогирования(Способы);
	
	Возврат Способы;
КонецФункции

Функция УровниЛогирования() Экспорт
	Уровни = Новый Структура;
	Уровни.Вставить("Нет", НовыйУровеньЛогирования("Нет", 999));
	Уровни.Вставить("Отладка", НовыйУровеньЛогирования("Отладка", 0));
	Уровни.Вставить("Информация", НовыйУровеньЛогирования("Информация", 1));
	Уровни.Вставить("Предупреждение", НовыйУровеньЛогирования("Предупреждение", 2));
	Уровни.Вставить("Ошибка", НовыйУровеньЛогирования("Ошибка", 3));
	Уровни.Вставить("КритическаяОшибка", НовыйУровеньЛогирования("КритическаяОшибка", 4));
	
	Возврат Уровни;
КонецФункции

Функция ПараметрыСпособаЛогирования(Контекст, СпособИлиИмяСпособа) Экспорт
	ТекущийСпособ = ТекущийСпособЛогирования(Контекст, СпособИлиИмяСпособа);
	Если ТекущийСпособ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СпособыЛогирования = СпособыЛогирования(Контекст);
	Если ТекущийСпособ.Имя = СпособыЛогирования.База.Имя Тогда
		Возврат Неопределено;
	ИначеЕсли ТекущийСпособ.Имя = СпособыЛогирования.Консоль.Имя Тогда 
		Возврат Неопределено;
	ИначеЕсли ТекущийСпособ.Имя = СпособыЛогирования.ЖурналРегистрации.Имя Тогда 
		Возврат Неопределено;
	ИначеЕсли ТекущийСпособ.Имя = СпособыЛогирования.Память.Имя Тогда 
		Возврат Неопределено;
	ИначеЕсли ТекущийСпособ.Имя = СпособыЛогирования.Файл.Имя Тогда 
		ПараметрыСпособа = Новый Структура;
		ПараметрыСпособа.Вставить("ИмяФайла", "");
		
		Возврат ПараметрыСпособа;
	ИначеЕсли ТекущийСпособ.Имя = СпособыЛогирования.КаталогФайлов.Имя Тогда 
		ПараметрыСпособа = Новый Структура;
		ПараметрыСпособа.Вставить("Каталог", "");
		ПараметрыСпособа.Вставить("ШаблонИмениФайла", "[ИМЯЛОГА].txt");
		
		Возврат ПараметрыСпособа;
	ИначеЕсли ЗначениеЗаполнено(ТекущийСпособ.ИмяОбщегоМодуля) Тогда 
		ОбщийМодуль = ОбщийМодульПоИмени(ТекущийСпособ.ИмяОбщегоМодуля);
		Попытка
			Возврат ОбщийМодуль.НовыйПараметрыСпособаЛогирования();
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	Иначе
		ПараметрыСпособа = Неопределено;
		Всп_ЛогПереопределяемый.ПриОпределенииПараметровСпособаЛогирования(ТекущийСпособ.Имя, ПараметрыСпособа);
		
		Возврат ПараметрыСпособа;
	КонецЕсли;
КонецФункции 

Процедура ОтключитьЛог(Контекст, ЛогИлиИмяЛога = Неопределено) Экспорт
	ТекущийЛог = ТекущийЛог(Контекст, ЛогИлиИмяЛога);
	Если ТекущийЛог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЛог.Использование = Ложь;
	
КонецПроцедуры

Процедура ВключитьЛог(Контекст, ЛогИлиИмяЛога = Неопределено) Экспорт
	ТекущийЛог = ТекущийЛог(Контекст, ЛогИлиИмяЛога);
	Если ТекущийЛог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЛог.Использование = Истина;
	
КонецПроцедуры

Процедура УстановитьУровеньЛогирования(Контекст, Уровень, ЛогИлиИмяЛога = Неопределено) Экспорт
	ТекущийЛог = ТекущийЛог(Контекст, ЛогИлиИмяЛога);
	Если ТекущийЛог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Уровень) = Тип("Строка") Тогда
		ТекущийЛог.Уровень = УровниЛогирования()[Уровень];
	Иначе
		ТекущийЛог.Уровень = Уровень;
	КонецЕсли;
		
КонецПроцедуры

Функция ДанныеЛога(Контекст, ЛогИлиИмяЛога = Неопределено) Экспорт
	ТекущийЛог = ТекущийЛог(Контекст, ЛогИлиИмяЛога);
	Если ТекущийЛог = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Возврат ТекущийЛог.ДанныеСессии;
КонецФункции

Процедура ОчиститьСписокЛогов(Контекст) Экспорт
	Контекст.Логи.Очистить();	
	
КонецПроцедуры

Функция АктивныеЛоги(Контекст) Экспорт
	Возврат Контекст.Логи;
КонецФункции

Процедура ЗавершитьЛогирование(Контекст, ЛогИлиИмяЛога = Неопределено) Экспорт
	ТекущийЛог = ТекущийЛог(Контекст, ЛогИлиИмяЛога);
	
	Если ТекущийЛог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УдалитьЛогИзХранилищаЛогов(Контекст.Логи, ТекущийЛог);
КонецПроцедуры

Процедура УстановитьШаблонСообщения(Контекст, Шаблон, ЛогИлиИмяЛога = Неопределено) Экспорт
	ТекущийЛог = ТекущийЛог(Контекст, ЛогИлиИмяЛога);
	Если ТекущийЛог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийЛог.Шаблон = Шаблон;
	
КонецПроцедуры

