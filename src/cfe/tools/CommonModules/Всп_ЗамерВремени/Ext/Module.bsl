// Начинает замер.
//
// Возвращаемое значение:
//  Число - момент начала замера в миллисекундах.
//
Функция Старт() Экспорт

	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах();

КонецФункции

// Завершает замер.
//
// Параметры:
//  Замер - Число - значение, полученное из СтартЗамера().
//
// Возвращаемое значение:
//  Структура:
//   * Миллисекунды - Число - общая длительность замера в миллисекундах.
//   * Представление - Строка - длительность в формате ч:мм:сс.мс.
//
Функция Финиш(Знач Замер) Экспорт

	ДлительностьМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - Замер;

	Часы = Цел(ДлительностьМС / 3600000);
	Минуты = Цел(ДлительностьМС / 60000) % 60;
	Секунды = Цел(ДлительностьМС / 1000) % 60;
	Миллисекунды = ДлительностьМС % 1000;

	Представление = Формат(Часы, "ЧГ=0;ЧДЦ=0;ЧН=0")
		+ ":" + Прав("00" + Строка(Минуты), 2)
		+ ":" + Прав("00" + Строка(Секунды), 2)
		+ "." + Прав("000" + Строка(Миллисекунды), 3);

	Возврат Новый Структура("Миллисекунды, Представление", ДлительностьМС, Представление);

КонецФункции