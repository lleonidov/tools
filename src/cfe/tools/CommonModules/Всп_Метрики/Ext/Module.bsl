Функция ЗаписатьМетрику(Ключ, Токен, Число, Строка100, Дата, Комментарий) Экспорт
	Метрика 		 = НайтиМетрику(Ключ, Токен);
	Число = ПреобразоватьВЧисло(Число);
	
	Если Не ЗначениеЗаполнено(Метрика) Тогда
		ОсновноеЗначение = Перечисления.Всп_МетрикиОсновноеЗначение[
		?(ЗначениеЗаполнено(Число), "Число",
		?(ЗначениеЗаполнено(Строка100), "Строка100",
		?(ЗначениеЗаполнено(Строка100), "Дата",
		?(ЗначениеЗаполнено(Строка100), "Комментарий",
		"Число"))))];
		
		Метрика = СоздатьМетрику(Ключ, ОсновноеЗначение);
	КонецЕсли;
	
	ЗаписатьДанныеМетрики(Метрика, Число, Строка100, Дата, Комментарий);
	
КонецФункции

Процедура ЗаписатьДанныеМетрики(Метрика, Число, Строка100, Дата, Комментарий)
	Набор = РегистрыСведений.Всп_ДанныеМетрик.СоздатьНаборЗаписей();
    // Создаем новую строку в наборе
	НоваяЗапись = Набор.Добавить();
	НоваяЗапись.Активность  = Истина;
	НоваяЗапись.Метрика     = Метрика;
	НоваяЗапись.Период      = ТекущаяДатаСеанса();
	НоваяЗапись.Строка100   = Строка100;
	НоваяЗапись.Комментарий = Комментарий;
	НоваяЗапись.Число       = Число;
	НоваяЗапись.Дата        = Дата;

	// Ложь в параметре Записать означает, что мы НЕ заменяем существующие записи,
	// а просто пытаемся добавить новую в БД.
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать(Ложь);
	
КонецПроцедуры

Функция СоздатьМетрику(Ключ, ОсновноеЗначение)
	Метрика = Справочники.Всп_Метрики.СоздатьЭлемент();
	Метрика.Наименование = Ключ;
	Метрика.Ключ = Ключ;
	Метрика.ОсновноеЗначение = ОсновноеЗначение;
	Метрика.Записать();
	
	Возврат Метрика.Ссылка;
КонецФункции

Функция ПолучитьПараметрыЗапроса(Запрос, ПарамтрыТекст) Экспорт
	
	Параметры = СтрРазделить(ПарамтрыТекст, ",");
	
	Результат = Новый Структура;
	ВсеЗаполнены = Истина;
	
	ПараметрыЗапроса = Запрос.ПараметрыЗапроса;
	
	Для Каждого текКлюч Из Параметры Цикл
		ТекЗначение = ПараметрыЗапроса.Получить(текКлюч);
		
		Если текЗначение = Неопределено Тогда
			ВсеЗаполнены = Ложь;
		КонецЕсли;
		
		Результат.Вставить(ТекКлюч, ТекЗначение);
	КонецЦикла;
	
	Результат.Вставить("ВсеЗаполнены", ВсеЗаполнены);
	
	Возврат Результат;
КонецФункции

Функция ПолучитьПараметрыСсылки(Запрос, ПарамтрыТекст) Экспорт
	
	Параметры = СтрРазделить(ПарамтрыТекст, ",");
	
	Результат = Новый Структура;
	ВсеЗаполнены = Истина;
	
	ПараметрыЗапроса = Запрос.ПараметрыURL;
	
	Для Каждого текКлюч Из Параметры Цикл
		ТекЗначение = ПараметрыЗапроса.Получить(текКлюч);
		
		Если текЗначение = Неопределено Тогда
			ВсеЗаполнены = Ложь;
		КонецЕсли;
		
		Результат.Вставить(ТекКлюч, ТекЗначение);
	КонецЦикла;
	
	Результат.Вставить("ВсеЗаполнены", ВсеЗаполнены);
	
	Возврат Результат;
КонецФункции


Функция ЗначениеМетрики(Ключ, Токен) Экспорт
	Метрика = НайтиМетрику(Ключ, Токен);
	
	Если Не ЗначениеЗаполнено(Метрика) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Метрики = Новый Массив;
	Метрики.Добавить(Метрика);
	
	Результат = ДанныеМетрик(Метрики);
	
	Возврат Результат[Метрика];
КонецФункции

Функция ДанныеМетрик(Метрики) Экспорт
	Результат = Новый Соответствие;
	Запрос = Новый Запрос(ТекстЗапросаДанныхМетрик());
	Запрос.УстановитьПараметр("Метрики", Метрики);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого текСтрока Из РезультатЗапроса Цикл
		Результат.Вставить(текСтрока.Метрика, ?(Не текСтрока.Значение = null, текСтрока.Значение, текСтрока.Комментирай));
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ТекстЗапросаДанныхМетрик()
	ТекстЗапроса = "ВЫБРАТЬ
	|	Всп_ДанныеМетрикСрезПоследних.Метрика КАК Метрика,
	|	ВЫБОР
	|		КОГДА Всп_ДанныеМетрикСрезПоследних.Метрика.ОсновноеЗначение = ЗНАЧЕНИЕ(Перечисление.Всп_МетрикиОсновноеЗначение.Дата)
	|			ТОГДА Всп_ДанныеМетрикСрезПоследних.Дата
	|		КОГДА Всп_ДанныеМетрикСрезПоследних.Метрика.ОсновноеЗначение = ЗНАЧЕНИЕ(Перечисление.Всп_МетрикиОсновноеЗначение.Строка100)
	|			ТОГДА Всп_ДанныеМетрикСрезПоследних.Строка100
	|		КОГДА Всп_ДанныеМетрикСрезПоследних.Метрика.ОсновноеЗначение = ЗНАЧЕНИЕ(Перечисление.Всп_МетрикиОсновноеЗначение.Комментарий)
	|			ТОГДА Null
	|		ИНАЧЕ Всп_ДанныеМетрикСрезПоследних.Число
	|	КОНЕЦ КАК Значение,
	|Всп_ДанныеМетрикСрезПоследних.Комментарий Как Комментарий
	|ИЗ
	|	РегистрСведений.Всп_ДанныеМетрик.СрезПоследних КАК Всп_ДанныеМетрикСрезПоследних
	|ГДЕ
	|	Всп_ДанныеМетрикСрезПоследних.Метрика В (&Метрики)";
	
	Возврат ТекстЗапроса;
КонецФункции

Функция НайтиМетрику(Ключ, Токен)
	Метрика = Справочники.Всп_Метрики.НайтиПоРеквизиту("Ключ", Ключ);
	
	Возврат Метрика;
КонецФункции

Функция ПреобразоватьВчисло(ЧислоТекст)
	Число = Число(ЧислоТекст);
	
	Возврат Число;
КонецФункции