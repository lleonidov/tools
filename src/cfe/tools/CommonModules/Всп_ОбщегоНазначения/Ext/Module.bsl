#Область ПрограммныйИнтерфейс

// Функция получает значение реквизита объекта по строковому имени.
//
// Параметры:
//  Ссылка   - ЛюбаяСсылка - ссылка на объект базы данных 1С (документ, справочник и т.д.).
//  Реквизит - Строка - имя реквизита, значение которого необходимо получить.
//
// Возвращаемое значение:
//  Произвольный - значение запрошенного реквизита.
Функция ПолучитьЗначениеРеквизита(Ссылка, Реквизит) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Таблица." + Реквизит + " КАК ЗначениеРеквизита
		|ИЗ
		|	" + Ссылка.Метаданные().ПолноеИмя() + " КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Ссылка";
		
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ЗначениеРеквизита;
	
КонецФункции

// Заполняет поле "ДатаИзменения" текущей датой сеанса для всех записей в переданном наборе.
// Предназначена для вызова в обработчиках события "ПередЗаписью" модулей наборов записей регистров.
// 
// Параметры:
//  Набор - РегистрСведенийНаборЗаписей из РегистрСведенийЗапись, 
//          РегистрНакопленияНаборЗаписей из РегистрНакопленияЗапись, 
//          РегистрБухгалтерииНаборЗаписей из РегистрБухгалтерииЗапись, 
//          РегистрРасчетаНаборЗаписей из РегистрРасчетаЗапись - Подготавливаемый к записи набор записей. 
//          Элементы набора (записи) должны содержать доступное для записи свойство "ДатаИзменения".
Процедура ЗаполнитьДатаИзмененияНабору(Набор) Экспорт
	
	Для Каждого текЭлемент Из Набор Цикл
		текЭлемент.ДатаИзменения = ТекущаяДатаСеанса();
	КонецЦикла;
	
КонецПроцедуры

// Выполняет поиск переданных ссылок в указанной таблице базы данных.
// Возвращает соответствие только тех ссылок, которые физически существуют в базе.
// 
// Параметры:
//  ИмяТаблицы - Строка - Полное имя таблицы объекта метаданных (например, "Номенклатура").
//  УИД     - УникальныйИдентификатор, Массив Из УникальныйИдентификатор - То по чему ищем ссылку
//  Ссылки  - Массив Из ЛюбаяСсылка - Возвращает найденные ссылки
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Найденные существующие объекты:
//          * Ключ     - УникальныйИдентификатор - Уникальный идентификатор найденной ссылки;
//          * Значение - ЛюбаяСсылка - Сама найденная ссылка на объект базы данных.
Функция НайтиСсылкиСправочникаИзУид(ИмяТаблицы, Знач УИД, Ссылки = Неопределено) Экспорт
	НайденныеСсылки = Новый Соответствие;
	
	УИД = Всп_ОбщегоНазначенияКлиентСервер.ПривестиКМассиву(УИД);
	Ссылки = Новый Массив;
	
	Для Каждого ТекущийУИД ИЗ УИД Цикл
		Ссылки.Добавить(Справочники[ИмяТаблицы].ПолучитьСсылку(ТекущийУИД));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаСправочника.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК ТаблицаСправочника
		|ГДЕ
		|	ТаблицаСправочника.Ссылка В(&Ссылки)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Номенклатура", "Справочник." + ИмяТаблицы);
	
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НайденныеСсылки.Вставить(Выборка.Ссылка.УникальныйИдентификатор(), Выборка.Ссылка);
	КонецЦикла;
	
	
	Возврат НайденныеСсылки;
КонецФункции

Функция ЭтоСсылка(Значение) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Задачи.ТипВсеСсылки().СодержитТип(ТипЗначения);
	
КонецФункции

// Процедура удаляет из массива МассивРеквизитов элементы, соответствующие именам 
// реквизитов объекта из массива МассивНепроверяемыхРеквизитов.
// Для использования в обработчиках события ОбработкаПроверкиЗаполнения.
//
// Параметры:
//  МассивРеквизитов              - Массив - коллекция имен реквизитов объекта.
//  МассивНепроверяемыхРеквизитов - Массив - коллекция имен реквизитов объекта, не требующих проверки.
//
Процедура УдалитьНепроверяемыеРеквизитыИзМассива(МассивРеквизитов, МассивНепроверяемыхРеквизитов) Экспорт
	
	Для Каждого ЭлементМассива Из МассивНепроверяемыхРеквизитов Цикл
	
		ПорядковыйНомер = МассивРеквизитов.Найти(ЭлементМассива);
		Если ПорядковыйНомер <> Неопределено Тогда
			МассивРеквизитов.Удалить(ПорядковыйНомер);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Функция МассивВТаблицуСТипизацией(МассивДанных) Экспорт
	Если Не МассивДанных.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Таблица = Новый ТаблицаЗначений;
	
	Для Каждого Поле Из МассивДанных[0] Цикл

		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗнч(Поле.Значение));

		ТипКолонки = Новый ОписаниеТипов(
			МассивТипов, , Новый КвалификаторыСтроки(0));

		Таблица.Колонки.Добавить(Поле.Ключ, ТипКолонки);

	КонецЦикла;

	Для Каждого СтруктураСтроки Из МассивДанных Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), СтруктураСтроки);
	КонецЦикла;
	
	Возврат Таблица;
КонецФункции
#КонецОбласти