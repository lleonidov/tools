Функция ОтправитьСообщение(Сообщение, ДанныеОчереди, КлиентОбмена) Экспорт
	Результат 	   = Ложь;
	
	// Единообразие всегда отправляем массив
	Если ТипЗнч(Сообщение) = Тип("Строка") Тогда
		ПулСообщений = Новый Массив;
		ПулСообщений.Добавить(Сообщение);
	Иначе
		ПулСообщений = Сообщение;
	КонецЕсли;
	
	// Запишем сообщение в базу
	Результат = ЗаписатьСообщениеВБазу(ПулСообщений, ДанныеОчереди.Очередь, КлиентОбмена);
	
	Возврат Результат;
КонецФункции

Функция ПолучитьСообщение(ДанныеОчереди, КлиентОбмена, Сообщение = "", СообщениеНомер = 0) Экспорт
	КлючСоединения 	 		= КлиентОбмена.КлючСоединения;
	
	ПулСообщений   	 = КлиентОбмена.ПулСообщений;
	ДанныеСообщения  = ПулСообщений[КлиентОбмена.ТекущееСообщение];
	
	Если Не ДанныеСообщения = Неопределено 
	 Или Не ОбновитьПулСообщений(ПулСообщений, ДанныеОчереди, КлиентОбмена) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеСообщения = ПулСообщений[КлиентОбмена.ТекущееСообщение];
	
	Сообщение 	   = ДанныеСообщения.Данные;
	СообщениеНомер = КлиентОбмена.ТекущееСообщение;
	
	КлиентОбмена.ТекущееСообщение = КлиентОбмена.ТекущееСообщение + 1;
	
	Возврат Истина;
КонецФункции

Функция ПодтвердитьСообщение(НомерСообщения, ДанныеОчереди) Экспорт
	Результат = Ложь;
	
	ПодтверждаемыеСообщения  = Новый Массив;
	ПодтверждаемыеСообщения.Добавить(НомерСообщения);
	
	Результат = БазовоеПодтверждение(ПодтверждаемыеСообщения, ДанныеОчереди.Очередь);
	
	Возврат Результат;
КонецФункции

// Функция - Подтвердить все захваченные сообщения
//	Подтверждаем все захваченные в этой сессии сообщения по указанные номер.
// Параметры:
//  Подключение			 - 	Структура - Настройки подключения
//  ПоследнееСообщение	 - Число - Номер захваченного сообщения до которого включительно будут подтверждено.
// 
// Возвращаемое значение:
//  Булево - Успех подтверждения
//
Функция ПодтвердитьВсеЗахваченныеСообщения(ПодтверждаемыеСообщения, ДанныеОчереди) Экспорт
	Результат = Ложь;
	
	Результат = БазовоеПодтверждение(ПодтверждаемыеСообщения, ДанныеОчереди.Очередь);
	
	Возврат Результат;
КонецФункции

Функция ОтказОтСообщения(Обмен, СообщениеНомер) Экспорт
	
	Результат = Ложь;
	
	КлиентОбмена    = Обмен.КлиентОбмена;
	МенеджерСервиса = Справочники.СерверыВнешнихРесурсов;
	Очередь 		= КлиентОбмена.ТекущаяОчередь;
	ДанныеОчереди   = Обмен.Поиск[Очередь];
	
	Если ДанныеОчереди = Неопределено Тогда
		МенеджерСервиса.ДобавитьОшибку("Очередь не найдена", Обмен);
		Возврат Результат;
	КонецЕсли;

	Очередь	       = ДанныеОчереди.Метод;
	ПулСообщений   = КлиентОбмена.ПулСообщений;
	
	ДанныеСообщения = ПулСообщений[СообщениеНомер];
	
	Если ДанныеОчереди = Неопределено Тогда
		МенеджерСервиса.ДобавитьОшибку("Сообщение не найдено", Обмен);
		Возврат Результат;
	КонецЕсли;
	
	ПулСообщений.Удалить(СообщениеНомер);
	
    Возврат Результат;
КонецФункции

Функция Подключиться(Сервис, Обмен = Неопределено) Экспорт
	
	МенеджерСервиса = Справочники.СерверыВнешнихРесурсов;
	
	Если Обмен = Неопределено Тогда
		Обмен = Справочники.СерверыВнешнихРесурсов.ПолучитьНастройки(Сервис);
	КонецЕсли;
	
	Если Не Обмен.ВидАвторизации = Перечисления.ВидыАвторизации.NoAuth Тогда
		МенеджерСервиса.ДобавитьОшибку("Авторизация не требуется", Обмен);
		Обмен.Используется = Ложь;
		Возврат Обмен;
	КонецЕсли;
	
	Обмен.КлиентОбмена = ИнициализацияОбмена(Обмен);
	
	// TODO Надо вытащить из методов все что относится к очереди
	// Инициализация должна происходить тут или выше.
	Для Каждого ВидОчереди Из Обмен.Очереди Цикл
		Для Каждого Очередь Из ВидОчереди.Значение Цикл
			Основное = СтруктураОсновныхДанныхОчереди();
			Основное.Очередь = Очередь.Метод;
			Основное.КоличествоОбъектовЗаРаз = ?(Очередь.КоличествоОбъектовЗаРаз > 0, Очередь.КоличествоОбъектовЗаРаз, 100);
			Очередь.Вставить("Основное", Основное);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Обмен;
КонецФункции

Функция Отключиться(Обмен) Экспорт
	КлиентОбмена    = Обмен.КлиентОбмена;
	МенеджерСервиса = Справочники.СерверыВнешнихРесурсов;
	
	КлючСоединения  = КлиентОбмена.КлючСоединения;
	
	СброситьБлокирокуЧтения(КлючСоединения, КлиентОбмена);
	
	Обмен.КлиентОбмена = Неопределено;
КонецФункции

// Служебные

Процедура СброситьБлокирокуЧтения(КлючСоединения, КлиентОбмена, СброситьОчередь = Истина)
	
	// Для всех случаев кроме следующей партии чтения из той же очереди сбросим параметры
	Если СброситьОчередь Тогда
		КлиентОбмена.ПоследнееСообщение = 0;
		КлиентОбмена.ТекущаяОчередь = "";
	КонецЕсли;
	
	// Сбросим РС.БлокировкиОчередиЧтение
	ЗаблокированныеСообщения = РегистрыСведений.БлокировкиОчередиЧтение.СоздатьНаборЗаписей();
	ЗаблокированныеСообщения.Отбор.КлючСоединения.Установить(КлючСоединения);
	ЗаблокированныеСообщения.Записать(Истина);
	
КонецПроцедуры

Функция ИнициализацияОбмена(Обмен)
	КлиентОбмена = Новый Структура;
	МенеджерСервиса = Справочники.СерверыВнешнихРесурсов;
	КлиентОбмена.Вставить("КлючСоединения", Новый УникальныйИдентификатор);
	КлиентОбмена.Вставить("ПулСообщений",  Новый Соответствие);
	КлиентОбмена.Вставить("ТекущаяОчередь");
	КлиентОбмена.Вставить("ПоследнееСообщение", 0);
	КлиентОбмена.Вставить("ТекущееСообщение", 0);
	КлиентОбмена.Вставить("ЗаписейЗаТранзакцию", 200);
	КлиентОбмена.Вставить("ОбработаноСообщений", 0);
	КлиентОбмена.Вставить("ВидОперации", Перечисления.МетодыБрокераСообщений.ПустаяСсылка());
	
	Возврат КлиентОбмена;
КонецФункции

Функция ОбновитьПулСообщений(ПулСообщений, ДанныеОчереди, КлиентОбмена)
	// Этот пул сообщений будет отпущен 
	// 	1) по таймауту 
	// 	2) все сообщения подтвердятся или вернуться в очередь.
	//  3) Начнется чтение\ запись в любую другую очередь
	
	// Таймаут будет работать так. 
	//		Раз в минуту если есть чтение в очередь записываем это событие, не чаще
	//		Если не было чтения из этой очереди в течении 20 минут сбрасываем запрет на сообщения.
	ЕстьНовыеДанные = Ложь;
	
	Очередь = ДанныеОчереди.Очередь;
	
	НачатьТранзакцию();
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.БлокировкиОчередиЧтение");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Очередь", Очередь);
	
	Попытка
		БлокировкаДанных.Заблокировать();
	Исключение
		ОтменитьТранзакцию();
		
		Возврат Ложь;
	КонецПопытки;
	
	// Получим данные
	ПоследнееСообщение 		= КлиентОбмена.ПоследнееСообщение;
	КоличествоОбъектовЗаРаз = ДанныеОчереди.КоличествоОбъектовЗаРаз;
	
	ШаблонЗамены = СтрШаблон("Первые %1", Формат(КоличествоОбъектовЗаРаз, "ЧГ="));
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 111
		|	ОчередьСообщений.НомерСообщения КАК НомерСообщения,
		|	ОчередьСообщений.Данные КАК Данные
		|ИЗ
		|	РегистрСведений.ОчередьСообщений КАК ОчередьСообщений
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.БлокировкиОчередиЧтение КАК БлокировкиОчередиЧтение
		|		ПО ОчередьСообщений.Очередь = БлокировкиОчередиЧтение.Очередь
		|			И ОчередьСообщений.НомерСообщения >= БлокировкиОчередиЧтение.ПервоеСообщение
		|			И ОчередьСообщений.НомерСообщения <= БлокировкиОчередиЧтение.ПоследнееСообщение
		|ГДЕ
		|	ОчередьСообщений.Очередь = &Очередь
		|	И БлокировкиОчередиЧтение.Очередь ЕСТЬ NULL
		|	И ОчередьСообщений.НомерСообщения > &ПоследнееСообщение
		
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСообщения";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 111", ШаблонЗамены);
	
	Запрос.УстановитьПараметр("Очередь", 			Очередь);
	Запрос.УстановитьПараметр("ПоследнееСообщение", ПоследнееСообщение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЗСообщений = РезультатЗапроса.Выгрузить();
	
	Если Не ТЗСообщений.Количество() Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	// Захватим сообщения за собой.
	ПерваяСтрока = ТЗСообщений[0];
	ПоследняяСтрока = ТЗСообщений[ТЗСообщений.Количество() - 1];
	ЗаблокированныеСообщения = РегистрыСведений.БлокировкиОчередиЧтение.СоздатьМенеджерЗаписи();
	ЗаблокированныеСообщения.Очередь 		   	   = Очередь;
	ЗаблокированныеСообщения.КлючСоединения 	   = КлиентОбмена.КлючСоединения;
	ЗаблокированныеСообщения.ПервоеСообщение	   = ПерваяСтрока.НомерСообщения;
	ЗаблокированныеСообщения.ПоследнееСообщение    = ПоследняяСтрока.НомерСообщения;
	ЗаблокированныеСообщения.ДатаБлокировки        = ТекущаяДатаСеанса();
	
	Попытка
		ЗаблокированныеСообщения.Записать(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	КлиентОбмена.ТекущееСообщение = Макс(1, КлиентОбмена.ТекущееСообщение);
	
	Индекс = КлиентОбмена.ТекущееСообщение;
	
	
	Для Каждого текДанныеСообщения Из ТЗСообщений Цикл
		ДанныеСообщения = СтруктураСообщения();
		ДанныеСообщения.Данные 		   = текДанныеСообщения.Данные;
		ДанныеСообщения.НомерСообщения = текДанныеСообщения.НомерСообщения;
		ДанныеСообщения.Очередь 	   = Очередь;
		ПулСообщений.Вставить(Индекс, ДанныеСообщения);
		Индекс = Индекс + 1;
		
		КлиентОбмена.ПоследнееСообщение = текДанныеСообщения.НомерСообщения;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции

Функция СтруктураСообщения()
	ДанныеСообщения =  Новый Структура;
	ДанныеСообщения.Вставить("Данные", "");
	ДанныеСообщения.Вставить("Очередь");
	ДанныеСообщения.Вставить("НомерСообщения");
	
	Возврат ДанныеСообщения;
КонецФункции

Функция СтруктураОсновныхДанныхОчереди()
	Основные =  Новый Структура;
	Основные.Вставить("Очередь");
	Основные.Вставить("КоличествоОбъектовЗаРаз");
		
	Возврат Основные;
КонецФункции

Функция ЗаписатьСообщениеВБазу(Знач ПулСообщений, Знач Очередь, КлиентОбмена)
	Результат = Ложь;
	
	МенеджерСервиса = Справочники.СерверыВнешнихРесурсов;
	
	ЗаписейЗаТранзакцию  = КлиентОбмена.ЗаписейЗаТранзакцию;
	
	ВсегоСообщений 	     = ПулСообщений.Количество();
	ТекущиНомерСообщения = ПолучитьПулНомеровЗаписи(ВсегоСообщений, Очередь);
	
	Если ТекущиНомерСообщения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Элемент = 0;
	Отправлено = 0;
	СообщенияОчереди = РегистрыСведений.ОчередьСообщений.СоздатьНаборЗаписей();
	
	Для Каждого Сообщение Из ПулСообщений Цикл
		Элемент = Элемент + 1;
		Отправлено = Отправлено + 1;
		НовоеСообщение = СообщенияОчереди.Добавить();
		НовоеСообщение.НомерСообщения = ТекущиНомерСообщения;
		НовоеСообщение.Очередь   = Очередь;
		НовоеСообщение.Данные 	 = Сообщение;
		
		Если ЗаписейЗаТранзакцию = Элемент Тогда
			Элемент = 0;
			
			Попытка
				СообщенияОчереди.Записать(Ложь);
				ЗафиксироватьТранзакцию();
				Результат = Истина;
			Исключение
				ОтменитьТранзакцию();
				Текст  = ОписаниеОшибки();
				МенеджерСервиса.ДобавитьОшибку(СтрШаблон("Ошибка при записи сообщения: %1", Текст), КлиентОбмена);
				
				Возврат Ложь;
			КонецПопытки;
			
			НачатьТранзакцию();
		КонецЕсли;
		
		ТекущиНомерСообщения = ТекущиНомерСообщения + 1;
	КонецЦикла;
	
	Если ТранзакцияАктивна() Тогда
		СообщенияОчереди.ОбменДанными.Загрузка = Истина;
		
		Попытка
			СообщенияОчереди.Записать(Ложь);
			ЗафиксироватьТранзакцию();
			Результат = Истина;
		Исключение
			ОтменитьТранзакцию();
			Текст  = ОписаниеОшибки();
			МенеджерСервиса.ДобавитьОшибку(СтрШаблон("Ошибка при получении сообщения: %1", Текст), КлиентОбмена);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ПолучитьПулНомеровЗаписи(ВсегоСообщений, Очередь)
	НачатьТранзакцию();
	ПервыйНомер = Неопределено;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.БлокировкиОчередиЗапись");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Очередь", Очередь);
	
	Попытка
		БлокировкаДанных.Заблокировать();
	Исключение
		ОтменитьТранзакцию();
		Возврат ПервыйНомер;
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	БлокировкиОчередиЗапись.Очередь КАК Очередь,
		|	БлокировкиОчередиЗапись.ПоследнееСообщение КАК ПоследнееСообщение
		|ИЗ
		|	РегистрСведений.БлокировкиОчередиЗапись КАК БлокировкиОчередиЗапись
		|ГДЕ
		|	БлокировкиОчередиЗапись.Очередь = &Очередь
		|
		|ДЛЯ ИЗМЕНЕНИЯ
		|	РегистрСведений.БлокировкиОчередиЗапись";
	
	Запрос.УстановитьПараметр("Очередь", Очередь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Номер = 0;
	
	Если Выборка.Следующий() Тогда
		Номер = Выборка.ПоследнееСообщение;
	КонецЕсли;
	
	// Запишем и отпустим
	ИзменениеНомера = РегистрыСведений.БлокировкиОчередиЗапись.СоздатьМенеджерЗаписи();
	ИзменениеНомера.Очередь = Очередь;
	ИзменениеНомера.ПоследнееСообщение = Номер + ВсегоСообщений;
	Попытка
		ИзменениеНомера.Записать(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат ПервыйНомер;
	КонецПопытки;
	
	ПервыйНомер = Номер + 1;
	
	Возврат ПервыйНомер;
КонецФункции

// Удаляем безвозвратно запись.
Функция БазовоеПодтверждение(ДанныеСообщений, Очередь)
	Результат = Ложь;
	НачатьТранзакцию();
	
	Ном = 0;
	УдалениеСообщения    = РегистрыСведений.ОчередьСообщений.СоздатьНаборЗаписей();
	
	Для Каждого НомерСообщения Из ДанныеСообщений Цикл
		УдалениеСообщения.Отбор.Очередь.Установить(Очередь);
		УдалениеСообщения.Отбор.НомерСообщения.Установить(НомерСообщения);
		
		Попытка
			УдалениеСообщения.ОбменДанными.Загрузка = Истина;
			УдалениеСообщения.Записать(Истина);
		Исключение
			ОтменитьТранзакцию();
			Текст  = ОписаниеОшибки();
			//МенеджерСервиса.ДобавитьОшибку(СтрШаблон("Ошибка при подтверждении сообщения: %1", Текст), Обмен);
			Возврат Результат;
		КонецПопытки;
		
	КонецЦикла;
	
	Попытка
		ЗафиксироватьТранзакцию();
		Результат = Истина;
	Исключение
		ОтменитьТранзакцию();
		Текст  = ОписаниеОшибки();
		//МенеджерСервиса.ДобавитьОшибку(СтрШаблон("Ошибка при подтверждении сообщения: %1", Текст), Обмен);
	КонецПопытки;	
			
	Возврат Результат;
КонецФункции