#Область ПрограммныйИнтерфейс

// Запускает процесс многопоточного создания уникальных идентификаторов (УИД).
//
// Параметры:
//  Количество    - Число - общее количество УИД, которое необходимо создать.
//  Идентификатор - УникальныйИдентификатор - идентификатор задания или сеанса запуска. 
//                  Значение по умолчанию: Неопределено.
Процедура ЗапуститьСозданиеУИД(Количество, Идентификатор = Неопределено) Экспорт
	УИДЗаРаз = 3333;
	Потоков    = Количество / УИДЗаРаз;
	Потоков    = ?(Потоков = Цел(Потоков), Потоков, Цел(Потоков) + 1);
	ВидЗадания = Справочники.Всп_Контекст.ТестСозданиеУИД;
	
	Потоки = Всп_Многопоточность.Инициализация(
		"Создание УИД %1", 
		"МногопоточностьТест.СоздатьУИД", 
		Потоков, 
		ВидЗадания,
		Идентификатор);
	
	Потоки.ЗавершитьПриОшибках = Истина;
	
	// Создадим рег задания для обмена
	ВсегоУИД = Количество;
	
	Для Ном = 1 По Потоков Цикл
		СоздатьУИД = Мин(ВсегоУИД, УИДЗаРаз);
		МассивПараметров = Всп_ОбщегоНазначенияКлиентСервер.ДобавитьПараметры(СоздатьУИД); 
		Всп_Многопоточность.ДобавитьПоток(Потоки, МассивПараметров);
		ВсегоУИД = ВсегоУИД - СоздатьУИД;
	КонецЦикла;
	
	Выполнено = Всп_Многопоточность.ДождатьсяВыполнения(Потоки);
	Результат = Всп_Многопоточность.ПолучитьРезультатВыполненияПотоков(Потоки);
	СтатусВыполнения = СтрШаблон("Обработка выполнена (%1), Создано УИД %2", Выполнено, Результат.Количество());
	Всп_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтатусВыполнения);
	
КонецПроцедуры

// Создает заданное количество уникальных идентификаторов и сохраняет результат в поток.
//
// Параметры:
//  Количество      - Число - количество создаваемых уникальных идентификаторов.
//  ПараметрыПотока - Структура - параметры текущего фонового потока, см. Всп_Многопоточность.ПараметрыПотока
Процедура СоздатьУИД(Количество, ПараметрыПотока) Экспорт
	Если Всп_Многопоточность.ПораЗавершатьПоток(ПараметрыПотока) Тогда
		ВызватьИсключение "Ошибка в потоке";
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Для Индекс = 1 По Количество Цикл
		Результат.Добавить(Новый УникальныйИдентификатор);
		
		Если Всп_Многопоточность.ПораЗавершатьПоток(ПараметрыПотока) Тогда
			ВызватьИсключение "Ошибка в потоке.";
		КонецЕсли;
	КонецЦикла;

	Всп_Многопоточность.СохранитьРезультат(Результат, ПараметрыПотока);
КонецПроцедуры

#КонецОбласти