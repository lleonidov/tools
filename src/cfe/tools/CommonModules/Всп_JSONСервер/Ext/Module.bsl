Функция ПолучитьИмяПеречисления(Знач ПеречислениеСсылка)  	
	Имя = "";
	
	ИмяМетаданных = ПеречислениеСсылка.Метаданные().Имя;
	НазваниеМенеджера = "ПеречислениеМенеджер." + ИмяМетаданных;    
	Менеджер = Новый (НазваниеМенеджера); 
	
	Если ЗначениеЗаполнено(ПеречислениеСсылка) Тогда
		Имя = ПеречислениеСсылка.Метаданные().ЗначенияПеречисления[Менеджер.Индекс(ПеречислениеСсылка)].Имя;
	КонецЕсли;
	
	Возврат Имя;  
КонецФункции

Функция ПроверкаМаски(Текст, Маска)
	// Проверяем только по цифрам и на фиксированный ввод
	Результат  = Истина;
	ДлинаТекст = СтрДлина(Текст);
	
	Если Не ДлинаТекст = СтрДлина(Маска) Тогда
		Результат = Ложь;
	Иначе
		Для Ном = 1 По ДлинаТекст Цикл
			текСимвол = Сред(Текст, Ном, 1);
			текШаблон = Сред(Маска, Ном, 1);
			
			Если текШаблон = "9" 
				И (текСимвол >= "0" И текСимвол <= "9") Тогда
			ИначеЕсли Не текСимвол = текШаблон Тогда
				Результат = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

//целей передавать тип колонки нет, но оставим возможность.
Функция КолонкиТЗВСтруктуру(ТаблицаЗначений, ЕстьФайл = Ложь) Экспорт
	Результат 			 = Новый Структура;
	КоличествоСовпадений = 0;//полей определяющих, что есть файл
	
	Для Каждого текКолонка Из ТаблицаЗначений.Колонки Цикл
		текИмя = текКолонка.Имя;
		Результат.Вставить(текИмя);
		Если НРЕГ(текИмя) = НРЕГ("ПутьКФайлу") 
		 или НРЕГ(текИмя) = НРЕГ("ТипХраненияФайла") 
		 или НРЕГ(текИмя) = НРЕГ("Ссылка")
		 или НРЕГ(текИмя) = НРЕГ("Том")  Тогда
		 
			КоличествоСовпадений = КоличествоСовпадений + 1;
		КонецЕсли;
	КонецЦикла;
	Если КоличествоСовпадений =  4 Тогда
		ЕстьФайл = Истина;
		Результат.Вставить("_FileStorage_");
		КС = Новый КвалификаторыСтроки();
		Массив = Новый Массив;
		Массив.Добавить(Тип("Строка"));
		ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
		ТаблицаЗначений.Колонки.Добавить("_FileStorage_", ОписаниеТиповС);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция СтрокиТЗВМассив(ТаблицаЗначений, КолонкиСтруктура, Параметры, Рекурсия, ПреобразовыватьДляJson, ЖурналПараметры, ПараметрыПакета, Колонки) Экспорт
	Результат 		= Новый Массив;
	Для Каждого текСтрока Из ТаблицаЗначений Цикл
		//текСтрокаСтруктура = СкопироватьКлючиСтруктуры(КолонкиСтруктура);//;Новый Структура(текКолонкиТХТ);
		Если ПреобразовыватьДляJson Тогда
			текСтрокаМассив = Новый Массив;
		КонецЕсли;
		Для Каждого текКолонка Из ТаблицаЗначений.Колонки Цикл
			Если текКолонка.Имя = "_FileStorage_" Тогда
				//Если текСтрока.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВТомахНаДиске Тогда
				//	текЗначение = ПолучитьФайлВТоме(текСтрока.Ссылка, текСтрока.Том, ТекСтрока.ПутьКФайлу, ЖурналПараметры, ПараметрыПакета);
				//	//текСтрока.Том 			= "";
				//Иначе
				//	АдресВоВременномХранилище   = ПрисоединенныеФайлы.ПолучитьДанныеФайла(ТекСтрока.Ссылка).СсылкаНаДвоичныеДанныеФайла;
				//	
				//	текЗначение = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
				//	текЗначение = Base64Строка(текЗначение);
				//КонецЕсли;
				текЗначение = "";
			Иначе
				текЗначение = текСтрока[текКолонка.Имя];
				
				Если ТипЗнч(текЗначение) = Тип("ТаблицаЗначений") И текКолонка.Имя = "ДополнительныеРеквизиты" 
					И текЗначение.Колонки.Найти("Свойство") <> Неопределено Тогда
					СвойствоКЛ = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.КонтактноеЛицо;
					МассивУдаляемыхСтрок = Новый Массив;
					
					Для Каждого текСтрокаДР Из текЗначение Цикл
						Если текСтрокаДР.Свойство = СвойствоКЛ Тогда
							МассивУдаляемыхСтрок.Добавить(текСтрокаДР);
						КонецЕсли;
					
					КонецЦикла;
					
					Для Каждого текСтрокаУС Из МассивУдаляемыхСтрок Цикл
						текЗначение.Удалить(текСтрокаУС);
					КонецЦикла;
				ИначеЕсли ТипЗнч(текЗначение) = Тип("ТаблицаЗначений") И текКолонка.Имя = "КонтактнаяИнформация" Тогда
					текЗначение.Очистить();
				КонецЕсли;
				
				текЗначение = ПреобразоватьВБазовыеЗначения(текЗначение, Параметры, Рекурсия, ПреобразовыватьДляJson, ЖурналПараметры, ПараметрыПакета, Колонки);
			КонецЕсли;
			//текСтрокаСтруктура[текКолонка.Имя] = текЗначение;
			Если ПреобразовыватьДляJson Тогда
				текСтрокаМассив.Добавить(текЗначение);
			Иначе
				текСтрока[текКолонка.Имя] = текЗначение;
			КонецЕсли;
		КонецЦикла;
		//Результат.Добавить(текСтрокаСтруктура);
		Если ПреобразовыватьДляJson Тогда
			Результат.Добавить(текСтрокаМассив);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции


Функция СтруктураПараметровПакета(Ключ, Значение = Неопределено, КоличествоОбъектов = 0)
	Результат = Новый Структура("ВидОбъекта, ТипОбъекта, Ключи, КлючиПред, ПакетНомер, 
	|КоличествоОбъектов, ВидОбмена, Ошибка, ОшибкаТекст, Значение, СпискиКонфликтов");	
	
	Результат.СпискиКонфликтов = Новый Структура("БитыеСсылки", Новый Массив);
	Разделитель = Найти(Ключ, ".");
	
	Результат.ТипОбъекта   		 = Лев(Ключ,  Разделитель - 1);
	Результат.ВидОбъекта   		 = Сред(Ключ, Разделитель + 1);
	//Результат.МассивСсылок 		 = Новый Массив;
	Результат.Ключи 	   		 = Неопределено;
	Результат.КлючиПред 	   	 = Новый Структура;
	Результат.КоличествоОбъектов = КоличествоОбъектов;
	Результат.Ошибка			 = Ложь;
	Результат.ОшибкаТекст		 = "";
	Результат.Значение			 = Значение;
	
	Возврат Результат;
КонецФункции

Функция НайтиТип(Параметры, ТипЗначения, ЭтоСсылка = Ложь, Правило = Неопределено) Экспорт
	Результат = "";
	Остальные = Параметры.Типы.Остальные;
	ТипСтрока = Остальные[ТипЗначения];
	Если ТипСтрока = Неопределено Тогда
		МетаданныеСсылки = Метаданные.НайтиПоТипу(ТипЗначения);
		Если МетаданныеСсылки = Неопределено Тогда
			Результат = Строка(ТипЗначения);
		Иначе
			Результат = МетаданныеСсылки.ПолноеИмя();
			Правило   = Параметры.Состав[Результат];
			ЭтоСсылка = Истина;
		КонецЕсли;
		Кеш = Новый Структура("Результат, ЭтоСсылка, Правило", Результат, ЭтоСсылка, Правило);
		Остальные.Вставить(ТипЗначения, Кеш);
	Иначе
		Результат = ТипСтрока.Результат;
		ЭтоСсылка = ТипСтрока.ЭтоСсылка;
		Правило	  = ТипСтрока.Правило;
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции


