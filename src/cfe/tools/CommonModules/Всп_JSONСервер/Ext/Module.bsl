Функция ПоискДатыВСтруктуре(Структура)
	Результат = Неопределено;
	
	Если ТипЗнч(Структура) = Тип("Структура")  
		ИЛИ ТипЗнч(Структура) = Тип("Соответствие") Тогда
		
		Если ТипЗнч(Структура) = Тип("Структура") Тогда  
			Результат = Новый Структура;
		Иначе
			Результат = Новый Соответствие;
		КонецЕсли;
		
		Для Каждого текКлючЗначение Из Структура Цикл
			текЗначение = текКлючЗначение.Значение;
			
			Если ТипЗнч(текЗначение) = Тип("Структура")  
				ИЛИ ТипЗнч(текЗначение) = Тип("Соответствие") Тогда
				текЗначение = ПоискДатыВСтруктуре(текЗначение);
			КонецЕсли;
			

			Если ТипЗнч(текЗначение) = Тип("Строка") И 
				ПроверкаМаски(текЗначение, "9999-99-99T99:99:99") Тогда
				// 2022-06-21T16:12:23
				текЗначение = ПолучитьДатуJson(текЗначение);
			КонецЕсли;
			
			Результат.Вставить(текКлючЗначение.Ключ, текЗначение);
		КонецЦикла;
	Иначе
		Результат = Структура;
	КонецЕсли;
		
	Возврат Результат;
КонецФункции
// Доп параметры защита от рекурсии объявляется в этом модуле
// СтруктураОбмена содержит в себе правила подмены ссылок на уровне всего справочника
// ПоляИсключения список полей которые дополнительно оборачиваем как текст
// Записывает значение в JSON-строку с учетом структуры обмена и ограничений на базовые типы.
//
// Параметры:
//  Значение - Произвольный - Значение, которое требуется сериализовать.
//  СтруктураОбмена - Структура - Параметры обмена, используемые при сериализации.
//
// Возвращаемое значение:
//  Строка - JSON-строка с сериализованным значением.
Функция ЗаписьВСтрокуJSON(Значение, Знач СтруктураОбмена = Неопределено)  Экспорт
	//если вдруг будут не базовые, то они не выгрузятся
	Если СтруктураОбмена = Неопределено Тогда
		СтруктураОбмена = СтруктураНастроекОбмена();
	КонецЕсли;
	
	СтруктураОбмена.Настройка.ТолькоБазовые = Истина;
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение,,"ДополнительнаяСериализацияJSON", , СтруктураОбмена);
	СериализованноеЗначение = ЗаписьJSON.Закрыть();
	
	Возврат СериализованноеЗначение;
КонецФункции

// Формирует структуру настроек обмена для сериализации и десериализации данных.
//
// Параметры:
//  НастройкаОбмена - Произвольный - Настройка обмена.
//  ВариантЗапуска - Строка - Вариант запуска обработки.
//  ТолькоБазовые - Булево - Признак ограничения сериализации только базовыми типами.
//
// Возвращаемое значение:
//  Структура - Настройки обмена и преобразования значений.
Функция СтруктураНастроекОбмена(НастройкаОбмена = Неопределено, ВариантЗапуска = Неопределено, ТолькоБазовые = Ложь) Экспорт
	Результат = Новый Структура("Настройка, УзелДанные, Подключение, Типы, Состав, СоставОтбор, Подмены, ДатаОбмена, Параметры");
	
	Настройка = Новый Структура("НастройкаОбмена, ОтложеннаяОтправка , ВариантЗапуска, ТолькоБазовые, ПереносФайловВТомах, 
			|ИнициаторОбменаДанными, Код, Версия, Hash, ОбновлятьСразу, ОбновлятьДинамическиСразу",
			НастройкаОбмена, Ложь, ВариантЗапуска,  ТолькоБазовые, Ложь
			, , , "" , "", Ложь, Ложь);
	
	Результат.Состав	  = Новый Соответствие;
	Результат.СоставОтбор = Новый Соответствие;
	Результат.Настройка   = Настройка;
	Результат.ДатаОбмена  = ТекущаяДата();
	Результат.УзелДанные  = Новый Структура("УзелОбмена, УзелКонфигурации,НомерОтправленного, НомерПринятого, 
			|ОтправительКод, ПолучательКод, Центр, УзелБитыеСсылки");
	Результат.Подключение = Новый Структура("Транспорт, ТипНастройки, НастройкаПодключения, МодульОбмена");
	Результат.Типы 		  = ЗаполнитьБазовыеТипы();
	
	Возврат Результат;
КонецФункции

Функция ДополнительнаяСериализацияJSON(Свойство, Значение, Параметры, Отказ) Экспорт 
	Результат 	= "";
	ТипЗначения = ТипЗнч(Значение);
	Если НЕ Параметры.Типы.Базовые.Найти(ТипЗначения) = Неопределено Тогда
		Результат = Значение;
		
	Иначе
		текстБазовые = ?(Параметры.Настройка.ТолькоБазовые, нСтр("ru = 'только базовые'"), "");
		Результат    = нСтр("ru = '<<--ошибка преобразования %1 -->>'");
		Результат	 = ПодставитьПараметрыВСтроку(Результат, ТекстБазовые);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ЗаполнитьБазовыеТипы()
	Результат = Новый Структура;
	//Перенес кеш типов из розницы, там в другом виде, проверил, что мой вариант работает по скорости так же.
	//!!!
	//При обходе 50тыс+ элементов экономит время, релиз 8.3.13.1865 режим совместимости 8.2.14
	//надо еще раз замерить и поставить время выполнения. Скорость увеличивалась на 0,5% от общего времени 
	//Плюс проверить экономию на поиске базовых в массиве
	//Если экономия на 5к элементов менее 1% при 5секундах на 5тыс элементах, то забить.
	//пакет на 5к элементов с записью 10 сек... Выгрузка с записью Номенклатуры 100 элементов за 10 сек 
	//т.е. т.к. основное время тратиться десериализация и запись объекта в запись это не важно
	//Кеш
	Результат.Вставить("УИД", Тип("УникальныйИдентификатор")); 
	Результат.Вставить("Массив", Тип("Массив"));
	Результат.Вставить("Структура", Тип("Структура"));
	Результат.Вставить("Соответствие", Тип("Соответствие"));
	Результат.Вставить("Строка", Тип("Строка"));
	Результат.Вставить("Число", Тип("Число"));
	Результат.Вставить("Булево", Тип("Булево"));
	Результат.Вставить("Дата", Тип("Дата"));
	Результат.Вставить("Неопределено", Тип("Неопределено"));
	Результат.Вставить("Null", Тип("Null"));
	Результат.Вставить("ДД", Тип("ДвоичныеДанные"));
	Результат.Вставить("Хранилище", Тип("ХранилищеЗначения"));
	Результат.Вставить("ВидДвиженияНакопления", Тип("ВидДвиженияНакопления"));
	Результат.Вставить("ВидДвиженияБухгалтерии", Тип("ВидДвиженияБухгалтерии"));
	Результат.Вставить("Хранилище", Тип("ХранилищеЗначения"));
	Результат.Вставить("ТЗ", Тип("ТаблицаЗначений"));
	Результат.Вставить("СЗ", Тип("СписокЗначений"));
	Результат.Вставить("Базовые", Новый Массив);
	Результат.Вставить("Остальные", Новый Соответствие);
	
	//8.2.16 + умеет в json сериализовать эти типы
	Результат.Базовые.Добавить(Результат.Строка);
	Результат.Базовые.Добавить(Результат.Число);
	Результат.Базовые.Добавить(Результат.Булево);
	Результат.Базовые.Добавить(Результат.Неопределено);
	
	Возврат Результат;
КонецФункции

