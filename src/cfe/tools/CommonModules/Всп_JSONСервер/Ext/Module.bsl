// Преобразует промежуточное представление таблицы значений в объект ТаблицаЗначений.
//
// Параметры:
//  Промежуточный - Структура - Промежуточное представление таблицы, полученное из JSON.
//  Параметры     - Структура - Параметры обмена и сериализации.
//  Рекурсия      - Число - Текущий уровень рекурсии.
//  ЖурналПараметры - Структура - Параметры журнала регистрации.
//  Колонки       - Массив - Колонки таблицы значений.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица, восстановленная из промежуточного представления.
Функция ДесериализацииТаблица(Промежуточный, Параметры, Рекурсия, ЖурналПараметры, Колонки) Экспорт
	Результат  = Новый ТаблицаЗначений;
	Колонки = Промежуточный.Column;
	
	Для Каждого текКолонка Из Колонки Цикл
		Результат.Колонки.Добавить(текКолонка.Ключ);	
	КонецЦикла;
	
	Для Каждого текСтрока Из Промежуточный.Row Цикл
		ном = 0;
		НС  = Результат.Добавить();					
		
		Для Каждого текКолонка Из Колонки Цикл
			текЗначение = Всп_JSON.Десериализации(текСтрока[ном], Параметры, Рекурсия, ЖурналПараметры, Колонки);
			
			НС[текКолонка.Ключ] = текЗначение;
			
			ном = ном + 1;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Сериализует переданное значение в строку формата JSON.
//
// Параметры:
//  Значение - Произвольный - Значение для записи в формате JSON. Поддерживаются любые типы,
//             доступные для сериализации (в том числе Массив из Произвольный).
//
// Возвращаемое значение:
//  Строка - Строковое представление переданного значения.
Функция ЗаписьВСтроку(Значение) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	ЗначениеСтрока = ЗаписьJSON.Закрыть();
	
	Возврат ЗначениеСтрока;
КонецФункции

// Функция - Чтение из строки JSON
//
// Параметры:
//  СтрокаJSON				 - Строка - Данные
//  ПрочитатьВСоответствие	 - Булево - чтение в соответсвтие
//  ПроверятьСимволы		 - Булево - удаляем недопустимые символы для XML сериализации
//  СтрокаДата				 - Булево - Все строковые значения проверяем на дату по шаблону 2022-06-21T16:12:23
// 
// Возвращаемое значение:
//  Произвольный - В основном в обмене передаются структуры, массивы, но иногда даты, ссылки,...
//
Функция ЧтениеИзСтрокиJSON(СтрокаJSON, ПрочитатьВСоответствие = Ложь,
			ПроверятьСимволы = Ложь, СтрокаДата = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		СтрокаJSON = """""";
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Структура  = ПрочитатьJSON(ЧтениеJSON, ПрочитатьВСоответствие);	
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Структура;	
КонецФункции

// ПреобразовыватьДляJson преобразует ДвоичныеДанные, Ссылки, ХранилищаЗначения и остальное то что не сериализауется в JSON
// Если ложь, происходит обход структуры и применение базовых правил пока только замена ссылок
Функция ПреобразоватьВБазовыеЗначения(Значение, Параметры = Неопределено, Рекурсия = Неопределено, 
		ПреобразовыватьДляJson = Истина, ЖурналПараметры = Неопределено, ПараметрыПакета = Неопределено, 
		Колонки = Неопределено) Экспорт
	
	Если Параметры = Неопределено Тогда
		Параметры = СтруктураНастроекОбмена(,,Истина);
	КонецЕсли;
	Если ПараметрыПакета = Неопределено Тогда
		//в параметрах пакета есть поле ошибка, если на любом из этапов оно ложь, то пакет не сформирован
		ПараметрыПакета = СтруктураПараметровПакета("Неопределено");
	КонецЕсли;
	
	Результат 	= "";
	ТипЗначения = ТипЗнч(Значение);
	
	Если НЕ Параметры.Типы.Базовые.Найти(ТипЗначения) = Неопределено Тогда
		Результат = Значение;
	ИначеЕсли ТипЗначения = Параметры.Типы.УИД Тогда
		Если ПреобразовыватьДляJson Тогда
			Результат = Строка(Значение);
		Иначе
			Результат = Значение;
		КонецЕсли;
	ИначеЕсли ТипЗначения = Параметры.Типы.Массив Тогда
		Результат = Новый Массив;
		
		Для Каждого текЭлемент Из Значение Цикл
			текЭлементПреобразованный = ПреобразоватьВБазовыеЗначения(текЭлемент, Параметры, Рекурсия, ПреобразовыватьДляJson, ЖурналПараметры, ПараметрыПакета, Колонки);
			Результат.Добавить(текЭлементПреобразованный);
		КонецЦикла;
	ИначеЕсли ТипЗначения = Параметры.Типы.Структура Тогда
		Для Каждого текЭлемент Из Значение Цикл
			текЭлементПреобразованный = ПреобразоватьВБазовыеЗначения(текЭлемент.Значение, Параметры, Рекурсия, ПреобразовыватьДляJson, ЖурналПараметры, ПараметрыПакета, Колонки);
			Значение[текЭлемент.Ключ] = текЭлементПреобразованный; 
		КонецЦикла;
		Результат = Значение;
	ИначеЕсли ТипЗначения = Параметры.Типы.СЗ Тогда
		Результат 	   = Новый Структура("NoBasicValue_, Type");
		Результат.Type = НайтиТип(Параметры, ТипЗначения);
		НЗначение      = Новый Массив;        		
		
		Для Каждого текЭлемент Из Значение Цикл
			текЭлементПреобразованный = ПреобразоватьВБазовыеЗначения(текЭлемент.Значение, Параметры, Рекурсия, ПреобразовыватьДляJson, ЖурналПараметры, ПараметрыПакета, Колонки);
			текЗначение = Новый Структура("Name, Value", текЭлемент.Представление, текЭлементПреобразованный);
			НЗначение.Добавить(текЗначение);
		КонецЦикла;
		
		Результат.NoBasicValue_ = НЗначение;	
	ИначеЕсли ТипЗначения = Параметры.Типы.Дата Тогда
		Результат 	   = Новый Структура("NoBasicValue_, Type");
		Результат.Type = НайтиТип(Параметры, ТипЗначения);
        Результат.NoBasicValue_ = Значение;	
	ИначеЕсли ТипЗначения = Параметры.Типы.Соответствие Тогда
		Результат 	   = Новый Структура("NoBasicValue_, Type");
		Результат.Type = НайтиТип(Параметры, ТипЗначения);
        Результат.NoBasicValue_ = Новый Массив;
		
		Для Каждого текЭлемент Из Значение Цикл
			текКлючПреобразованный    = ПреобразоватьВБазовыеЗначения(текЭлемент.Ключ, Параметры, Рекурсия, ПреобразовыватьДляJson, ЖурналПараметры, ПараметрыПакета, Колонки);
			текЭлементПреобразованный = ПреобразоватьВБазовыеЗначения(текЭлемент.Значение, Параметры, Рекурсия, ПреобразовыватьДляJson, ЖурналПараметры, ПараметрыПакета, Колонки);
			текЗначПреобразованное    = Новый Структура("Key,value", текКлючПреобразованный, текЭлементПреобразованный);
			Результат.NoBasicValue_.Добавить(текЗначПреобразованное);
			Значение[текЭлемент.Ключ] = текЭлементПреобразованный; 
		КонецЦикла;
	ИначеЕсли ТипЗначения = Параметры.Типы.ТЗ Тогда
		ЕстьФайл = Ложь;
		// Проверим не хранит ли данная таблица в себе файл
		// Хранит если есть следующие поля: ТипХраненияФайла, ПутьКФайлу, Том 
		// Тогда добавляем реквизит _FileStorage_ в него в base64 кладем файл
		КолонкиСтруктура = КолонкиТЗВСтруктуру(Значение, ЕстьФайл);
		
		СтрокиСтруктура  = СтрокиТЗВМассив(Значение, КолонкиСтруктура, Параметры, Рекурсия, ПреобразовыватьДляJson, ЖурналПараметры, ПараметрыПакета, КолонкиСтруктура);
		Если НЕ ПреобразовыватьДляJson Тогда
			Результат = Значение;
		Иначе
			Результат 	   = Новый Структура("NoBasicValue_, Type");
			Результат.Type = НайтиТип(Параметры, ТипЗначения);
			
			Результат.NoBasicValue_ = Новый Структура("Column, Row",
			КолонкиСтруктура, СтрокиСтруктура);
		КонецЕсли;
	ИначеЕсли ТипЗначения = Параметры.Типы.ДД Тогда
		Если НЕ ПреобразовыватьДляJson Тогда
			Результат = Значение;
		Иначе
			Результат 	   = Новый Структура("NoBasicValue_, Type");
			Результат.Type = НайтиТип(Параметры, ТипЗначения);
			
			Результат.NoBasicValue_ = ПолучитьHexСтрокуИзДвоичныхДанных(Значение);
		КонецЕсли;
	ИначеЕсли ТипЗначения = Параметры.Типы.Хранилище Тогда
		Если НЕ ПреобразовыватьДляJson Тогда
			Результат = Значение;
		Иначе
			
			Результат 	   = Новый Структура("NoBasicValue_, Type");
			Результат.Type = НайтиТип(Параметры, ТипЗначения);
			текЭлемент	   = Значение.Получить();
			
			текЭлементПреобразованный = ПреобразоватьВБазовыеЗначения(текЭлемент, Параметры, Рекурсия,
										ПреобразовыватьДляJson, ЖурналПараметры, ПараметрыПакета, Колонки);
					 
			Результат.NoBasicValue_   = текЭлементПреобразованный;
		КонецЕсли;
	ИначеЕсли ТипЗначения = Параметры.Типы.ВидДвиженияНакопления Тогда
		Если НЕ ПреобразовыватьДляJson Тогда
			Результат = Значение;
		Иначе
			
			Результат 	   = Новый Структура("NoBasicValue_, Type");
			Результат.Type = НайтиТип(Параметры, ТипЗначения);
			Результат.NoBasicValue_   = Строка(Значение);
		КонецЕсли;			
	ИначеЕсли ТипЗначения = Параметры.Типы.ВидДвиженияБухгалтерии Тогда
		Если НЕ ПреобразовыватьДляJson Тогда
			Результат = Значение;
		Иначе
			Результат 	   = Новый Структура("NoBasicValue_, Type");
			Результат.Type = НайтиТип(Параметры, ТипЗначения);
			Результат.NoBasicValue_   = Строка(Значение);
		КонецЕсли;			
	Иначе
		//ссылки
		//в хранилище очень много чего можно упаковать, компоновку например,.. 
		//Параметры.Ссылки.Добавить(Значение);
		ЭтоСсылка = Ложь;
		Правило   = Неопределено;
		текТип    = НайтиТип(Параметры, ТипЗначения, ЭтоСсылка, Правило);
		Если ЭтоСсылка и НЕ Параметры.Настройка.ТолькоБазовые Тогда 
			Результат = Значение;
		Иначе
			//!!! ошибка должна упасть в общий лог
			текстБазовые = ?(Параметры.Настройка.ТолькоБазовые, нСтр("ru = 'Ожидались только базовые'"), "");
			КлючОбъекта  = "Объект неопределен.";
			Если ЗначениеЗаполнено(ПараметрыПакета.ВидОбъекта) Тогда
				КлючОбъекта = ПараметрыПакета.ТипОбъекта + ПараметрыПакета.ВидОбъекта;
			КонецЕсли;
			Результат    = нСтр("ru = '<<--ошибка преобразования: %1 %2-->>'");
			Результат	 = ПодставитьПараметрыВСтроку(Результат, КлючОбъекта, ТекстБазовые);
			
			Если ЖурналПараметры <> Неопределено Тогда
				ТекстСообщения = Результат;
				ЖурналЗапись(ЖурналПараметры, ТекстСообщения,, Истина);
			КонецЕсли;
		КонецЕсли;
		
		Если ПреобразовыватьДляJson Тогда
			Результат = Новый Структура("NoBasicValue_, Type");
			
			Результат.Type = текТип;
			Если ЭтоСсылка Тогда
				Если ОбщегоНазначенияБТС.ЭтоПеречисление(Значение.Метаданные()) Тогда
					Результат.NoBasicValue_  = ПолучитьИмяПеречисления(Значение);
				Иначе	
					Результат.NoBasicValue_ = Строка(Значение.УникальныйИдентификатор());
				КонецЕсли;
			Иначе
				Результат.NoBasicValue_ = нСтр("ru = '<<--ошибка преобразования-->>'");
				Если ЖурналПараметры <> Неопределено Тогда
					ТекстСообщения = Результат.NoBasicValue_;
					ЖурналЗапись(ЖурналПараметры, ТекстСообщения,, Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Функция - Получить дату json
//
// Параметры:
//  ТХТДата	 - 	 - Текст зависит от ВидДаты	 -
//  ВидДаты	 - 	 - Вид даты -
//  	JSON  2021-08-01T00:00:00
//  	EDI   01.08.2021T00:00:00 или 01.08.2021
//  	INFOR 20230209113751
// 
// Возвращаемое значение:
//   Результат - преобразованное в тип дата
//
Функция ПолучитьДатуJson(Знач ТХТДата, ВидДаты = "JSON") Экспорт
	Результат = Дата(1, 1, 1);
	
	ТХТДата   = СокрЛП(ТХТДата);
	
	Если Не ЗначениеЗаполнено(ТХТДата) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ВидДаты = "JSON" Тогда
		Год     = ПолучитьЧисло(Лев(ТХТДата, 4));
		Месяц   = ПолучитьЧисло(Сред(ТХТДата, 6, 2));
		День    = ПолучитьЧисло(Сред(ТХТДата, 9, 2));
		Час	    = ПолучитьЧисло(Сред(ТХТДата, 12, 2));
		Минута  = ПолучитьЧисло(Сред(ТХТДата, 15, 2));
		Секунда = ПолучитьЧисло(Сред(ТХТДата, 18, 2));
	ИначеЕсли ВидДаты = "EDI" 
			И (СтрДлина(ТХТДата) = 10
			ИЛИ СтрДлина(ТХТДата) = 19) Тогда
		День    = ПолучитьЧисло(Лев(ТХТДата,  2));
		Месяц   = ПолучитьЧисло(Сред(ТХТДата, 4, 2));
		Год     = ПолучитьЧисло(Сред(ТХТДата, 7, 4));
		Час	    = ПолучитьЧисло(Сред(ТХТДата, 12, 2));
		Минута  = ПолучитьЧисло(Сред(ТХТДата, 15, 2));
		Секунда = ПолучитьЧисло(Сред(ТХТДата, 18, 2));
	ИначеЕсли ВидДаты = "INFOR" Тогда
		День    = ПолучитьЧисло(Сред(ТХТДата, 7, 2));
		Месяц   = ПолучитьЧисло(Сред(ТХТДата, 5, 2));
		Год     = ПолучитьЧисло(Сред(ТХТДата, 1, 4));
		Час	    = ПолучитьЧисло(Сред(ТХТДата, 9, 2));
		Минута  = ПолучитьЧисло(Сред(ТХТДата, 11, 2));
		Секунда = ПолучитьЧисло(Сред(ТХТДата, 13, 2));
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Результат = Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Ошибка = ОписаниеОшибки();
		ЖурналЗаписьТолькОшибка(Ошибка);
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Функция - Получить число
//  Получает число из строки без знака минус
//
// Параметры:
//  Строка - Строка	 - 
// 
// Возвращаемое значение:
//  Результат - Число
//
Функция ПолучитьЧисло(Строка) Экспорт
	Результат = 0;
	
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеТипа = Новый ОписаниеТипов("Число");
	Результат 	 = ОписаниеТипа.ПривестиЗначение(Строка);
	
	Возврат Результат;
КонецФункции

// Записывает в журнал регистрации только сообщение об ошибке.
//
// Параметры:
//  ТекстОшибки - Строка - Текст ошибки, который требуется зафиксировать.
Процедура ЖурналЗаписьТолькОшибка(ТекстОшибки) Экспорт

	#Если Сервер Тогда
		ЗаписьЖурналаРегистрации(
			"Ошибка приложения",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки
		);
	#КонецЕсли

КонецПроцедуры

#КонецОбласти

#Область ЖурналРегистрацииЛоги

// Инициализирует структуру параметров журнала обмена.
//
// Параметры:
//  НастройкаОбмена - Произвольный - Настройка обмена или строка события журнала.
//  ВариантЗапуска - Строка - Вариант запуска обмена.
//  Действие - Строка - Действие, для которого формируется журнал.
//  ТекущаяДата - Дата - Текущая дата, если требуется задать явно.
//
// Возвращаемое значение:
//  Структура - Параметры журнала обмена.
Функция ЖурналИнициализация(НастройкаОбмена, ВариантЗапуска, Действие,  ТекущаяДата = Неопределено) Экспорт
	
	ПроцентВыполнения = ПроцентВыполненияИнициализация(2);//2 это шаг с которым выводится сообщение
	Если ТекущаяДата = Неопределено Тогда
		ТекущаяДата = ТекущаяДата();
	КонецЕсли;
	Если ТипЗнч(НастройкаОбмена) = Тип("Строка") Тогда
		СобытиеЖурнала			  = НастройкаОбмена;
		НастройкаОбменаМетаданные = "";
	Иначе
		СобытиеЖурнала 			  = ПолучитьКлючСообщенияЖурналаРегистрации(НастройкаОбмена, Действие);	
		НастройкаОбменаМетаданные = НастройкаОбмена.Метаданные();
	КонецЕсли;
	Результат 	   = Новый Структура("НастройкаОбмена, ДействиеПриОбмене, ДатаНачала, ДатаОкончания, 
		|СобытиеЖурнала, РезультатВыполненияОбмена, ВариантЗапуска, ПредыдущийЗапуск,
		|НастройкаОбменаМетаданные, ПроцентВыполнения", 
	НастройкаОбмена, Действие, ТекущаяДата, Дата(1,1,1), 
	СобытиеЖурнала,, ВариантЗапуска,,
	НастройкаОбменаМетаданные, ПроцентВыполнения);
	
	Возврат Результат;
КонецФункции


// Выполняет запись события обмена с последующим сохранением состояния обмена.
//
// Параметры:
//  Параметры - Структура - Параметры журнала обмена.
//  Описание - Строка - Текст события.
//  Завершено - Булево - Признак завершения действия.
//  Ошибка - Булево - Признак ошибки.
//  Вывести - Булево - Признак вывода в пользовательский интерфейс.
//  Сообщить - Булево - Признак вывода сообщения пользователю.
Процедура ЖурналСобытиеПоДействию(Параметры, Описание = "", Завершено = Ложь, Ошибка = Ложь, Вывести = Ложь, Сообщить = Ложь) Экспорт
	
	//Журнал
	ЖурналЗапись(Параметры, Описание, Завершено, Ошибка, Вывести, Сообщить);
	
	// Записываем состояния обмена в регистр
	Если Параметры = Неопределено Тогда Возврат; КонецЕсли;
	ЗаписьСостояния = РегистрыСведений.СостоянияОбменовДаннымиИнт.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(ЗаписьСостояния, Параметры);
	ЗаписьСостояния.Период = Параметры.ДатаНачала;
	ЗаписьСостояния.Записать();
	
	Если (Параметры.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.Выполнено
		ИЛИ Параметры.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.ВыполненоСПредупреждениями) Тогда
		ЗаписьУспешногоСостояния = РегистрыСведений.СостоянияУспешныхОбменовДаннымиИнт.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьУспешногоСостояния, ЗаписьСостояния);
		ЗаписьУспешногоСостояния.Записать();
	КонецЕсли;
	
КонецПроцедуры

// Добавляет запись в журнал регистрации и при необходимости выводит сообщение пользователю.
//
// Параметры:
//  Параметры - Структура - Параметры журнала обмена. Если Неопределено, будет создана минимальная структура.
//  Описание - Строка - Текст сообщения.
//  Завершено - Булево - Признак завершения операции.
//  Ошибка - Булево - Признак ошибки.
//  Вывести - Булево - Признак вывода в интерфейс.
//  Сообщить - Булево - Признак уведомления пользователя.
Процедура ЖурналЗапись(Параметры = Неопределено, Описание, Завершено = Ложь, 
						   Ошибка = Ложь, Вывести = Ложь, Сообщить = Ложь) Экспорт
	
	Если Параметры = Неопределено Тогда
		СобытиеЖурнала = ?(Ошибка, "Ошибка", "Информация");
		Параметры = ЖурналИнициализация(СобытиеЖурнала, , "");
	КонецЕсли;
	// Записываем информацию в журнал регистрации
	Если Завершено Тогда
		Параметры.ДатаОкончания = ТекущаяДата();
	КонецЕсли;
	
	// Записываем информацию в журнал регистрации
	ТекущаяДата 	  	 = ТекущаяДата();
	ВремяВыполнения 	 = 0;
	ВремяВыполненияЭтап  = 0;
	ВремяВыполненияТекст = "";
	ПредыдущийЗапуск 	 = Параметры.ПредыдущийЗапуск;
	
	Если ПредыдущийЗапуск = Неопределено Тогда
		ВремяВыполненияТекст = Формат(Параметры.ДатаНачала, "ДЛФ=T");
	Иначе
		ВремяВыполнения 	 = ТекущаяДата() - Параметры.ДатаНачала;
		ВремяВыполненияЭтап  = ТекущаяДата() - ПредыдущийЗапуск;
		ВремяВыполненияТекст = "" + Формат(ВремяВыполненияЭтап, "ЧГ=") + "\" + Формат(ВремяВыполнения, "ЧГ=");
		Если Завершено Тогда
			ВремяВыполненияТекст = Формат(Параметры.ДатаОкончания, "ДЛФ=T") + "\" + ВремяВыполненияТекст;
		КонецЕсли;
	КонецЕсли;
	
	Параметры.ПредыдущийЗапуск = ТекущаяДата;
	
	Если Ошибка Тогда
		УровеньЖурнала = УровеньЖурналаРегистрации.Ошибка;
	Иначе
		УровеньЖурнала = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	Текст = "Запуск: " + Параметры.ВариантЗапуска + "[" + ВремяВыполненияТекст + "]" + Символы.ПС + Описание;
	ЗаписьЖурналаРегистрации(
	Параметры.СобытиеЖурнала
	,УровеньЖурнала
	,Параметры.НастройкаОбменаМетаданные
	,Параметры.НастройкаОбмена
	,Текст);
	
	Если Вывести или Ошибка или Сообщить Тогда 
		Параметры.ПроцентВыполнения.Данные.Сообщение = Описание;
		Если Ошибка Тогда
			Сообщить = Истина;
		КонецЕсли;
		Если НЕ Параметры.ПроцентВыполнения.Выводить Тогда
			СообщитьПользователю(Описание);
		КонецЕсли;
		ВывестиПроцент(Параметры.ПроцентВыполнения, Истина, Сообщить);//
	КонецЕсли;
	
КонецПроцедуры

// Возвращает ключ сообщения журнала регистрации по строке действия
//
Функция ПолучитьКлючСообщенияЖурналаРегистрацииПоСтрокеДействия(НастройкаОбмена, ДействиеПриОбменеСтрокой) Экспорт
	
