// Возвращает ключ сообщения журнала регистрации
//
Функция ПолучитьКлючСообщенияЖурналаРегистрации(НастройкаОбмена, ДействиеПриОбмене) Экспорт
	
	КодУзлаПланаОбмена = СокрЛП(Всп_ОбщегоНазначения.ПолучитьЗначениеРеквизита(НастройкаОбмена, "Код"));
	
	КлючСообщения = НСтр("ru = 'Обмен данными код [КодУзла].[ДействиеПриОбмене]'");
	
	КлючСообщения = СтрЗаменить(КлючСообщения, "[КодУзла]",           КодУзлаПланаОбмена);
	КлючСообщения = СтрЗаменить(КлючСообщения, "[ДействиеПриОбмене]", ДействиеПриОбмене);
	
	Возврат КлючСообщения;
	
КонецФункции

// Возвращает структуру с данными отбора для журнала регистрации
//
Функция ПолучитьСтруктуруДанныхОтбораЖурналаРегистрации(НастройкаОбмена, Знач ДействиеПриОбмене, СостоянияОбменовДанными = Неопределено) Экспорт
	
	Если ТипЗнч(ДействиеПриОбмене) = Тип("Строка") Тогда
		
		ДействиеПриОбмене = Перечисления.ДействияПриОбмене[ДействиеПриОбмене];
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СостоянияОбменовДанными = СостоянияОбменовДанными(НастройкаОбмена, ДействиеПриОбмене);
	
	Отбор = Новый Структура;
	Отбор.Вставить("СобытиеЖурналаРегистрации", ПолучитьКлючСообщенияЖурналаРегистрации(НастройкаОбмена, ДействиеПриОбмене));
	Отбор.Вставить("ДатаНачала",                СостоянияОбменовДанными.ДатаНачала);
	Отбор.Вставить("ДатаОкончания",             СостоянияОбменовДанными.ДатаОкончания);
	
	Возврат Отбор;
КонецФункции

#КонецОбласти //ЖурналРегистрацииЛоги

функция ПолучитьСтруктуруИзСоответствия(Значение, Параметры = Неопределено, Рекурсия = Неопределено) 
	Результат = Новый Структура;
	
	Если Рекурсия = Неопределено Тогда
		Рекурсия = 0;
	Иначе
		Рекурсия = Рекурсия + 1;
	КонецЕсли;
	
	Если Рекурсия = 1000 Тогда
		Результат = Неопределено;
		Возврат Результат;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = СтруктураНастроекОбмена(,,Истина);
	КонецЕсли;
	
	Для Каждого текЭлемент Из Значение Цикл
		Если ТипЗнч(текЭлемент.Значение) = Параметры.Типы.Соответствие Тогда
			текЗначение = ПолучитьСтруктуруИзСоответствия(текЭлемент.Значение, Параметры, Рекурсия);
		ИначеЕсли ТипЗнч(текЭлемент.Значение) = Параметры.Типы.Массив Тогда
			текЗначение = Новый Массив;
		
			Для Каждого текЭлементМассива Из текЭлемент.Значение Цикл
				Если ТипЗнч(текЭлементМассива) = Параметры.Типы.Соответствие Тогда
					Промежуточный = ПолучитьСтруктуруИзСоответствия(текЭлементМассива, Параметры, Рекурсия);
				Иначе
					Промежуточный = текЭлементМассива;
				КонецЕсли;
				
				текЗначение.Добавить(Промежуточный);
			КонецЦикла;
		Иначе 
			текЗначение = текЭлемент.Значение;
		КонецЕсли;
		
		Результат.Вставить(текЭлемент.Ключ, текЗначение);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Выполняет обратное преобразование значения из сериализованного представления в объект 1С.
//
// Параметры:
//  Значение - Произвольный - Значение, полученное после JSON-десериализации.
//  Параметры - Структура - Параметры обмена и настроек преобразования.
//  Рекурсия - Число - Текущий уровень рекурсии.
//  ЖурналПараметры - Структура - Параметры журнала регистрации.
//  Колонки - Массив - Колонки таблицы значений при восстановлении.
//
// Возвращаемое значение:
//  Произвольный - Восстановленное значение.
Функция Десериализации(Значение, Параметры = Неопределено, Рекурсия = Неопределено, ЖурналПараметры = Неопределено, Колонки = Неопределено) Экспорт
	Результат = Неопределено;
	
	Если Рекурсия = Неопределено Тогда
		Рекурсия = 0;
	Иначе
		Рекурсия = Рекурсия + 1;
	КонецЕсли;
	
	Если Рекурсия = 1000 Тогда
		Результат = Неопределено;
		Возврат Результат;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = СтруктураНастроекОбмена(,,Истина);
	КонецЕсли;	
	
	ТипЗначения = ТипЗнч(Значение);
	Промежуточный = Неопределено;
	
	// Проверим на доп сериализаци
	ЭтоДопТип    = Ложь;
	времЗначение = Неопределено; 
	
	Если ТипЗначения = Параметры.Типы.Структура И Значение.Свойство("NoBasicValue_", Промежуточный) Тогда
		ЭтоДопТип    = Истина;
		времЗначение = Значение;
	ИначеЕсли ТипЗначения = Параметры.Типы.Соответствие И Не Значение["NoBasicValue_"] = Неопределено Тогда
		ЭтоДопТип 	 = Истина;
		времЗначение = ПолучитьСтруктуруИзСоответствия(Значение, Параметры);
	КонецЕсли;
	
	Если ЭтоДопТип Тогда
		Промежуточный = времЗначение.NoBasicValue_;
		ТипЗнчПром 	  = времЗначение.Type;
		ТипВид 		  = РазложитьСтрокуВМассивПодстрок(ТипЗнчПром, ".");
		
		// Ссылка
		Если ТипВид.Количество() > 1 Тогда
			Тип = ТипВид[0];
			Вид = ТипВид[1];
			
			МенеджерОбъекта = Неопределено;
			ЭтоПеречисление = Ложь;
			
			Если Тип = "ПланОбмена" Тогда
				МенеджерОбъекта = ПланыОбмена;
			ИначеЕсли Тип = "Справочник" Тогда
				МенеджерОбъекта = Справочники;
			ИначеЕсли Тип = "Документ" Тогда
				МенеджерОбъекта = Документы;
			ИначеЕсли Тип = "Перечисление" Тогда
				МенеджерОбъекта = Перечисления;
				ЭтоПеречисление = Истина;
			КонецЕсли;
			       
			Если Не МенеджерОбъекта = Неопределено И ЭтоПеречисление Тогда
				Если Промежуточный = "" Тогда
					Результат = МенеджерОбъекта[Вид].ПустаяСсылка();
				Иначе
					Результат = МенеджерОбъекта[Вид][Промежуточный];
				КонецЕсли;
			ИначеЕсли Не МенеджерОбъекта = Неопределено Тогда
				текУИД = Новый УникальныйИдентификатор(Промежуточный);
				Результат = МенеджерОбъекта[Вид].ПолучитьСсылку(текУИД);
			КонецЕсли;
		ИначеЕсли ТипЗнчПром = "Соответствие" Тогда	
			Результат = Новый Соответствие;
			
			Для Каждого текСтрока Из Промежуточный Цикл
				текКлюч     = Десериализации(текСтрока.key,   Параметры, Рекурсия, ЖурналПараметры, Колонки);
				текЗначение = Десериализации(текСтрока.value, Параметры, Рекурсия, ЖурналПараметры, Колонки);
				Результат.Вставить(текКлюч, текЗначение);
			КонецЦикла;
		ИначеЕсли ТипЗнчПром = "Таблица значений" Тогда
			Результат  = Всп_JSONСервер.ДесериализацииТаблица(Промежуточный, Параметры, Рекурсия, ЖурналПараметры, Колонки);
		ИначеЕсли ТипЗнчПром = "Список значений" Тогда	
			Результат = Новый СписокЗначений;
			
			Для Каждого текСтрока Из Промежуточный Цикл
				текЗначение = Десериализации(текСтрока.Value, Параметры, Рекурсия, ЖурналПараметры, Колонки);
				Результат.Добавить(текЗначение, текСтрока.Name);
			КонецЦикла;
		ИначеЕсли ТипЗнчПром = "StrExt" Тогда
			Результат = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Промежуточный));
		ИначеЕсли ТипЗнчПром = "Дата" Тогда
			Результат = ПолучитьДатуJson(Промежуточный);
		Иначе
		КонецЕсли;

	ИначеЕсли НЕ Параметры.Типы.Базовые.Найти(ТипЗначения) = Неопределено Тогда
		Результат = Значение;
	ИначеЕсли ТипЗначения = Параметры.Типы.Массив Тогда
		Результат = Новый Массив;
		
		Для Каждого текЗначение Из Значение Цикл
			Промежуточный = Десериализации(текЗначение, Параметры, Рекурсия, ЖурналПараметры, Колонки);
			Результат.Добавить(Промежуточный);
		КонецЦикла;
	ИначеЕсли ТипЗначения = Параметры.Типы.Структура Тогда
		// Проверим NoBasicValue_
		// Ссылка
		Результат = Новый Структура;
			
		Для Каждого текКлючЗначение Из Значение Цикл
			текЗначение = Десериализации(текКлючЗначение.Значение, Параметры, Рекурсия, ЖурналПараметры, Колонки);
			Результат.Вставить(текКлючЗначение.Ключ, текЗначение);
		КонецЦикла;
	
		// ТаблицаЗначений
	КонецЕсли;
	
	Рекурсия = Рекурсия - 1;
	
	Возврат Результат
КонецФункции

Функция СтруктураЗаменитьНедопустимыеСимволыXML(Структура) 
	Результат = Неопределено;	
	
	Если ТипЗнч(Структура) = Тип("Структура") Тогда
		Результат = Новый Структура;
		
		Для Каждого текКлючЗначение Из Структура Цикл
			текЗначение = СтруктураЗаменитьНедопустимыеСимволыXML(текКлючЗначение.Значение);
			Результат.Вставить(текКлючЗначение.Ключ, текЗначение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Структура) = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
		
		Для Каждого текКлючЗначение Из Структура Цикл
			текЗначение = СтруктураЗаменитьНедопустимыеСимволыXML(текКлючЗначение.Значение);
			Результат.Вставить(текКлючЗначение.Ключ, текЗначение);
		КонецЦикла;		
	ИначеЕсли ТипЗнч(Структура) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого текЗначение Из Структура Цикл
			Результат.Добавить(СтруктураЗаменитьНедопустимыеСимволыXML(текЗначение));
		КонецЦикла;
	ИначеЕсли ТипЗнч(Структура) = Тип("ТаблицаЗначений") Тогда
		Результат = Структура;
		
		Для Каждого текСтрока Из Структура Цикл
			Для Каждого текКолонка Из Структура Цикл
				текСтрока[текКолонка.Имя] = СтруктураЗаменитьНедопустимыеСимволыXML(текСтрока[текКолонка.Имя]);
			КонецЦикла;
		КонецЦикла;		
	ИначеЕсли ТипЗнч(Структура) = Тип("Строка") Тогда
		Результат = ЗаменитьНедопустимыеСимволыXML(Структура);	
	Иначе
		Результат = Структура;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЗаменитьНедопустимыеСимволыXML(Знач Текст)
	Результат = Текст;
    Позиция = НайтиНедопустимыеСимволыXML(Текст);
	
	Если Позиция Тогда
		Текст = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Текст));
		Результат = Новый Структура("NoBasicValue_,Type", Текст, "StrExt");
	КонецЕсли;
    
    Возврат Текст;
КонецФункции

