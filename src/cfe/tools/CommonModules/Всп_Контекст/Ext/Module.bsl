Функция КонтрольнаяЦифра(Строка)
	Сумма = 0;
	Длина = СтрДлина(Строка);
	Множитель = ?(Длина % 2 = 0, 1, 3);
	
	Для Позиция = 1 По Длина Цикл
		Сумма = Сумма + КодСимвола(Строка, Позиция) * Множитель;
		Множитель = ?(Множитель = 3, 1, 3);
	КонецЦикла;
	
	Возврат (10 - Сумма % 10) % 10;
КонецФункции

Функция КешШифра(ТипШифра)
	
	СтрокаОснование = "KQ7^JZ2!MP9_WB0@AH5)VT1+RC8#DL3*FN6=XE4%US(G$O&I-Y";
	
	КешШифра = Новый Массив;
	
	Для Позиция = 1 По СтрДлина(СтрокаОснование) Цикл
		КешШифра.Добавить(Сред(СтрокаОснование, Позиция, 1));
	КонецЦикла;
	
	Возврат КешШифра;
КонецФункции

Функция ПеревестиСистемуСчисления(СтрокаЧисла, ИсходныйАлфавит, НовыйАлфавит) Экспорт

	ИсходноеОснование = СтрДлина(ИсходныйАлфавит);
	НовоеОснование = СтрДлина(НовыйАлфавит);

	// Разряды результата: младший разряд находится первым.
	Разряды = Новый Массив;
	Разряды.Добавить(0);

	Для Позиция = 1 По СтрДлина(СтрокаЧисла) Цикл

		Символ = Сред(СтрокаЧисла, Позиция, 1);
		Цифра = Найти(ИсходныйАлфавит, Символ) - 1;

		Если Цифра < 0 Тогда
			ВызватьИсключение "Символ отсутствует в исходном алфавите: " + Символ;
		КонецЕсли;

		// Результат = Результат * ИсходноеОснование + Цифра.
		Перенос = Цифра;

		Для Индекс = 0 По Разряды.Количество() - 1 Цикл
			ЗначениеРазряда = Разряды[Индекс] * ИсходноеОснование + Перенос;
			Перенос = Цел(ЗначениеРазряда / НовоеОснование);
			Разряды[Индекс] = ЗначениеРазряда - Перенос * НовоеОснование;
		КонецЦикла;

		Пока Перенос > 0 Цикл
			Частное = Цел(Перенос / НовоеОснование);
			Разряды.Добавить(Перенос - Частное * НовоеОснование);
			Перенос = Частное;
		КонецЦикла;

	КонецЦикла;

	Результат = "";
	Индекс = Разряды.Количество() - 1;

	Пока Индекс >= 0 Цикл
		Результат = Результат + Сред(НовыйАлфавит, Разряды[Индекс] + 1, 1);
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СтруктураКонтекстаСохранение(Ключ = "", Представление = "", ТочкаИнтеграцииКлюч = "")
	СтруктураКонтекстаСохранение = Новый Структура;
	СтруктураКонтекстаСохранение.Вставить("Ключ", Ключ);
	СтруктураКонтекстаСохранение.Вставить("Представление", Представление);
	СтруктураКонтекстаСохранение.Вставить("ТочкаИнтеграцииКлюч", ТочкаИнтеграцииКлюч);
	СтруктураКонтекстаСохранение.Вставить("Переменные", Новый Массив);
	
	Возврат СтруктураКонтекстаСохранение;
КонецФункции

Функция СтруктураПеременныеСохранение(Ключ = "", Значение = "", Тип = "Строка")
	Возврат Новый Структура(
		"Ключ, Значение, Тип",
		Ключ,
		Значение,
		Тип);
КонецФункции

