#Область ПрограммныйИнтерфейс

// Собирает плоское соответствие переменных для заданного контура.
// Настройки подчиненного контекста переопределяют настройки точки интеграции.
//
// Параметры:
//  КлючТочкиИнтеграции    - Строка - Идентификатор элемента верхнего уровня (Точка интеграции)
//  КлючКонтекста		   - Строка - Идентификатор подчиненного элемента (Контекст выполнения). 
//
// Возвращаемое значение:
//  Соответствие Из Строка - Ключ и значение переменной (Строка, Число, Булево, 
//		Дата, Ссылка или Двоичные данные из Хранилища).
Функция Инициализация(КлючТочкиИнтеграции,  КлючКонтекста = "") Экспорт
	Перем Переменные, Запрос, ПакетЗапроса,
		  ТаблицаКонтекст, 	 ТаблицаТочкиИнтеграции,
		  ТекПеременная, ПеременнаяТочки;
		  
	Переменные = Новый Соответствие;
		
	Запрос = Новый Запрос(ЗапросКонтекст());
	Запрос.УстановитьПараметр("КлючТочкиИнтеграции", КлючТочкиИнтеграции);
	Запрос.УстановитьПараметр("КлючКонтекста", 		 КлючКонтекста);
	
	ПакетЗапроса 	  = Запрос.ВыполнитьПакет();
	ТаблицаКонтекст	  = ПакетЗапроса[1].Выгрузить();
	ТаблицаТочкиИнтеграции = ПакетЗапроса[0].Выгрузить();
	
	// Добавим переменные из Точки интеграции, они все подавляемые нижним уровнем
	Для Каждого ПеременнаяТочки Из ТаблицаТочкиИнтеграции Цикл
		Переменные.Вставить(ПеременнаяТочки.Ключ, ПолучитьЗначениеПеременной(ПеременнаяТочки));
	КонецЦикла;
		
	Для Каждого текПеременная Из ТаблицаКонтекст Цикл
		Если текПеременная.Ключ = Null Тогда
			Продолжить;
		КонецЕсли;
		
		Переменные.Вставить(ТекПеременная.Ключ, ПолучитьЗначениеПеременной(ТекПеременная));
	КонецЦикла;
		
	Возврат Переменные;
КонецФункции

// Собирает плоское соответствие переменных для заданного контура.
// Настройки подчиненного контекста переопределяют настройки точки интеграции.
//
// Параметры:
//  КлючТочкиИнтеграции    - Строка - Идентификатор элемента верхнего уровня (Точка интеграции)
//
// Возвращаемое значение:
//  Структура - Если КлючКонтекста пуст. Ключи структуры имена контекстов,
//		значения Соответствия с их переменными.
Функция ИнициализацияТочкиИнтеграции(КлючТочкиИнтеграции) Экспорт
	Перем Переменные, Контекст,
		  Запрос, ПакетЗапроса,
		  ТаблицаКонтекст, ТаблицаТочкиИнтеграции, ПредКонтекстКлюч,
		  ТекПеременная, ПеременнаяТочки;
		  
	Переменные = Новый Структура;
	Запрос = Новый Запрос(ЗапросКонтекст());
	Запрос.УстановитьПараметр("КлючТочкиИнтеграции", КлючТочкиИнтеграции);
	Запрос.УстановитьПараметр("КлючКонтекста", 		 "");
	
	ПакетЗапроса 	 	   = Запрос.ВыполнитьПакет();
	ТаблицаКонтекст		   = ПакетЗапроса[1].Выгрузить();
	ТаблицаТочкиИнтеграции = ПакетЗапроса[0].Выгрузить();
	
	ПредКонтекстКлюч = Неопределено;
		
	Для Каждого текПеременная Из ТаблицаКонтекст Цикл
		Если Не ПредКонтекстКлюч = текПеременная.КонтекстКлюч Тогда
			ПредКонтекстКлюч = текПеременная.КонтекстКлюч;
			Контекст 	 = Новый Соответствие;
			Контекст.Вставить("Ссылка", текПеременная.Ссылка);
			
			Переменные.Вставить(ПредКонтекстКлюч, Контекст);
						
			// Добавим переменные из Точки интеграции, они все подавляемые нижним уровнем
			Для Каждого ПеременнаяТочки Из ТаблицаТочкиИнтеграции Цикл
				Контекст.Вставить(
					ПеременнаяТочки.Ключ,
					ПолучитьЗначениеПеременной(ПеременнаяТочки));
			КонецЦикла;
		КонецЕсли;
		
		Если текПеременная.Ключ = Null Тогда
			Продолжить;
		КонецЕсли;
		
		Контекст.Вставить(текПеременная.Ключ, ПолучитьЗначениеПеременной(текПеременная));
	КонецЦикла;
		
	Возврат Переменные;
КонецФункции

Функция ОбновитьКонтекст(Контекст, КэшСсылок = Неопределено) Экспорт
	
	Если КэшСсылок = Неопределено Тогда
		КэшСсылок = Новый Структура("Справочники", ВспомогательныйКонтекст());
	КонецЕсли;
	
	СсылкаКонтекста = НайтиСсылку(Контекст.Ключ, КэшСсылок, "Справочники", "Всп_Контекст", "Ключ");
	
	Если ЗначениеЗаполнено(СсылкаКонтекста) Тогда
		КонтекстОбъект = СсылкаКонтекста.ПолучитьОбъект();
	Иначе
		КонтекстОбъект = Справочники.Всп_Контекст.СоздатьЭлемент();
		КонтекстОбъект.Наименование = Контекст.Представление;
		КонтекстОбъект.УстановитьНовыйКод();
		КонтекстОбъект.Ключ = Контекст.Ключ;
	КонецЕсли;
	
	ТочкаИнтеграции = Всп_ОбщегоНазначенияКлиентСервер.ПерейтиКЭлементу(
		"ТочкаИнтеграцииКлюч",
		Контекст);
	
	Если ЗначениеЗаполнено(ТочкаИнтеграции) Тогда
		КонтекстОбъект.Родитель = НайтиСсылку(
			Контекст.ТочкаИнтеграции.Ключ,
			КэшСсылок,
			"Справочники",
			"Всп_Контекст",
			"Ключ");
	КонецЕсли;
	
	КонтекстОбъект.Переменные.Очистить();
	
	Для Каждого ТекущаяПеременная Из Контекст.Переменные Цикл
		НоваяПеременная = КонтекстОбъект.Переменные.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяПеременная, ТекущаяПеременная);
		УстановитьЗначениеПеременной(
			НоваяПеременная, 
			ТекущаяПеременная.Значение,
			ТекущаяПеременная.Тип);
	КонецЦикла;
	
	КонтекстОбъект.Записать();
	
	КэшСсылок.Справочники.Всп_Контекст.Вставить(Контекст.Ключ, КонтекстОбъект.Ссылка); 
	
	Возврат КэшСсылок;
КонецФункции

Процедура СоздатьКонтекст(Контекст, СсылкаРодитель = Неопределено, ИмяКлюч) Экспорт
	НовыйКонтекст = Справочники.Всп_Контекст.СоздатьЭлемент();
	НовыйКонтекст.УстановитьНовыйКод();
	НовыйКонтекст.Наименование = ИмяКлюч;
	НовыйКонтекст.Ключ = ИмяКлюч;
    НовыйКонтекст.Родитель = СсылкаРодитель;
	НовыйКонтекст.Записать();
	
	ДанныеКонтекст = Новый Соответствие;
	ДанныеКонтекст.Вставить("Ссылка", НовыйКонтекст.Ссылка);
	Контекст.Вставить(ИмяКлюч, ДанныеКонтекст);

КонецПроцедуры

Функция ПрочитатьКонтекст(Контекст, ВключаяВложенные = Истина) Экспорт
	Перем ТекКонтекст,
		  Запрос, ПакетЗапроса,
		  ТаблицаКонтекст, ТаблицаТочкиИнтеграции, ПредКонтекстКлюч,
		  ТекПеременная, ТекПеременнаяТочки;
		  
	КлючТочкиИнтеграции = Всп_ОбщегоНазначения.ПолучитьЗначениеРеквизита(Контекст, "Ключ");
	
	МассивКонтекста = Новый Массив;
	ТекКонтекст = Новый Соответствие;
	Запрос = Новый Запрос(ЗапросКонтекст());
	Запрос.УстановитьПараметр("КлючТочкиИнтеграции", КлючТочкиИнтеграции);
	Запрос.УстановитьПараметр("КлючКонтекста", 		 "");
	
	ПакетЗапроса 	 	   = Запрос.ВыполнитьПакет();
	ТаблицаКонтекст		   = ПакетЗапроса[1].Выгрузить();
	ТаблицаТочкиИнтеграции = ПакетЗапроса[0].Выгрузить();
	
	ПредКонтекстКлюч = Неопределено;
		
	Для Каждого текПеременная Из ТаблицаКонтекст Цикл
		Если Не ПредКонтекстКлюч = текПеременная.КонтекстКлюч Тогда
			ПредКонтекстКлюч = текПеременная.КонтекстКлюч;
			ТекКонтекст 	 = СтруктураКонтекстаСохранение(
				ПредКонтекстКлюч, 
				текПеременная.КонтекстИмя, 
				ТекПеременная.ТочкаИнтеграцииКлюч);
				
			МассивКонтекста.Добавить(ТекКонтекст);
			
		КонецЕсли;
		
		Если текПеременная.Ключ = Null Тогда
			Продолжить;
		КонецЕсли;
		
		ТекПеременнаяДанные = СтруктураПеременныеСохранение(
			текПеременная.Ключ, 
			ПолучитьЗначениеПеременной(текПеременная),
			ПолучитьТипПеременной(текПеременная.Тип));
			
		ТекКонтекст.Переменные.Добавить(ТекПеременнаяДанные);
	КонецЦикла;
		
	МассивКонтекстаТекст = Всп_JSON.ЗаписьВСтроку(МассивКонтекста);
	
	Возврат МассивКонтекстаТекст;	
КонецФункции

Функция Зашифровать(Знач Строка) Экспорт
	Зашировано = "";
	ТипШифра = "1";
	
	Строка = СтрШаблон("%1%2", Строка, КонтрольнаяЦифра(Строка));
	
	СтрокаШифра = СтрШаблон("%1%2", ТипШифра, ШироватьПоТипу(Строка, ТипШифра));
	
	Возврат СтрокаШифра;
КонецФункции

Функция Расшифровать(Знач СтрокаШифр) Экспорт
	Строка = "";
	
	ТипШифра = Лев(СтрокаШифр, 1);
	Данные = РасшироватьПоТипу(Сред(СтрокаШифр, 2), ТипШифра);
	
	Контрольная = Прав(Данные, 1);
	
	Возврат Лев(Данные, СтрДлина(Данные) -1);
КонецФункции

Функция НайтиПоКлючу(Ключ) Экспорт
	Результат = Справочники.Всп_Контекст.НайтиПоРеквизиту("Ключ", Ключ);
	
	Возврат Результат;
КонецФункции	

// TODO Перебрать сборку из JSON и обновление переменной не должна сбрасывать остальные поля. 
//	Но установить признак булева это плюс
Процедура ОбновитьПеременные(Ключ, ИзмененныеПеременные) Экспорт
	КонтекстСсылка = НайтиПоКлючу(Ключ);
	
	Если Не ЗначениеЗаполнено(КонтекстСсылка) Тогда
		Контекст = Новый Соответствие;
		СоздатьКонтекст(Контекст, , Ключ);
		КонтекстСсылка = Контекст[Ключ]["Ссылка"];
	КонецЕсли;
	
	КонтекстОбъект = КонтекстСсылка.ПолучитьОбъект();
	
	ТекущиеПеременные = Новый Соответствие;
	
	Для Каждого ТекущаяПеременная Из КонтекстОбъект.Переменные Цикл
		ТекущиеПеременные.Вставить(
			ТекущаяПеременная.Ключ,
			ПолучитьЗначениеПеременной(ТекущаяПеременная));
	КонецЦикла;
	
	Для Каждого ТекущаяПеременная Из ИзмененныеПеременные Цикл
		ТекущиеПеременные.Вставить(ТекущаяПеременная.Ключ, ТекущаяПеременная.Значение);
	КонецЦикла;
	
	КонтекстОбъект.Переменные.Очистить();
	
	Для Каждого ТекущаяПеременная Из ТекущиеПеременные Цикл
		НоваяПеременная = КонтекстОбъект.Переменные.Добавить();
		НоваяПеременная.Ключ = ТекущаяПеременная.Ключ;
		УстановитьЗначениеПеременной(НоваяПеременная, ТекущаяПеременная.Значение);
	КонецЦикла;

	КонтекстОбъект.Записать();
	
КонецПроцедуры

Функция ОдноЗначение(КлюЗначения, КлючКонтекста) Экспорт
	Контекст = Инициализация(КлючКонтекста);
	
	Если Не ЗначениеЗаполнено(Контекст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Контекст[КлюЗначения];
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьЗначениеПеременной(СтрокаДанных)
	Если Не ЗначениеЗаполнено(СтрокаДанных.Тип) 
		Или СтрокаДанных.Тип = Перечисления.Всп_КонтекстТипыПеременных.Строка Тогда
		
		Возврат СтрокаДанных.ЗначениеСтрока;
	ИначеЕсли СтрокаДанных.Тип = Перечисления.Всп_КонтекстТипыПеременных.Число
		Или СтрокаДанных.Тип = Перечисления.Всп_КонтекстТипыПеременных.Булево 
		Или СтрокаДанных.Тип = Перечисления.Всп_КонтекстТипыПеременных.ДатаВремя Тогда
		
		Возврат СтрокаДанных.ЗначениеОстальное;
	ИначеЕсли СтрокаДанных.Тип = Перечисления.Всп_КонтекстТипыПеременных.Ссылка Тогда
		Возврат СтрокаДанных.Значение;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

Функция ПолучитьТипПеременной(ТипПеречисление)
	Если ЗначениеЗаполнено(ТипПеречисление) Тогда
		Возврат XMLСтрока(ТипПеречисление);
	КонецЕсли;
	
	Возврат "Строка";
КонецФункции

Процедура УстановитьЗначениеПеременной(СтрокаДанных, Значение, Тип = Неопределено)
	ТипЗначения = ТипЗнч(Значение);
	
	Если Тип = "Строка" Тогда
		СтрокаДанных.Тип = Перечисления.Всп_КонтекстТипыПеременных.Строка;
		СтрокаДанных.ЗначениеСтрока = Значение;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		СтрокаДанных.Тип = Перечисления.Всп_КонтекстТипыПеременных.Число;
		СтрокаДанных.ЗначениеОстальное = Значение;
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		СтрокаДанных.Тип = Перечисления.Всп_КонтекстТипыПеременных.Булево;
		СтрокаДанных.ЗначениеОстальное = Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		СтрокаДанных.Тип = Перечисления.Всп_КонтекстТипыПеременных.ДатаВремя;
		СтрокаДанных.ЗначениеОстальное = Значение;
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		СтрокаДанных.Тип = Перечисления.Всп_КонтекстТипыПеременных.Строка;
		СтрокаДанных.ЗначениеСтрока = Значение;
	КонецЕсли;
		
КонецПроцедуры

Функция ЗапросКонтекст()
	ТекстЗапроса = "ВЫБРАТЬ
	               |	КонтекстПеременные.Ключ КАК Ключ,
	               |	КонтекстПеременные.ЗначениеСтрока КАК ЗначениеСтрока,
				   |	КонтекстПеременные.Значение КАК Значение,
				   |	КонтекстПеременные.ЗначениеОстальное КАК ЗначениеОстальное,
				   |	КонтекстПеременные.Тип КАК Тип,
	               |	Контекст.Ссылка КАК ТочкаИнтеграции
	               |ИЗ
	               |	Справочник.Всп_Контекст КАК Контекст
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Всп_Контекст.Переменные КАК КонтекстПеременные
	               |		ПО Контекст.Ссылка = КонтекстПеременные.Ссылка
	               |ГДЕ
	               |	Контекст.Ключ = &КлючТочкиИнтеграции
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КонтекстПеременные.Ключ КАК Ключ,
	               |	КонтекстПеременные.ЗначениеСтрока КАК ЗначениеСтрока,
				   |	КонтекстПеременные.Значение КАК Значение,
				   |	КонтекстПеременные.ЗначениеОстальное КАК ЗначениеОстальное,
				   |	КонтекстПеременные.Тип КАК Тип,
	               |	Контекст.Ключ КАК КонтекстКлюч,
				   |	Контекст.Наименование КАК КонтекстИмя,
	               |	Контекст.Родитель КАК ТочкаИнтеграции,
				   |	ЕСТЬNULL(Контекст.Родитель.Ключ, """") КАК ТочкаИнтеграцииКлюч,
	               |	Контекст.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Всп_Контекст КАК Контекст
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Всп_Контекст.Переменные КАК КонтекстПеременные
	               |		ПО Контекст.Ссылка = КонтекстПеременные.Ссылка
	               |ГДЕ
	               |	(Контекст.Родитель.Ключ = &КлючТочкиИнтеграции
	               |			ИЛИ Контекст.Ключ = &КлючТочкиИнтеграции)
	               |	И (Контекст.Ключ = &КлючКонтекста
	               |			ИЛИ &КлючКонтекста = """")
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КонтекстКлюч";
		
	Возврат ТекстЗапроса;
КонецФункции

Функция НайтиСсылку(ПолеПоиска, КэшСсылок, Тип, Вид, Реквизит = Неопределено)
	
	КэшТип = Неопределено;
	КэшВид = Неопределено;
	Ссылка = Неопределено;
	
	Если КэшСсылок.Свойство(Тип, КэшТип)
		И КэшТип.Свойство(Вид, КэшВид) Тогда
		
		Ссылка = КэшВид[ПолеПоиска];
	КонецЕсли;
	
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Если КэшТип = Неопределено Тогда
		КэшВид = Новый Соответствие;
		КэшСсылок.Вставить(Тип, Новый Структура(Вид, КэшВид));
	ИначеЕсли КэшВид = Неопределено Тогда
		КэшВид = Новый Соответствие;
		КэшТип.Вставить(Вид, КэшВид);
	КонецЕсли;
	
	Если Реквизит = Неопределено Тогда
		Ссылка = Справочники[Вид].НайтиПоКоду(ПолеПоиска);
	Иначе
		Ссылка = Справочники[Вид].НайтиПоРеквизиту(Реквизит, ПолеПоиска);
	КонецЕсли;
	
	КэшВид.Вставить(ПолеПоиска, Ссылка);
	
	Возврат Ссылка;
КонецФункции

Функция РасшироватьПоТипу(СтрокаШифра, ТипШифра)
	Зашировано = "";
	
	КешШифра = КешШифра(ТипШифра);
	ИсходноеОснование = КешШифра.Длина();
	
	// Считаем что тут максимальный символ "№" (код 8470) но основание для упрощение берем 10000, 
	// Unicode может миллион + содержать
	НовоеОснование = 10000;
	
	Разряды = Новый Массив;
	Разряды.Добавить(0);
	
	Для Позиция = 1 По СтрДлина(СтрокаШифра) Цикл
		Цифра = КодСимвола(СтрокаШифра, Позиция);
		
		Перенос = Цифра;

		Для Индекс = 0 По Разряды.Количество() - 1 Цикл
			ЗначениеРазряда = Разряды[Индекс] * ИсходноеОснование + Перенос;
			Перенос = Цел(ЗначениеРазряда / НовоеОснование);
			Разряды[Индекс] = ЗначениеРазряда - Перенос * НовоеОснование;
		КонецЦикла;

		Пока Перенос > 0 Цикл
			Частное = Цел(Перенос / НовоеОснование);
			Разряды.Добавить(Перенос - Частное * НовоеОснование);
			Перенос = Частное;
		КонецЦикла;
	КонецЦикла;
	
	Результат = "";
	Индекс = Разряды.Количество() - 1;

	Пока Индекс >= 0 Цикл
		Зашировано = СтрШаблон("%1%2", Зашировано, КешШифра[Разряды[Индекс]]);
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Зашировано;
КонецФункции

