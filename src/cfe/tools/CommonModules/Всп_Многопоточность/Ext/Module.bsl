// Запуск сразу пока наполняется.

#Область ПрограммныйИнтерфейс

// Выполняет запуск задания на основании переданного вида задания.
// 
// Параметры:
//  ВидЗадания - СправочникСсылка.Всп_Контекст - Вид задания, который определяет логику запускаемого процесса.
//  Идентификатор - УникальныйИдентификатор, Неопределено - Уникальный идентификатор (УИД) конкретного задания 
//  	или порции данных.
//  УзелОбмена - ПланОбменаСсылка, Неопределено - Ссылка на любой узел плана обмена, в рамках которого 
//		выполняется задание.
Процедура ЗапускПоВидуЗадания(ВидЗадания, Идентификатор = Неопределено, УзелОбмена = Неопределено) Экспорт
	
	Если ТипЗнч(ВидЗадания) = Тип("Строка") Тогда
		ИДВидаЗадания = ВидЗадания;
	Иначе
		ИДВидаЗадания = Всп_ОбщегоНазначения.ПолучитьЗначениеРеквизита(ВидЗадания, "Ключ");
	КонецЕсли;
	
	Если ВидЗадания = Справочники.Всп_Контекст.ТестСозданиеУИД 
		Или ИДВидаЗадания  = "ТестСозданиеУИД" Тогда
		
		Всп_МногопоточностьТест.ЗапуститьСозданиеУИД(50000, Идентификатор);
	ИначеЕсли ИДВидаЗадания  = "ОбновитьСерииИзКаталога" Тогда
		УпаковкаДатаМатрикс.ЗапуститьОбновлениеСерии();
	КонецЕсли;
	
КонецПроцедуры

// Инициализирует настройки запуска многопоточных заданий и регистрирует состояние потока.
//
// Параметры:
//  Заголовок           - Строка - Строка с параметрами вида "Создание УИД %1", где первый параметр
//                                 это номер потока по порядку в имени регламентного задания.
//  ЭкспортнаяПроцедура - Строка - Путь к экспортной процедуре. Пример: "МногопоточностьТест.СоздатьУИД".
//  ВсегоЗаданий        - Число  - Количество потоков для запуска.
//  ВидЗадания          - СправочникСсылка.Всп_Контекст, Неопределено - Используется для визуализации
//                                 в регистрах текущего процесса.
//  Идентификатор       - УникальныйИдентификатор, Строка, Неопределено - Используется для поиска
//                                 в регистрах процессов. Если передан другой тип или Неопределено, 
//                                 будет сгенерирован новый УникальныйИдентификатор.
//  УзелОбмена          - ПланОбменаСсылка, Неопределено - Любой план обмена, используется для
//                                 визуализации в регистрах текущего процесса.
//
// Возвращаемое значение:
//  Структура - Настройки для контроля фоновых заданий со следующими свойствами:
//   * Идентификатор          - УникальныйИдентификатор, Строка, Неопределено - Уникальный идентификатор потока.
//   * ВремяПроверки          - Дата - Время инициализации настроек.
//   * ПериодОпросаЗавершения - Число - Секунды, период проверки завершения заданий.
//   * ПериодОпроса           - Число - Секунды, период для опроса состояния заданий.
//   * ЗавершитьПриОшибках    - Булево - Флаг завершения работы, если любой из процессов завершается ошибкой.
//   * ЗапускЗаданийЗаРаз     - Число - Количество одновременно запускаемых заданий.
//   * СразуЗапускать         - Булево - Флаг немедленного запуска заданий.
//   * ПаузаМеждуЗапуском     - Число - Пауза между запуском нового задания (в секундах).
//   * ЗапущеноЗаданий        - Число - Счетчик запущенных заданий.
//   * ЗавершеноЗаданий       - Число - Счетчик завершенных заданий.
//   * ВсегоЗаданий           - Число - Общее количество заданий для выполнения.
//   * ПараметрыЗаданий       - Массив из Произвольный - Набор параметров для запускаемых заданий.
//   * ЗаданияЗапущенные      - Массив из ФоновоеЗадание - Список запущенных фоновых заданий.
//   * ВидЗадания             - СправочникСсылка.Всп_Контекст, Неопределено - Вид выполняемого задания.
//   * ТекущееЗадание         - Число - Индекс текущего выполняемого задания.
//   * ТекстОшибки            - Строка - Текст сообщения об ошибке выполнения.
//   * ПоследнийЗапуск        - Дата, Неопределено - Дата и время последнего запуска задания.
//   * Ошибка                 - Булево - Флаг наличия ошибки выполнения.
//   * Остановлена            - Булево - Флаг принудительной остановки процесса.
//   * НомерПотока            - Число - Порядковый номер текущего потока.
//   * ПараметрыЗапуска       - Структура - Параметры инициализации со свойствами:
//       ** Заголовок           - Строка - Шаблон заголовка.
//       ** ЭкспортнаяПроцедура - Строка - Имя вызываемой процедуры.
//   * Журнал                 - Произвольный, Неопределено - Журнал регистрации событий процесса.
//@skip-check method-too-many-params
Функция Инициализация(Знач Заголовок, Знач ЭкспортнаяПроцедура, Знач ВсегоЗаданий = 0, 
		Знач ВидЗадания = Неопределено, Знач Идентификатор = Неопределено, Знач УзелОбмена = Неопределено) Экспорт
	
	Настройки = Новый Структура;
	
	Если Идентификатор = Неопределено Тогда
		Идентификатор = Новый УникальныйИдентификатор;
	ИначеЕсли ТипЗнч(Идентификатор) = Тип("Строка") Тогда
		Идентификатор = Новый УникальныйИдентификатор(Идентификатор);
	КонецЕсли;
	 
	Настройки.Вставить("Идентификатор", Идентификатор);
	Настройки.Вставить("ВремяПроверки", ТекущаяДатаСеанса()); 
	
	Настройки.Вставить("ПериодОпросаЗавершения",  5); // Секунды, проверки завершение заданий
	Настройки.Вставить("ПериодОпроса",  30); // Секунды, для опроса состояния заданий.
	Настройки.Вставить("ЗавершитьПриОшибках", Ложь); // Завершает если любой из процессов завершается ошибкой
	Настройки.Вставить("ЗапускЗаданийЗаРаз", 10); 
	Настройки.Вставить("СразуЗапускать", Ложь); 
	Настройки.Вставить("ПаузаМеждуЗапуском", 1); // Секунды между запуском нового задания
	Настройки.Вставить("ЗапущеноЗаданий", 0);
	Настройки.Вставить("ЗавершеноЗаданий", 0);
	Настройки.Вставить("ВсегоЗаданий", ВсегоЗаданий);
	Настройки.Вставить("ПараметрыЗаданий",  Новый Массив);
	Настройки.Вставить("ЗаданияЗапущенные", Новый Массив);
	Настройки.Вставить("ВидЗадания", ВидЗадания);
	
	Настройки.Вставить("ТекущееЗадание", 0);
	Настройки.Вставить("ТекстОшибки", "");
	Настройки.Вставить("ПоследнийЗапуск", Неопределено);
	Настройки.Вставить("Ошибка", Ложь);
	Настройки.Вставить("Остановлена", Ложь);
	Настройки.Вставить("НомерПотока", 0);
	
	
	ПараметрыЗапуска =  Новый Структура("Заголовок, ЭкспортнаяПроцедура", Заголовок, ЭкспортнаяПроцедура);
	Настройки.Вставить("ПараметрыЗапуска", ПараметрыЗапуска);
	
	Настройки.Вставить("Журнал", Журнал());
	
	СостояниеПотока = РегистрыСведений.Всп_СостоянияПотоков.СоздатьМенеджерЗаписи();
	СостояниеПотока.Идентификатор = Идентификатор;
	СостояниеПотока.УзелОбмена    = УзелОбмена;
	СостояниеПотока.ВидЗадания    = ВидЗадания;
	СостояниеПотока.Заданий		  = ВсегоЗаданий;
	СостояниеПотока.Выполнена     = Ложь;
	СостояниеПотока.ТекстОшибки   = "";
	СостояниеПотока.Ошибка 		  = Ложь;
	
	
	СостояниеПотока.Запуск = ТекущаяДатаСеанса();
	СостояниеПотока.Завершение = Дата(1, 1, 1);
	СостояниеПотока.ДатаАктивности = ТекущаяДатаСеанса();
	
	СостояниеПотока.Записать(Истина);
	
	Возврат Настройки;
КонецФункции

// Добавляет новый поток для выполнения и помещает его в очередь параметров заданий
// или запускает немедленно в зависимости от текущих настроек и доступности запуска.
//
// Параметры:
//  Потоки           - Структура - Настройки контроля и управления многопоточным выполнением, 
//                                 сформированные функцией Инициализация.
//  МассивПараметров - Массив из Произвольный - Параметры, которые будут переданы 
//                                              в запускаемую экспортную процедуру.
Процедура ДобавитьПоток(Потоки, МассивПараметров) Экспорт
	Потоки.НомерПотока = Потоки.НомерПотока + 1;
	МассивПараметров.Добавить(ПараметрыПотока(Потоки));
	
	Если Не Потоки.СразуЗапускать 
	 Или Не ДоступенЗапуск(Потоки) Тогда
		Потоки.ПараметрыЗаданий.Добавить(МассивПараметров);
	Иначе
		ЗапуститьПоток(Потоки, МассивПараметров);
	КонецЕсли;
	
КонецПроцедуры

// Ожидает завершения выполнения всех запущенных процессов.
// Ожидание происходит в цикле с паузой (определяется свойством ПериодОпроса, по умолчанию 5 секунд).
// По умолчанию, если любой из процессов завершается с ошибкой, ожидание прерывается.
//
// Параметры:
//  Потоки - Структура - Настройки контроля и управления многопоточным выполнением, 
//                       сформированные функцией Инициализация.
//
// Возвращаемое значение:
//  Булево - Истина, если все процессы завершились успешно; Ложь, если хотя бы один из процессов завершился с ошибкой.
Функция ДождатьсяВыполнения(Потоки) Экспорт
	
	Пока Не ЖдемВыполнения(Потоки) Цикл
		
	КонецЦикла;
	
	Возврат Не Потоки.Ошибка;
КонецФункции

// Выполняет разовую проверку необходимости запуска новых потоков из очереди 
// и ожидает завершения уже запущенных процессов (по умолчанию одновременно выполняется 10 потоков).
//
// Параметры:
//  Потоки - Структура - Настройки контроля и управления многопоточным выполнением, 
//                       сформированные функцией Инициализация.
//
// Возвращаемое значение:
//  Булево - Истина, если все задания успешно завершены; Ложь, если процессы еще выполняются.
Функция ЖдемВыполнения(Потоки) Экспорт
	ЗаданияВыполнены = Ложь;
	
	Для Ном = Потоки.ТекущееЗадание По Потоки.ПараметрыЗаданий.Количество() - 1 Цикл
		Если Не ДоступенЗапуск(Потоки) Тогда
			Прервать;
		КонецЕсли;
		
		Параметры = Потоки.ПараметрыЗаданий[Ном];
		ЗапуститьПоток(Потоки, Параметры);
		Потоки.ТекущееЗадание = Ном + 1;
	КонецЦикла;
	
	Если Потоки.ЗаданияЗапущенные.Количество() Тогда
		РезультатВыполнения = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(Потоки.ЗаданияЗапущенные, Потоки.ПериодОпроса);
		ЗаданияВыполнены = ЗаданияВыполнены(Потоки, РезультатВыполнения);
	Иначе
		ЗаданияВыполнены = Истина;
	КонецЕсли;
	
	Если ЗаданияВыполнены Тогда
		СохранитьРезультатВыполненияПотоков(Потоки);
	КонецЕсли;
	
	Возврат ЗаданияВыполнены;
КонецФункции

// Проверяет, требуется ли завершить выполнение текущего потока.
// Проверка выполняется с учетом заданного интервала опроса, наличия ошибок
// (если включена настройка завершения при ошибках), а также статусов успешного 
// выполнения или принудительной остановки процесса.
//
// Параметры:
//  ПараметрыПотока - Структура - Параметры и настройки текущего потока, 
//                                сформированные функцией ПараметрыПотока.
//
// Возвращаемое значение:
//  Булево - Истина, если выполнение потока необходимо завершить; Ложь, если поток должен продолжить работу.
Функция ПораЗавершатьПоток(ПараметрыПотока) Экспорт
	ЗавершитьПоток = Ложь;
	
	Если Не ПараметрыПотока.ВремяПроверки = Неопределено 
		И ПараметрыПотока.ВремяПроверки + ПараметрыПотока.ПериодОпроса > ТекущаяДатаСеанса() Тогда
		Возврат ЗавершитьПоток;
	КонецЕсли;
	
	Статус = СтатусПотока(ПараметрыПотока);
	
	ЗавершитьПоток = (ПараметрыПотока.ЗавершитьПриОшибках И Статус.Ошибка) Или Статус.Выполнен Или Статус.Остановлена;
	ПараметрыПотока.ВремяПроверки = ТекущаяДатаСеанса();
	
	Возврат ЗавершитьПоток;
КонецФункции

// Прерывает (останавливает) выполнение задания в подсистеме многопоточности по его идентификатору.
// 
// Параметры:
//  Идентификатор - УникальныйИдентификатор - Уникальный идентификатор (УИД) задания, которое необходимо остановить.
Процедура ОстановитьЗадание(Идентификатор) Экспорт
	
	СостояниеПотока = РегистрыСведений.Всп_СостоянияПотоков.СоздатьМенеджерЗаписи();
	СостояниеПотока.Идентификатор = Идентификатор;
	СостояниеПотока.Прочитать();
	СостояниеПотока.Остановлена = Истина;
	СостояниеПотока.Записать(Истина);
	
КонецПроцедуры

// Получает и возвращает текущие статусы выполнения заданий для указанного вида задания.
// Данные запрашиваются из подсистемы многопоточности.
// 
// Параметры:
//  ВидЗадания - СправочникСсылка.Всп_Контекст - Вид задания, для которого необходимо получить информацию о статусах.
// 
// Возвращаемое значение:
//  Произвольный - Данные о статусах заданий (например, структура, массив или таблица значений, в зависимости 
//  	от реализации подсистемы).
Функция ПолучитьСтатусыЗаданий(ВидЗадания) Экспорт
	СтатусыЗаданий = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияПотоков.Идентификатор КАК Идентификатор,
		|	СостоянияПотоков.Выполнена КАК Выполнена,
		|	СостоянияПотоков.Ошибка КАК Ошибка,
		|	СостоянияПотоков.Запуск КАК Запуск,
		|	СостоянияПотоков.Завершение КАК Завершение,
		|	СостоянияПотоков.Заданий КАК Заданий,
		|	СостоянияПотоков.Завершено КАК Завершено,
		|	СостоянияПотоков.ЗаданийСОшибками КАК ЗаданийСОшибками,
		|	СостоянияПотоков.ДатаАктивности КАК ДатаАктивности,
		|	СостоянияПотоков.Остановлена КАК Остановлена
		|ИЗ
		|	РегистрСведений.Всп_СостоянияПотоков КАК СостоянияПотоков
		|ГДЕ
		|	СостоянияПотоков.Идентификатор В(&ВидЗадания)";
	
	Запрос.УстановитьПараметр("ВидЗадания", ВидЗадания);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтатусЗадачи = СтруктураСтатуса(Выборка);
		СтатусыЗаданий.Вставить(Выборка.Идентификатор, СтатусЗадачи);
	КонецЦикла;
	
	Возврат СтатусыЗаданий;
КонецФункции

// Сохраняет результат выполнения потока.
//
// Параметры:
//  Результат       - Массив из Произвольный - Результат выполнения потока, который 
//                                                     будет сохранен в хранилище значения.
//  ПараметрыПотока - Структура - Параметры и настройки текущего потока.
Процедура СохранитьРезультат(Результат, ПараметрыПотока) Экспорт
	СостояниеПотока = РегистрыСведений.Всп_СохранненныеДанныеПотоков.СоздатьМенеджерЗаписи();
	СостояниеПотока.Идентификатор = ПараметрыПотока.Идентификатор;
	СостояниеПотока.НомерПотока   = ПараметрыПотока.НомерПотока;
	СостояниеПотока.Результат = Новый ХранилищеЗначения(Результат);
	СостояниеПотока.Записать(Истина);
КонецПроцедуры

// Получает результат выполнения потоков из регистра сведений "Всп_СостоянияПотоков".
// Извлекает данные из хранилища (поля "Результат") по указанному идентификатору. 
// Если сохраненное значение не является массивом (или отсутствует), гарантированно возвращает пустой массив.
// 
// Параметры:
//  Потоки - Структура, Произвольный - Объект данных (или структура), обязательно содержащий 
//                                     свойство "Идентификатор" для позиционирования в регистре сведений.
// 
// Возвращаемое значение:
//  Массив из Произвольный - Массив, содержащий извлеченные результаты выполнения потоков, 
//                           либо пустой массив, если данные не найдены или имеют другой тип.
Функция ПолучитьРезультатВыполненияПотоков(Потоки) Экспорт
	
	СостояниеПотока = РегистрыСведений.Всп_СостоянияПотоков.СоздатьМенеджерЗаписи();
	СостояниеПотока.Идентификатор = Потоки.Идентификатор;
	СостояниеПотока.Прочитать();
	Данные = СостояниеПотока.Результат.Получить();
	
	Если Не ТипЗнч(Данные) = Тип("Массив") Тогда
		Данные = Новый Массив;
	КонецЕсли;
	
	Возврат Данные;
КонецФункции
#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Инициализирует параметры потока. Формирует сокращенную структуру 
// от общей структуры настроек для использования в рамках конкретного потока.
//
// Параметры:
//  Потоки - Структура - Настройки контроля и управления многопоточным выполнением, 
//                       сформированные функцией Инициализация.
//
// Возвращаемое значение:
//  Структура - Параметры конкретного потока со следующими свойствами:
//   * Идентификатор       - УникальныйИдентификатор, Строка, Неопределено - Уникальный идентификатор процесса.
//   * НомерПотока         - Число - Порядковый номер текущего потока.
//   * ЗавершитьПриОшибках - Булево - Признак необходимости завершения при возникновении ошибки.
//   * ПериодОпроса        - Число - Интервал в секундах для опроса состояния.
//   * ВремяПроверки       - Дата, Неопределено - Дата и время последней проверки состояния потока.
Функция ПараметрыПотока(Потоки) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Идентификатор", Неопределено);
	Параметры.Вставить("НомерПотока", 0);
	Параметры.Вставить("ЗавершитьПриОшибках", Истина);
	Параметры.Вставить("ПериодОпроса", 5);
	
	ЗаполнитьЗначенияСвойств(Параметры, Потоки);
	
	Параметры.Вставить("ВремяПроверки", Неопределено);
	
	Возврат Параметры;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаданияВыполнены(Потоки, РезультатВыполнения)
	// Остановимся если надо останавливать потоки при любой ошибке
	// Уберем выполненные задания из выполняемых
	
	Завершено 	 = 0;
	НовыеОшибки  = 0;
	НеЗапущенных = 0;
	
	Для Каждого текЗадание Из РезультатВыполнения Цикл
		Если Не текЗадание.Состояние = СостояниеФоновогоЗадания.Активно	Тогда
			УдалитьЗаданиеПоКлючу(текЗадание.Ключ, Потоки.ЗаданияЗапущенные);
			Потоки.ЗапущеноЗаданий = Макс(0, Потоки.ЗапущеноЗаданий - 1);
			
			Если текЗадание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
				Завершено = Завершено + 1;	
			Иначе
				НовыеОшибки = НовыеОшибки + 1;
				Потоки.Ошибка = Истина;
				ПричинаОшибки = ПолучитьТекстОшибкиЗадания(текЗадание);
				Потоки.ТекстОшибки = СтрШаблон("%1%2%3", Потоки.ТекстОшибки, ?(Потоки.ТекстОшибки = "", "", Символы.ПС),
									ПричинаОшибки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если (Потоки.Остановлена Или (Потоки.ЗавершитьПриОшибках И Потоки.Ошибка))
			И Потоки.ПараметрыЗаданий.Количество() >= Потоки.ТекущееЗадание Тогда
		
		ТекущееЗадание = Потоки.ПараметрыЗаданий.Количество();
		
		Для НомерЗадания = - Потоки.ПараметрыЗаданий.Количество() + 1 По - Потоки.ТекущееЗадание Цикл
			Потоки.ПараметрыЗаданий.Удалить(-НомерЗадания);				
			НеЗапущенных = НеЗапущенных + 1; 
		КонецЦикла;
		
		Потоки.ТекущееЗадание = ТекущееЗадание + 1;
		Потоки.ТекстОшибки = СтрШаблон("%1%2 Не запущенных и остановленных: %3", Потоки.ТекстОшибки,
							?(Потоки.ТекстОшибки = "", "", Символы.ПС), НеЗапущенных);
							
		
	КонецЕсли;
	
	ЗаданияВыполнены = Потоки.ЗаданияЗапущенные.Количество() = 0 
			И Потоки.ТекущееЗадание >= Потоки.ПараметрыЗаданий.Количество();
			
	ОбновитьАктуальность = Потоки.ВремяПроверки + Потоки.ПериодОпроса < ТекущаяДатаСеанса();
	ОбновитьСтатусПотока = ЗаданияВыполнены Или НовыеОшибки Или Завершено Или НеЗапущенных Или ОбновитьАктуальность;
	
	Если ОбновитьСтатусПотока Тогда
		СостояниеПотока = РегистрыСведений.Всп_СостоянияПотоков.СоздатьМенеджерЗаписи();
		СостояниеПотока.Идентификатор = Потоки.Идентификатор;
		СостояниеПотока.Прочитать();
		
		Потоки.Остановлена = СостояниеПотока.Остановлена;
		
		СостояниеПотока.Ошибка = Потоки.Ошибка;
		СостояниеПотока.ТекстОшибки = Потоки.ТекстОшибки;
		СостояниеПотока.Выполнена = ЗаданияВыполнены;
		
		Если Не ЗначениеЗаполнено(СостояниеПотока.Завершение) 
		   И (ЗаданияВыполнены Или (Потоки.Ошибка И Потоки.ЗавершитьПриОшибках)) Тогда
			СостояниеПотока.Завершение = ТекущаяДатаСеанса();
		КонецЕсли;
		
		СостояниеПотока.Завершено  = СостояниеПотока.Завершено + Завершено;
		СостояниеПотока.ЗаданийСОшибками = СостояниеПотока.ЗаданийСОшибками + НовыеОшибки + НеЗапущенных;
		
		СостояниеПотока.ДатаАктивности = ТекущаяДатаСеанса();
		СостояниеПотока.Записать(Истина);
		
		Потоки.ВремяПроверки = ТекущаяДатаСеанса();
	КонецЕсли;
		
	Возврат ЗаданияВыполнены;
КонецФункции

Процедура СохранитьРезультатВыполненияПотоков(Потоки)
	Данные = ПолучитьДанныеВыполненияПотоков(Потоки.Идентификатор);
	
	СостояниеПотока = РегистрыСведений.Всп_СостоянияПотоков.СоздатьМенеджерЗаписи();
	СостояниеПотока.Идентификатор = Потоки.Идентификатор;
	СостояниеПотока.Прочитать();
	СостояниеПотока.Результат = Новый ХранилищеЗначения(Данные);
	СостояниеПотока.Записать(Истина);
	
	// Очистим промежуточные состояния
	СохранненныеДанныеПотоков = РегистрыСведений.Всп_СохранненныеДанныеПотоков.СоздатьНаборЗаписей();
	СохранненныеДанныеПотоков.Отбор.Идентификатор.Установить(Потоки.Идентификатор);
	СохранненныеДанныеПотоков.Записать(Истина);
	
КонецПроцедуры

Функция ДоступенЗапуск(Потоки)
	ДоступенЗапуск = Потоки.ЗапускЗаданийЗаРаз > Потоки.ЗапущеноЗаданий;
	
	Возврат ДоступенЗапуск;
КонецФункции

Функция ПолучитьТекстОшибкиЗадания(Задание)
	Ошибка = ?(Задание.ИнформацияОбОшибке = Неопределено, "", Задание.ИнформацияОбОшибке.Описание);
	
	Возврат СтрШаблон("%1: %2%3 %4", Задание.Наименование, Задание.Состояние, 
						?(Ошибка = "", ".", "\ "), Ошибка);
КонецФункции

Процедура УдалитьЗаданиеПоКлючу(Ключ, ЗаданияЗапущенные)
	
	Для НомерЗадания = 0 По ЗаданияЗапущенные.Количество() Цикл
		Если ЗаданияЗапущенные[НомерЗадания].Ключ = Ключ Тогда
			ЗаданияЗапущенные.Удалить(НомерЗадания);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция СтруктураСтатуса(Данные)
	СтатусЗадачи = Новый Структура;
	СтатусЗадачи.Вставить("Выполнена");
	СтатусЗадачи.Вставить("Ошибка");
	СтатусЗадачи.Вставить("Запуск");
	СтатусЗадачи.Вставить("Завершение");
	СтатусЗадачи.Вставить("Заданий");
	СтатусЗадачи.Вставить("Завершено");
	СтатусЗадачи.Вставить("ЗаданийСОшибками");
	СтатусЗадачи.Вставить("ДатаАктивности");
	СтатусЗадачи.Вставить("Остановлена");
	
	
	ЗаполнитьЗначенияСвойств(СтатусЗадачи, Данные);
	
	Возврат СтатусЗадачи;
КонецФункции

Функция ПолучитьДанныеВыполненияПотоков(Идентификатор)
	Данные = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СохранненныеДанныеПотоков.Результат КАК Результат,
		|	СохранненныеДанныеПотоков.НомерПотока КАК НомерПотока
		|ИЗ
		|	РегистрСведений.Всп_СохранненныеДанныеПотоков КАК СохранненныеДанныеПотоков
		|ГДЕ
		|	СохранненныеДанныеПотоков.Идентификатор = &Идентификатор
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерПотока";
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		РезультатПотока = Выборка.Результат.Получить();
		
		Если Не ТипЗнч(РезультатПотока) = Тип("Массив") Тогда
			Данные.Добавить(РезультатПотока);
			
			Продолжить;
		КонецЕсли;
		
		Для Каждого ТекущийЭлемент Из РезультатПотока Цикл
			Данные.Добавить(ТекущийЭлемент);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Данные;
КонецФункции

#Область Поток

Процедура ЗапуститьПоток(Потоки, МассивПараметров)
	
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если Не Потоки.ПоследнийЗапуск = Неопределено 
	 И Сейчас - Потоки.ПаузаМеждуЗапуском * 1000 < Потоки.ПоследнийЗапуск Тогда
		Пауза(Потоки.ПаузаМеждуЗапуском);
	КонецЕсли;
	
	Потоки.ПоследнийЗапуск = Сейчас;
	
	КлючПотока = Новый УникальныйИдентификатор;
	
	НовыйПоток = ФоновыеЗадания.Выполнить(Потоки.ПараметрыЗапуска.ЭкспортнаяПроцедура, МассивПараметров, 
			КлючПотока, СтрШаблон(Потоки.ПараметрыЗапуска.Заголовок, Потоки.НомерПотока));
			
	Потоки.ЗапущеноЗаданий = Потоки.ЗапущеноЗаданий + 1;
	Потоки.ЗаданияЗапущенные.Добавить(НовыйПоток);
КонецПроцедуры

Функция СтатусПотока(Поток)
	Статус = Новый Структура("Выполнен, Ошибка, Остановлена", Ложь, Ложь, Ложь);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификатор", Поток.Идентификатор);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияПотоков.Идентификатор КАК Идентификатор,
		|	СостоянияПотоков.Ошибка КАК Ошибка,
		|	СостоянияПотоков.Остановлена КАК Остановлена,
		|	СостоянияПотоков.Выполнена КАК Выполнена,
		|	СостоянияПотоков.ДатаАктивности КАК ДатаАктивности
		|ИЗ
		|	РегистрСведений.Всп_СостоянияПотоков КАК СостоянияПотоков
		|ГДЕ
		|	СостоянияПотоков.Идентификатор = &Идентификатор";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Статус, Выборка);
		
		Статус.Ошибка = Статус.Ошибка Или Выборка.ДатаАктивности + 2 * Поток.ПериодОпроса < ТекущаяДатаСеанса();
		
	Иначе
		Статус.Выполнен = Истина;	
	КонецЕсли;
	
    Возврат Статус;
КонецФункции

#КонецОбласти

#Область Вспомогательные

Процедура Пауза(Задержка = 1, ВремяВМиллисекундах = Ложь) Экспорт

	Время = ?(ВремяВМиллисекундах, 1, 1000) * Задержка;
	// организация пауз
	СтрокаЗапроса = "ping -n 1 -w " + Формат(Время, "ЧГ=0") + " 127.255.255.255"; 
	
	Попытка
		WshShell = Новый COMОбъект("WScript.Shell"); 
		WshShell.Run(СтрокаЗапроса, 0, -1);
	Исключение
		Ошибка = ОписаниеОшибки();
		Всп_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Ошибка);
	КонецПопытки;

КонецПроцедуры // Пауза()

#КонецОбласти

