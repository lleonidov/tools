// Сериализует переданное значение в строку формата JSON.
//
// Параметры:
//  Значение - Произвольный - Значение для записи в формате JSON. Поддерживаются любые типы,
//             доступные для сериализации (в том числе Массив из Произвольный).
//
// Возвращаемое значение:
//  Строка - Строковое представление переданного значения.
Функция ЗаписьВСтроку(Значение) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	ЗначениеСтрока = ЗаписьJSON.Закрыть();
	
	Возврат ЗначениеСтрока;
КонецФункции

// Функция - Чтение из строки JSON
//
// Параметры:
//  СтрокаJSON				 - Строка - Данные
//  ПрочитатьВСоответствие	 - Булево - чтение в соответсвтие
//  ПроверятьСимволы		 - Булево - удаляем недопустимые символы для XML сериализации
//  СтрокаДата				 - Булево - Все строковые значения проверяем на дату по шаблону 2022-06-21T16:12:23
// 
// Возвращаемое значение:
//  Произвольный - В основном в обмене передаются структуры, массивы, но иногда даты, ссылки,...
//
Функция ЧтениеИзСтрокиJSON(СтрокаJSON, ПрочитатьВСоответствие = Ложь,
			ПроверятьСимволы = Ложь, СтрокаДата = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		СтрокаJSON = """""";
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Структура  = ПрочитатьJSON(ЧтениеJSON, ПрочитатьВСоответствие);	
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Структура;	
КонецФункции

// Функция - Получить дату json
//
// Параметры:
//  ТХТДата	 - 	 - Текст зависит от ВидДаты	 -
//  ВидДаты	 - 	 - Вид даты -
//  	JSON  2021-08-01T00:00:00
//  	EDI   01.08.2021T00:00:00 или 01.08.2021
//  	INFOR 20230209113751
// 
// Возвращаемое значение:
//   Результат - преобразованное в тип дата
//
Функция ПолучитьДатуJson(Знач ТХТДата, ВидДаты = "JSON") Экспорт
	Результат = Дата(1, 1, 1);
	
	ТХТДата   = СокрЛП(ТХТДата);
	
	Если Не ЗначениеЗаполнено(ТХТДата) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ВидДаты = "JSON" Тогда
		Год     = ПолучитьЧисло(Лев(ТХТДата, 4));
		Месяц   = ПолучитьЧисло(Сред(ТХТДата, 6, 2));
		День    = ПолучитьЧисло(Сред(ТХТДата, 9, 2));
		Час	    = ПолучитьЧисло(Сред(ТХТДата, 12, 2));
		Минута  = ПолучитьЧисло(Сред(ТХТДата, 15, 2));
		Секунда = ПолучитьЧисло(Сред(ТХТДата, 18, 2));
	ИначеЕсли ВидДаты = "EDI" 
			И (СтрДлина(ТХТДата) = 10
			ИЛИ СтрДлина(ТХТДата) = 19) Тогда
		День    = ПолучитьЧисло(Лев(ТХТДата,  2));
		Месяц   = ПолучитьЧисло(Сред(ТХТДата, 4, 2));
		Год     = ПолучитьЧисло(Сред(ТХТДата, 7, 4));
		Час	    = ПолучитьЧисло(Сред(ТХТДата, 12, 2));
		Минута  = ПолучитьЧисло(Сред(ТХТДата, 15, 2));
		Секунда = ПолучитьЧисло(Сред(ТХТДата, 18, 2));
	ИначеЕсли ВидДаты = "INFOR" Тогда
		День    = ПолучитьЧисло(Сред(ТХТДата, 7, 2));
		Месяц   = ПолучитьЧисло(Сред(ТХТДата, 5, 2));
		Год     = ПолучитьЧисло(Сред(ТХТДата, 1, 4));
		Час	    = ПолучитьЧисло(Сред(ТХТДата, 9, 2));
		Минута  = ПолучитьЧисло(Сред(ТХТДата, 11, 2));
		Секунда = ПолучитьЧисло(Сред(ТХТДата, 13, 2));
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Результат = Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Ошибка = ОписаниеОшибки();
		ЖурналЗапись(Ошибка);
	КонецПопытки;

	Возврат Результат;
КонецФункции

// Функция - Получить число
//  Получает число из строки без знака минус
//
// Параметры:
//  Строка - Строка	 - 
// 
// Возвращаемое значение:
//  Результат - Число
//
Функция ПолучитьЧисло(Строка) Экспорт
	Результат = 0;
	
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеТипа = Новый ОписаниеТипов("Число");
	Результат 	 = ОписаниеТипа.ПривестиЗначение(Строка);
	
	Возврат Результат;
КонецФункции

Процедура ЖурналЗапись(ТекстОшибки) Экспорт

	#Если Сервер Тогда
		ЗаписьЖурналаРегистрации(
			"Ошибка приложения",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки
		);
	#КонецЕсли

КонецПроцедуры

