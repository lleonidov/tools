КонецФункции

Процедура ДобавитьОшибку(ТекстОшибки, КэшОбмена) Экспорт
	Если КэшОбмена.Лог = Неопределено Тогда
		Лог = Обработки.Всп_Лог.НовыйЛог("БрокерСообщений", КэшОбмена["Сервис"], , КэшОбмена["Уровень"]);
		Лог.ДобавитьСпособЛогированияЖурналРегистрации();
		КэшОбмена.Лог = Лог;
		
		Если Не КэшОбмена.МолчаливыйРежим Тогда
			КэшОбмена.Лог.ДобавитьСпособЛогированияКонсоль();
		КонецЕсли;
	КонецЕсли;
	
	КэшОбмена.Лог.Ошибка(ТекстОшибки);
	
КонецПроцедуры

Процедура ВыводитьСообщенияВКонсоль(КэшОбмена) Экспорт
	Если КэшОбмена.Лог = Неопределено Тогда
		Лог = Обработки.Всп_Лог.НовыйЛог("БрокерСообщений", КэшОбмена["Сервис"], , КэшОбмена["Уровень"]);
		Лог.ДобавитьСпособЛогированияЖурналРегистрации();
		КэшОбмена.Лог = Лог;
	КонецЕсли;
	
	КэшОбмена.Лог.ДобавитьСпособЛогированияКонсоль();
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиОчереди(Обмен, КонтекстБрокера, Сервис, МолчаливыйРежим)
	// TODO добавить и прочитать свойство Остановлен из контекста
	
	// Все настройки подключения в любой из очередей
	// TODO подумать нужно ли мне для подобных случаев деление на настройки верхнего уровня и настройки очереди.
	
	ПерваяОчередь = Истина;
	
	Обмен.Сервис = Всп_ОбщегоНазначенияКлиентСервер.ПерейтиКЭлементу( СтрШаблон("%1.Ссылка", Сервис), КонтекстБрокера);
	Обмен.МолчаливыйРежим = МолчаливыйРежим;
	
	Для Каждого ОчередьЭлемент Из КонтекстБрокера Цикл
		Если ОчередьЭлемент.Ключ = Сервис Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущаяОчередь = ОчередьЭлемент.Значение;
		
		Если ПерваяОчередь Тогда
			Обмен.АдресСервера = ТекущаяОчередь["АдресСервера"];
			Обмен.Порт = ТекущаяОчередь["Порт"];
			Обмен.Аутентификация.Вставить("Логин", ТекущаяОчередь["Логин"]);
			Обмен.Аутентификация.Вставить("Пароль", ТекущаяОчередь["Пароль"]);
			Обмен.Таймаут = ТекущаяОчередь["Таймаут"];
			Обмен.ВиртуальныйХост = ТекущаяОчередь["ВиртуальныйХост"]; // TODO продумать может это поле только для rabbit MQ
			Обмен.Используется = Истина;
			ПерваяОчередь = Ложь;
		КонецЕсли;
		
		ИдКлиента = ТекущаяОчередь["ИдКлиента"];
		ИдКлиента = ?(ЗначениеЗаполнено(ИдКлиента), ИдКлиента, "");
		
		ТекущаяОчередь["Очередь"] = СтрЗаменить(ТекущаяОчередь["Очередь"], "{ИдКлиента}", ИдКлиента);
		ДанныеОчереди = Новый Структура;
		ДанныеОчереди.Вставить("ИмяОчереди", ТекущаяОчередь["Очередь"]);
		ДанныеОчереди.Вставить("СообщенияЗаРаз", ТекущаяОчередь["СообщенияЗаРаз"]);
		ДанныеОчереди.Вставить("Поток", Ложь);
		
		Обмен.Поиск.Вставить(ОчередьЭлемент.Ключ, ДанныеОчереди);
		
	КонецЦикла;
КонецПроцедуры

Функция СтруктураСообщения()
	Возврат Новый Структура("СообщениеНомер, Сообщение", 0, "");
КонецФункции