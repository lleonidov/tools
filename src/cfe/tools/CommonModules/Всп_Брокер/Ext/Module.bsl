// План на брокер
// Рэббит, кафка, регистры сведений
Функция ОтправитьСообщение(Сообщение, ОчередьИмя, КэшОбмена) Экспорт
	Результат = Ложь;
	Очередь   = ПолучитьОчередь(ОчередьИмя, КэшОбмена);
	Транспорт = ПолучитьТранспорт(КэшОбмена.Транспорт, КэшОбмена.Прокси1с);
	
	Если Транспорт = Неопределено 
		Или Очередь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Транспорт.ОтправитьСообщение(КэшОбмена, Очередь, Сообщение);
	
	Возврат Результат;
КонецФункции

Функция ПолучитьСообщение(ОчередьИмя, КэшОбмена, Сообщение = "", СообщениеНомер = 0) Экспорт
	Результат = Ложь;
	Очередь   = ПолучитьОчередь(ОчередьИмя, КэшОбмена);
	Транспорт = ПолучитьТранспорт(КэшОбмена.Транспорт, КэшОбмена.Прокси1с);
	
	Если Транспорт = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// todo добавить концепт быстрого переключения между очередями КэшОбмена.КлиентОбмена.ТекущаяОчередь 
	
	Результат = Транспорт.ПолучитьСообщение(КэшОбмена, ОчередьИмя, Сообщение, СообщениеНомер);
	
	КэшОбмена.Сообщение	     = Сообщение;
	КэшОбмена.СообщениеНомер = СообщениеНомер;
	
	Возврат Результат;

КонецФункции

// TODO доделать
Функция ПолучитьСообщенияПачкой(ОчередьИмя, КэшОбмена) Экспорт
	ДанныеОчереди   = ДанныеОчереди(ОчередьИмя, КэшОбмена);
	Транспорт = ПолучитьТранспорт(КэшОбмена.Транспорт, КэшОбмена.Прокси1с);
	
	Если Транспорт = Неопределено Или ДанныеОчереди = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КэшОбмена.СообщенияПачка = Новый Массив;
	
	СообщенияЗаРаз = ДанныеОчереди.СообщенияЗаРаз;
	
	Для Ном = 1 По СообщенияЗаРаз Цикл
		СтруктураСообщения = СтруктураСообщения();
		
		Результат = Транспорт.ПолучитьСообщение(
			КэшОбмена, 
			ОчередьИмя, 
			СтруктураСообщения.Сообщение, 
			СтруктураСообщения.СообщениеНомер);
		
		Если Не Результат Тогда
			Возврат КэшОбмена.СообщенияПачка.Количество();
		КонецЕсли;
		
		КэшОбмена.СообщенияПачка.Добавить(СтруктураСообщения);
	КонецЦикла;
	
	Возврат КэшОбмена.СообщенияПачка.Количество();
КонецФункции

Функция ПодтвердитьСообщение(КэшОбмена, СообщениеНомер = Неопределено) Экспорт
	Результат = Ложь;
	Транспорт = ПолучитьТранспорт(КэшОбмена.Транспорт, КэшОбмена.Прокси1с);
	
	Если Транспорт = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СообщениеНомер = Неопределено Тогда
		СообщениеНомер = КэшОбмена.СообщениеНомер;
	КонецЕсли;
	
	Очередь   = КэшОбмена.ТекущаяОчередь;
	Результат = Транспорт.ПодтвердитьСообщение(КэшОбмена, СообщениеНомер);
	
	Возврат Результат;
КонецФункции

// Функция - Подтвердить все захваченные сообщения
//	Подтверждаем все захваченные в этой сессии сообщения по указанные номер.
// Параметры:
//  Подключение			 - 	Структура - Настройки подключения
//  ПоследнееСообщение	 - Число - Номер захваченного сообщения до которого включительно будут подтверждено.
// 
// Возвращаемое значение:
//  Булево - Успех подтверждения
//
Функция ПодтвердитьВсеЗахваченныеСообщения(ПоследнееСообщение, КэшОбмена) Экспорт
	Результат = Ложь;
	
	Транспорт = ПолучитьТранспорт(КэшОбмена.Транспорт, КэшОбмена.Прокси1с);
	
	Если Транспорт = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НомераСобщений = Новый Массив;
	УдалитьИзПула  = Новый Массив;
	
	СообщенияПачка = КэшОбмена.СообщенияПачка;
	
	Если СообщенияПачка.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПоследнийНомер = СообщенияПачка[СообщенияПачка.Количество() - 1].СообщениеНомер;
	
	Результат = Транспорт.ПодтвердитьВсеЗахваченныеСообщения(КэшОбмена, ПоследнийНомер);
	
	Если Результат Тогда
		КэшОбмена.СообщенияПачка = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ОтказОтСообщения(КэшОбмена, СообщениеНомер) Экспорт
	Результат = Ложь;
	Транспорт = ПолучитьТранспорт(КэшОбмена.Транспорт, КэшОбмена.Прокси1с);
	
	Если Транспорт = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Транспорт.ОтказОтСообщения(КэшОбмена, СообщениеНомер);

	Возврат Результат;
КонецФункции

// МолчаливыйРежим - если включен то запись ошибко только в журнал, иначе вывод в консоль
Функция Подключиться(Сервис, МолчаливыйРежим = Истина) Экспорт
	
	КонтекстБрокера = Всп_Контекст.ИнициализацияТочкиИнтеграции(Сервис);
	Обмен = СтруктураПараметров();
	
	ЗаполнитьНастройкиОчереди(Обмен, КонтекстБрокера, Сервис, МолчаливыйРежим);
		
	Транспорт = ПолучитьТранспорт(Обмен.Транспорт, Обмен.Прокси1с);
	
	Если Транспорт = Неопределено Тогда
		Обмен.Используется = Ложь;
		
		Возврат Обмен;
	КонецЕсли;
	
	Обмен = Транспорт.Подключиться(Сервис, Обмен);
	
	Возврат Обмен;
КонецФункции

Процедура Отключиться(Обмен) Экспорт
	
	Транспорт = ПолучитьТранспорт(Обмен.Транспорт, Обмен.Прокси1с);
	
	Если Транспорт = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Обмен.Лог = Неопределено Тогда
		Обмен.Лог.ЗавершитьЛогирование();
		Обмен.Лог = Неопределено;
	КонецЕсли;
	
	Транспорт.Отключиться(Обмен);
	
КонецПроцедуры

Функция ПолучитьТранспорт(ТранспортВид, Прокси1с = Неопределено)
	
	Транспорт = Неопределено;
	
	Если Не ЗначениеЗаполнено(ТранспортВид) 
		Или ТранспортВид = Перечисления.Всп_ТранспортыСообщений.RabbitMQPink Тогда
		
		Транспорт = Всп_RabbitMQPink;
	ИначеЕсли ТранспортВид = Перечисления.Всп_ТранспортыСообщений.ОчередьНаРегистрах Тогда
		Транспорт = Всп_ОчередьНаРегистрах;
	КонецЕсли;
	
	Возврат Транспорт;
КонецФункции

Функция ДанныеОчереди(ОчередьИмя, КэшОбмена)
	ДанныеОчереди = КэшОбмена.Поиск[ОчередьИмя];
	
	Возврат ДанныеОчереди;
КонецФункции
		
// TODO перестаем ей пользоваться
Функция ПолучитьОчередь(ОчередьИмя, КэшОбмена)
	ДанныеОчереди = КэшОбмена.Поиск[ОчередьИмя];
	
	Если ДанныеОчереди = Неопределено Тогда
		МенеджерСервиса = МенеджерСервиса;
		Ошибка = СтрШаблон("Очередь %1 не найдена", ОчередьИмя);
		МенеджерСервиса.ДобавитьОшибку(Ошибка, КэшОбмена);	

		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДанныеОчереди.ИмяОчереди;
КонецФункции

