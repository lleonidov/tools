#Область СпособыЛогирования

// Добавляет способ логирования сообщений в консоль.
//
// Параметры:
//  ЛогИлиИмяЛога - Строка, Неопределено - Имя лога (например, "ЛогированиеОбмена") или сам объект лога.
//  Среда      - Строка - Контекст выполнения. Допустимые значения: "КлиентСервер", "Клиент", "Сервер".
//                           При передаче иных значений возникнет ошибка.
Процедура ДобавитьСпособЛогированияКонсоль(Контекст, ЛогИлиИмяЛога = Неопределено, Среда = "") Экспорт
	ДобавитьСпособЛогирования(Контекст, "Консоль", Неопределено, ЛогИлиИмяЛога, Среда);
КонецПроцедуры

Процедура ДобавитьСпособЛогированияЖурналРегистрации(Контекст, ЛогИлиИмяЛога = Неопределено, Среда = "") экспорт
	ДобавитьСпособЛогирования(Контекст, "ЖурналРегистрации", Неопределено, ЛогИлиИмяЛога, Среда);
КонецПроцедуры

