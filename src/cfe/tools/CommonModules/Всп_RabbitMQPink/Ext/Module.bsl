Функция ОтправитьСообщение(Обмен, Знач КлючОчереди, Знач Сообщение) Экспорт
	Результат 	   = Ложь;
	
	КлиентОбмена    = Обмен.КлиентОбмена;
	МенеджерСервиса = Всп_Брокер;
	
	// TD добавить из настроек
	ИмяПотребителя = ""; // Если  потребитель не заполнен ключочереди = имениочереди
	
	Если ТипЗнч(Сообщение) = Тип("Строка") Тогда
		ДанныеОтправки = Новый Массив;
		ДанныеОтправки.Добавить(Сообщение);
	Иначе
		ДанныеОтправки = Сообщение;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КлючОчереди) Тогда
		Текст  = ОписаниеОшибки() + " " + КлиентОбмена.GetLastError();
		МенеджерСервиса.ДобавитьОшибку("Имя очереди пустое:", Обмен);
	КонецЕсли;
	
	Для Каждого текСообщение Из ДанныеОтправки Цикл
		Попытка 
			КлиентОбмена.BasicPublish(ИмяПотребителя, КлючОчереди, текСообщение, 0, Ложь);
			Результат = Истина;
		Исключение
			Текст  = ОписаниеОшибки() + " " + КлиентОбмена.GetLastError();
			МенеджерСервиса.ДобавитьОшибку(СтрШаблон("Ошибка при отправке сообщения: %1", Текст), Обмен);
			Результат = Ложь;
			Прервать;
		КонецПопытки;
	КонецЦикла;
	
	
	Возврат Результат;
КонецФункции

Функция ПолучитьСообщение(Обмен, КлючОчереди, Сообщение = "", СообщениеНомер = 0) Экспорт
	Результат 	    = Ложь;
	КлиентОбмена    = Обмен.КлиентОбмена;
	МенеджерСервиса = Всп_Брокер;
	
	// TD добавить из настроек
	ИмяПотребителя = "";
	
	ИмяОчереди	   = "";
	Поток 		   = Ложь;
	
	ДанныеОчереди  = Обмен.Поиск[КлючОчереди];
	
	ИмяОчереди 	   = ДанныеОчереди.ИмяОчереди;
	ВремяОжидания  = Обмен.Таймаут;
	
	Если Обмен.ЗакрытьОчередь Тогда
		Если Не КлиентОбмена = Неопределено Тогда
			КлиентОбмена.BasicCancel("");	
			Обмен.ЗакрытьОчередь = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Обмен.СообщениеНомер = 0;
	Обмен.Сообщение      = "";
	Сообщение 			 = "";
	СообщениеНомер 		 = 0;
	СообщенияЗаРаз = ДанныеОчереди.СообщенияЗаРаз;
	
	// Замена переменных
	
	Если ИмяОчереди = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Обмен.ТекущаяОчередь)
		И Не Обмен.ТекущаяОчередь = ИмяОчереди Тогда
		
		КлиентОбмена.BasicCancel("");
	КонецЕсли;
	
	Попытка
		Если Не ДанныеОчереди.Поток Тогда
			Потребитель = КлиентОбмена.BasicConsume(ИмяОчереди, "", Ложь, Ложь, СообщенияЗаРаз);
			ДанныеОчереди.Поток  = Истина;
			Обмен.ТекущаяОчередь = ИмяОчереди;
		КонецЕсли;
		
		// Когда все сообщения из очереди получены эта команда будет ожидать появление нового сообщения	
		Результат = КлиентОбмена.BasicConsumeMessage("", Обмен.Сообщение, Обмен.СообщениеНомер, ВремяОжидания);
		
		Сообщение 	   = Обмен.Сообщение;
		СообщениеНомер = Обмен.СообщениеНомер;
		
		Если Не Результат Тогда 
			Если Обмен.ЗакрытьОчередьАвтоматически Тогда
				КлиентОбмена.BasicCancel("");
			Иначе
				Обмен.ЗакрытьОчередь = Истина;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Текст  = ОписаниеОшибки() + " " + КлиентОбмена.GetLastError();
		МенеджерСервиса.ДобавитьОшибку(СтрШаблон("Ошибка при получении сообщения: %1", Текст), Обмен);
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

Функция ПодтвердитьСообщение(Обмен, СообщениеНомер) Экспорт
	Результат = Истина;
	
	Если ТипЗнч(СообщениеНомер) = Тип("Массив") Тогда
		Для Каждого текНомер Из СообщениеНомер Цикл
			Результат = Результат И БазовоеПодтверждение(Обмен, текНомер);
		КонецЦикла;
	Иначе
		Результат = БазовоеПодтверждение(Обмен, СообщениеНомер);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Функция - Подтвердить все захваченные сообщения
//	Подтверждаем все захваченные в этой сессии сообщения по указанные номер.
// Параметры:
//  Подключение			 - 	Структура - Настройки подключения
//  ПоследнееСообщение	 - Число - Номер захваченного сообщения до которого включительно будут подтверждено.
// 
// Возвращаемое значение:
//  Булево - Успех подтверждения
//
Функция ПодтвердитьВсеЗахваченныеСообщения(Обмен, ПоследнееСообщение) Экспорт
	Результат = Истина;
	Клиент    = Обмен.КлиентОбмена;
	
	текНомер	   = 0;
	
	Если ТипЗнч(ПоследнееСообщение) = Тип("Массив") Тогда
		текКоличество = ПоследнееСообщение.Количество();
		
		Если текКоличество Тогда
			текНомер = ПоследнееСообщение[текКоличество - 1];
		КонецЕсли;
	Иначе
		текНомер = ПоследнееСообщение;
	КонецЕсли;
	
	Результат = БазовоеПодтверждение(Обмен, текНомер, Истина);
	
	Возврат Результат;
КонецФункции

Функция ОтказОтСообщения(Обмен, СообщениеНомер) Экспорт
	
	Результат = БазовыйОтказ(Обмен, СообщениеНомер);
	
	Возврат Результат;
КонецФункции

Функция Подключиться(Сервис, Обмен = Неопределено) Экспорт
	
	МенеджерСервиса = Всп_Брокер;
	
	Если Обмен = Неопределено Тогда
		МенеджерСервиса.ДобавитьОшибку("Инициализация доступна из модуля Всп_Брокер", Обмен);
		Обмен.Используется = Ложь;
		
		Возврат Неопределено;
	КонецЕсли;
	
	ДополнитьСостояниеОбмена(Обмен);
		
	Если Не Обмен.ВидАвторизации = "Basic_Auth" Тогда
		МенеджерСервиса.ДобавитьОшибку("Доступен только вид авторизации базовый", Обмен);
		Обмен.Используется = Ложь;
		Возврат Обмен;
	КонецЕсли;
	
	Обмен.КлиентОбмена = ПодключитьКомпоненту(Обмен);
	
	Возврат Обмен;
КонецФункции

Процедура Отключиться(Обмен) Экспорт
	
	Если Обмен.ЗакрытьОчередь Тогда
		Если Не Обмен.КлиентОбмена = Неопределено Тогда
			Обмен.Сообщение = "";
			Обмен.СообщениеНомер = 0;
			Обмен.КлиентОбмена.BasicCancel("");	
		КонецЕсли;
		
		Обмен.ЗакрытьОчередь = Ложь;
	КонецЕсли;
	
	Обмен.КлиентОбмена = Неопределено;
КонецПроцедуры

Функция ПодключитьКомпоненту(Обмен)
	КлиентОбмена = Неопределено;
	МенеджерСервиса = Всп_Брокер;
	
	// Инициализация макета
	Попытка
		КомпонентаПодключена = ПодключитьВнешнююКомпоненту(
		"ОбщийМакет.PinkRabbitMQ",
		"BITERP",
		ТипВнешнейКомпоненты.Native,
		ТипПодключенияВнешнейКомпоненты.Изолированно);
		
		Если КомпонентаПодключена Тогда
			КлиентОбмена = Новый("AddIn.BITERP.PinkRabbitMQ");
		Иначе
			Обмен.Используется = Ложь;
			Текст = "Не получилось инициализировать макет, подробности в журнале регистрации."; // Надеюсь они там будут
			МенеджерСервиса.ДобавитьОшибку(Текст, Обмен);
			КлиентОбмена = Неопределено;
		
			Возврат КлиентОбмена;
		КонецЕсли;
	Исключение
		Текст = ОписаниеОшибки();
		Текст = СтрШаблон("Не получилось подключить компоненту обмена: %1", Текст);
		МенеджерСервиса.ДобавитьОшибку(Текст, Обмен);
		Обмен.Используется = Ложь;
		КлиентОбмена = Неопределено;
		
		Возврат КлиентОбмена;
	КонецПопытки;
	
	Попытка
		КлиентОбмена.Connect(Обмен.АдресСервера, 	   Обмен.Порт, 			  Обмен.Аутентификация.Логин, 
							 Обмен.Аутентификация.Пароль, Обмен.ВиртуальныйХост);//, , , Обмен.Таймаут);
	Исключение
		
		Текст  = ОписаниеОшибки();
		ОшибкаКомпоненты = КлиентОбмена.GetLastError();
		// Тут инициализация обмена через другой сервер.
		// TD
		Текст = СтрШаблон("Не получилось подключить компоненту обмена: %1(%2)", Текст, ОшибкаКомпоненты);
		МенеджерСервиса.ДобавитьОшибку(Текст, Обмен);
		Обмен.Используется = Ложь;
		КлиентОбмена = Неопределено;
		
		Возврат КлиентОбмена;
	КонецПопытки;
	
	Возврат КлиентОбмена;
КонецФункции

Процедура ДополнитьСостояниеОбмена(Обмен)
	// Найдем это в параметрах, если есть вставим.
	
	Обмен.Вставить("ВиртуальныйХост", "/");
	Обмен.Вставить("ИмяПолучателя",   "");
	
КонецПроцедуры

Функция БазовоеПодтверждение(Обмен, НомерСообщения, ПодтверждатьВсе = Ложь)
	Результат = Истина;
	
	Если ПодтверждатьВсе Тогда
		МаскаПодтверждения = 16384;
	Иначе
		МаскаПодтверждения = 0;
	КонецЕсли;
	
	Если НомерСообщения = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерСервиса = Всп_Брокер;
	КлиентОбмена	= Обмен.КлиентОбмена;
	
	Попытка
		КлиентОбмена.BasicAck(НомерСообщения, МаскаПодтверждения);
	Исключение
		Текст  = ОписаниеОшибки() + " " + КлиентОбмена.GetLastError();
		Текст = СтрШаблон("Не получилось подтвердить сообщение: %1", Текст);
		МенеджерСервиса.ДобавитьОшибку(Текст, Обмен);
		Результат = Ложь;
	КонецПопытки;
		
	Возврат Результат;
КонецФункции

Функция БазовыйОтказ(Обмен, НомерСообщения)
	Результат = Истина;
	
	Если НомерСообщения = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерСервиса = Всп_Брокер;
	КлиентОбмена    = Обмен.КлиентОбмена;
	
	Попытка
		КлиентОбмена.BasicReject(НомерСообщения);
	Исключение
		Текст  = ОписаниеОшибки() + " " + КлиентОбмена.GetLastError();
		Текст = СтрШаблон("Не получилось вернуть сообщение: %1", Текст);
		МенеджерСервиса.ДобавитьОшибку(Текст, Обмен);
		Результат = Ложь;
	КонецПопытки;
		
	Возврат Результат;
КонецФункции