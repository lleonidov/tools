{
    "vrunner": {
        "ibconnection": "/F./build/noneTools",
        "db-user": "admin",
        "db-pwd": "12322",
        "root": ".",
        "workspace": ".",
        "v8version": "8.5",
        "locale": "ru",
        "language": "ru",
        "additional": "/DisplayAllFunctions /L ru",
        "ordinaryapp": "-1",
        "test": {
            "vanessa": {
                "vanessasettings": "./tools/VAParams.json",
                "bddrunner-path": "./oscript_modules/vanessa-automation-single/vanessa-automation-single.epf",
                "additional": "/DisplayAllFunctions /L ru /DisableStartupDialogs /DisableStartupMessages /AllowExecuteScheduledJobs -Off"
            },
            "xunit": {
                "xddExitCodePath": "./build/xddExitCodePath.txt",
                "additional": "/DisplayAllFunctions /L ru /DisableStartupDialogs /DisableStartupMessages /AllowExecuteScheduledJobs -Off"
            },
            "yaxunit": {
                "yaxunit-config": "tools/yaxunit.json",
                "report-format": [
                    "junit"
                ],
                "report-path": "build/out/yaxunit/junit.xml"
             
            }
        },
        "validate": {
            "syntax-check": {
                "groupbymetadata": true,
                "exception-file": "tools/syntax-check-excludes.txt",
                "report-format": [
                    "junit",
                    "allure"
                ],
                "report-path": "build/out/syntax-check",
                "mode": [
                    "ExtendedModulesCheck",
                    "ThinClient",
                    "WebClient",
                    "Server",
                    "ExternalConnection",
                    "ThickClientOrdinaryApplication"
                ]
            }
        }
    },
    "logos": {
        "logger": {
            "vrunner": "INFO"
        }
    }
}
